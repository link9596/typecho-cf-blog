---
/**
 * Default theme — Index (home page) component
 */
import Base from '@/layouts/Base.astro';
import type { ThemeIndexProps } from '@/lib/theme-props';
import { formatDate, buildAuthorLink } from '@/lib/content';

type Props = ThemeIndexProps;

const {
  options, urls, user, isLoggedIn, pages, sidebarData, currentPath, pluginCtx,
  posts, pagination,
} = Astro.props;

const isIndex = currentPath === '/';

const processPost = (post: any) => {
  let excerpt = post.excerpt || '';
  const mediaItems: { type: 'image' | 'livephoto'; html: string; src?: string; videoSrc?: string }[] = [];

  const livePhotoRegex = /<div[^>]*class="[^"]*live-photo[^"]*"[^>]*>[\s\S]*?<\/div>/g;
  let match;
  while ((match = livePhotoRegex.exec(excerpt)) !== null) {
    const html = match[0];
    const imgMatch = html.match(/<img[^>]*src="([^">]+)"/);
    const videoMatch = html.match(/<video[^>]*>[\s\S]*?<source[^>]*src="([^">]+)"/) ||
                       html.match(/<video[^>]*src="([^">]+)"/);
    if (imgMatch) {
      mediaItems.push({
        type: 'livephoto',
        html: html,
        src: imgMatch[1],
        videoSrc: videoMatch ? videoMatch[1] : undefined,
      });
    }
  }
  excerpt = excerpt.replace(livePhotoRegex, '');

  const imgRegex = /<img[^>]+src="([^">]+)"[^>]*>/g;
  while ((match = imgRegex.exec(excerpt)) !== null) {
    mediaItems.push({ type: 'image', src: match[1], html: '', videoSrc: undefined });
  }
  excerpt = excerpt.replace(/<img[^>]+>/g, '').trim();

  const avatarUrl = post.author?.avatarUrl || '/img/avatar.svg';
  return { ...post, excerpt, mediaItems, avatarUrl };
};

const processedPosts = posts.map(processPost);

function buildSquareLivePhoto(src: string, videoSrc?: string): string {
  return `<div style="position:relative; width:100%; padding-top:100%;border-radius: 0px;" class="live-photo">
    <img class="live-photo-img" src="${src}" alt="Live Photo" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover;border-radius: 0px;">
    <video class="live-photo-video" playsinline muted preload="auto" style="position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover;">
        <source src="${videoSrc || ''}" type="video/mp4">
    </video>
</div>`;
}
---

<Base options={options} urls={urls} user={user} isLoggedIn={isLoggedIn} pluginCtx={pluginCtx}>
  <header id="header" class="clearfix">
    <div class="container">
      <div class="row">
        <div class="site-name col-mb-12 col-9">
          <a id="logo" href={urls.siteUrl + '/'}>{options.title}</a>
          <p class="description">{options.description}</p>
        </div>
        <div class="site-search col-3 kit-hidden-tb">
          <form id="search" method="post" action={urls.siteUrl + '/'} role="search">
            <label for="s" class="sr-only">搜索关键字</label>
            <input type="text" id="s" name="s" class="text" placeholder="输入关键字搜索" />
            <button type="submit" class="submit">搜索</button>
          </form>
        </div>
        <div class="col-mb-12">
          <nav id="nav-menu" class="clearfix" role="navigation">
            <a class:list={[{ current: isIndex }]} href={urls.siteUrl + '/'}>首页</a>
            {pages.map((page) => (
              <a href={page.permalink} title={page.title}>{page.title}</a>
            ))}
          </nav>
        </div>
      </div>
    </div>
  </header>

  <div id="body">
    <div class="container">
      <div class="row">
        <div class="col-mb-12 col-8 transition-fade" id="main" role="main">
          {processedPosts.length === 0 ? (
            <article class="post">
              <h2 class="post-title">暂时没有文章</h2>
              <div class="post-content">
                <p>这里还没有任何文章，请通过管理后台发布第一篇文章。</p>
              </div>
            </article>
          ) : (
            processedPosts.map((post) => (
              <article class="post" itemscope itemtype="http://schema.org/BlogPosting">
                <div class="post-card" style="position: relative; padding: 16px 0;">
                  <a href={post.permalink} class="card-overlay" style="position: absolute; inset: 0; z-index: 1; display: block; cursor: pointer;"></a>

                  <div class="post-header" style="display: flex; align-items: flex-start; gap: 12px; position: relative; z-index: 2;">
                    <div class="post-avatar" style="flex-shrink: 0; width: 36px; height: 36px;">
                      <img
                        src={post.avatarUrl}
                        alt={post.author?.screenName || '用户'}
                        style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"
                      />
                    </div>
                    <div class="meta-block" style="flex: 1; min-width: 0;">
                      <div class="post-author" style="font-weight: 600; font-size: 15px; color: #3354aa; margin-bottom: 2px;">
                        <a
                          itemprop="name"
                          href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'}
                          rel="author"
                          style="color: inherit; text-decoration: none; position: relative; z-index: 3;"
                        >
                          {post.author?.screenName || post.author?.name || '未知'}
                        </a>
                      </div>
                      <div class="post-meta-details" style="font-size: 14px; color: #8a8f9a; display: flex; flex-wrap: wrap; gap: 2px 6px;">
                        <time datetime={new Date((post.created) * 1000).toISOString()} itemprop="datePublished">
                          {formatDate(post.created, 'Y.m.d H:i', options.timezone)}
                        </time>
                        {post.categories.length > 0 && (
                          <>
                            <span class="sep" style="color: #d0d4dc;">·</span>
                            {post.categories.map((c, i) => (
                              <span key={c.cid} style="position: relative; z-index: 3;">
                                {i > 0 && ', '}
                                <a href={c.permalink} style="color: #8a8f9a; text-decoration: none;">{c.name}</a>
                              </span>
                            ))}
                          </>
                        )}
                        <span class="sep" style="color: #d0d4dc;">·</span>
                        <a
                          href={`${post.permalink}#comments`}
                          itemprop="discussionUrl"
                          style="color: #8a8f9a; text-decoration: none; position: relative; z-index: 3;"
                        >
                          {post.commentsNum === 0 ? '评论' : `${post.commentsNum} 条评论`}
                        </a>
                        {post.status === 'private' && (
                          <span class="meta-tags">私密</span>
                        )}
                      </div>
                    </div>
                  </div>

                  <div
                    class="post-excerpt"
                    itemprop="articleBody"
                    set:html={post.excerpt}
                    style="margin-top: 26px; padding-left: 48px; font-size: 15px; line-height: 1.7; color: #4e5969; word-break: break-word; position: relative;"
                  />

                  {post.mediaItems.length > 0 && (
                    <div
                      class="post-images"
                      data-count={post.mediaItems.length}
                      style="margin-top: 12px; margin-left: 48px; display: grid; gap: 4px; border-radius: 8px; overflow: hidden; max-width: 50%; position: relative; z-index: 2;"
                    >
                      {post.mediaItems.map((item) => {
                        if (item.type === 'image') {
                          return (
                            <img
                              src={item.src}
                              alt="配图"
                              loading="lazy"
                              class="lightbox-img"
                              style="width: 100%; height: 100%; object-fit: cover; display: block; cursor: pointer;"
                            />
                          );
                        } else {
                          if (post.mediaItems.length === 1) {
                            return <div set:html={item.html} style="width: 100%;" />;
                          } else {
                            const squareHtml = buildSquareLivePhoto(item.src!, item.videoSrc);
                            return <div set:html={squareHtml} style="width: 100%; height: 100%;" />;
                          }
                        }
                      })}
                    </div>
                  )}
                </div>
              </article>
            ))
          )}

          {pagination.totalPages > 1 && (
            <nav class="page-navigator">
              {pagination.hasPrev && <a class="prev" href={pagination.prevUrl!}>&laquo; 前一页</a>}
              {pagination.hasNext && <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>}
            </nav>
          )}
        </div>

        <div class="col-mb-12 col-offset-1 col-3 kit-hidden-tb" id="secondary" role="complementary">
          {sidebarData && (
            <>
              {sidebarData.recentPosts && sidebarData.recentPosts.length > 0 && (
                <section class="widget">
                  <h3 class="widget-title">最新文章</h3>
                  <ul class="widget-list">
                    {sidebarData.recentPosts.map((p) => (
                      <li><a href={p.permalink}>{p.title}</a></li>
                    ))}
                  </ul>
                </section>
              )}
              {sidebarData.recentComments && sidebarData.recentComments.length > 0 && (
                <section class="widget">
                  <h3 class="widget-title">最近回复</h3>
                  <ul class="widget-list">
                    {sidebarData.recentComments.map((c) => (
                      <li><a href={c.permalink}>{c.author}</a>: {c.excerpt}</li>
                    ))}
                  </ul>
                </section>
              )}
              {sidebarData.categories && sidebarData.categories.length > 0 && (
                <section class="widget">
                  <h3 class="widget-title">分类</h3>
                  <ul class="widget-list">
                    {sidebarData.categories.map((cat) => (
                      <li><a href={cat.permalink}>{cat.name} ({cat.count})</a></li>
                    ))}
                  </ul>
                </section>
              )}
              {sidebarData.archives && sidebarData.archives.length > 0 && (
                <section class="widget">
                  <h3 class="widget-title">归档</h3>
                  <ul class="widget-list">
                    {sidebarData.archives.map((archive) => (
                      <li><a href={archive.permalink}>{archive.date}</a></li>
                    ))}
                  </ul>
                </section>
              )}
              <section class="widget">
                <h3 class="widget-title">其它</h3>
                <ul class="widget-list">
                  {isLoggedIn ? (
                    <>
                      <li class="last">
                        <a href={urls.adminUrl}>进入后台 ({user?.screenName || user?.name})</a>
                      </li>
                      <li><form method="post" action={urls.logoutUrl} class="logout-form"><button type="submit">退出</button></form></li>
                    </>
                  ) : (
                    <li class="last"><a href={urls.loginUrl}>登录</a></li>
                  )}
                  <li><a href={urls.feedUrl}>文章 RSS</a></li>
                  <li><a href={urls.commentsFeedUrl}>评论 RSS</a></li>
                </ul>
              </section>
            </>
          )}
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== 全局吸附播放器 ==================== -->
  <header class="global-bar" id="globalBar" hidden>
    <div class="global-host" id="globalHost"></div>
  </header>

  <div class="gesture-hint" id="gestureHint">下滑关闭</div>

  <!-- 播放器库：只加载一次 -->
  <script is:inline src="/js/mood-player.min.js"></script>

  <!-- 搬迁逻辑 -->
  <script is:inline>
    (function () {
      'use strict';

      var HOST_ID = 'globalHost';
      var BAR_ID  = 'globalBar';
      var HINT_ID = 'gestureHint';
      var DEBUG   = false;

      var movedMap = new Map();   // mood-player → 占位块
      var gesture = null;
      var hintEl = null;

      function $(id) { return document.getElementById(id); }

      function log(msg, type) {
        if (!DEBUG) return;
        if (type === 'warn') console.warn('[mood-global]', msg);
        else console.log('[mood-global]', msg);
      }

      /* ============ 动画 ============ */

      function fadeInElement(el, duration) {
        return new Promise(function (resolve) {
          var anim = el.animate(
            [
              { opacity: 0, filter: 'blur(14px)' },
              { opacity: 1, filter: 'blur(0px)' }
            ],
            { duration: duration, easing: 'cubic-bezier(.32,.72,0,1)', fill: 'forwards' }
          );
          anim.onfinish = function () {
            try { anim.cancel(); } catch (_) {}
            resolve();
          };
          anim.oncancel = function () { resolve(); };
        });
      }

      function slideInHost(el, duration) {
        return new Promise(function (resolve) {
          var anim = el.animate(
            [
              { transform: 'translateY(140%)', opacity: 0, filter: 'blur(14px)' },
              { opacity: 1, offset: 0.6 },
              { transform: 'translateY(0)', opacity: 1, filter: 'blur(0px)' }
            ],
            { duration: duration, easing: 'cubic-bezier(.32,.72,0,1)', fill: 'forwards' }
          );
          anim.onfinish = function () {
            try { anim.cancel(); } catch (_) {}
            resolve();
          };
          anim.oncancel = function () { resolve(); };
        });
      }

      function slideOutHost(el, duration, fromOffset) {
        var startY = fromOffset || 0;
        var targetY = window.innerHeight + 80;
        if (targetY <= startY + 40) targetY = startY + 300;

        return new Promise(function (resolve) {
          var anim = el.animate(
            [
              { transform: 'translateY(' + startY + 'px)' },
              { transform: 'translateY(' + targetY + 'px)' }
            ],
            { duration: duration, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' }
          );
          anim.onfinish = function () { resolve(); };
          anim.oncancel = function () { resolve(); };
        });
      }

      function resetHostVisual(host) {
        host.getAnimations().forEach(function (a) {
          try { a.cancel(); } catch (_) {}
        });
        host.style.opacity = '';
        host.style.filter = '';
        host.style.transform = '';
      }

      /* ============ 幽灵 / 占位 ============ */

      function makeGhost(el) {
        var rect = el.getBoundingClientRect();
        var ghost = document.createElement('div');
        ghost.style.cssText =
          'position:fixed;' +
          'left:' + rect.left + 'px;' +
          'top:' + rect.top + 'px;' +
          'width:' + rect.width + 'px;' +
          'height:' + rect.height + 'px;' +
          'pointer-events:none;' +
          'z-index:2000;' +
          'overflow:hidden;';

        try {
          if (el.shadowRoot) {
            var shadow = ghost.attachShadow({ mode: 'open' });
            shadow.innerHTML = el.shadowRoot.innerHTML;
          }
        } catch (_) {}

        document.body.appendChild(ghost);
        ghost.animate(
          [
            { opacity: 1, filter: 'blur(0px)', transform: 'scale(1)' },
            { opacity: 0, filter: 'blur(14px)', transform: 'scale(.96)' }
          ],
          { duration: 340, easing: 'cubic-bezier(.4,0,1,1)', fill: 'forwards' }
        ).onfinish = function () { ghost.remove(); };
      }

      function createPlaceholder(width, height) {
        var ph = document.createElement('div');
        ph.className = 'player-placeholder';
        ph.style.width = width + 'px';
        ph.style.maxWidth = '100%';
        ph.style.height = Math.max(48, height) + 'px';
        ph.innerHTML = '<span class="ph-text">🎵 正在悬浮播放</span>';
        return ph;
      }

      /* ============ 搬迁 ============ */

      function findPlayer(e) {
        var path = e.composedPath ? e.composedPath() : [];
        for (var i = 0; i < path.length; i++) {
          var n = path[i];
          if (n && n.nodeType === 1 && n.tagName &&
              n.tagName.toLowerCase() === 'mood-player') {
            return n;
          }
        }
        return null;
      }

      function moveToGlobal(el) {
        if (!el || el.closest('#' + HOST_ID)) return;

        var host = $(HOST_ID);
        var bar  = $(BAR_ID);
        if (!host || !bar) return;

        var existing = host.querySelector('mood-player');
        if (existing && existing !== el) {
          returnExisting(existing, { animate: false });
        }

        var beforePaused = el._player ? el._player.audio.paused : null;
        var beforeTime   = el._player ? el._player.audio.currentTime : null;

        /* ★ 顺序关键：测量 → 置 null → DOM 操作 → 恢复 */
        var rect = el.getBoundingClientRect();
        var saved = el._player;
        el._player = null;

        makeGhost(el);
        var ph = createPlaceholder(rect.width, rect.height);
        el.parentNode.replaceChild(ph, el);
        movedMap.set(el, ph);

        resetHostVisual(host);
        host.appendChild(el);
        el._player = saved;

        /* 底部吸附：抽屉向上展开 */
        try {
          var clip = el.shadowRoot && el.shadowRoot.querySelector('.mcp-drawer-clip');
          if (clip) clip.setAttribute('data-pos', 'top');
        } catch (_) {}

        bar.hidden = false;
        slideInHost(host, 800);

        attachDrawerListener(el, bar);

        if (DEBUG && beforePaused != null && el._player) {
          var afterPaused = el._player.audio.paused;
          var afterTime   = el._player.audio.currentTime;
          log('搬迁 ' + (el.id || 'player') +
              ' · ' + (beforePaused ? '暂停' : '播放') + ' → ' + (afterPaused ? '暂停' : '播放') +
              ' · ' + beforeTime.toFixed(2) + 's → ' + afterTime.toFixed(2) + 's',
              beforePaused === afterPaused ? 'ok' : 'warn');
        }
      }

      function attachDrawerListener(el, bar) {
        if (el._drawerListenerAttached) return;
        el._drawerListenerAttached = true;
        el.addEventListener('mood:playlisttoggle', function (e) {
          if (e.detail && e.detail.open) bar.classList.add('drawer-open');
          else bar.classList.remove('drawer-open');
        });
      }

      /* ============ 归还 ============ */

      function returnExisting(el, opts) {
        opts = opts || {};
        var animate = opts.animate !== false;
        var fromOffset = opts.fromOffset || 0;
        var host = $(HOST_ID);
        var bar  = $(BAR_ID);
        if (!el || !host) return;

        /* 归还 = 停止播放 */
        if (el._player && !el._player.audio.paused) {
          try { el._player.pause(true); } catch (_) {}
        }

        var ph = movedMap.get(el);
        if (!ph) {
          try { el.destroy(); } catch (_) {}
          el.remove();
          if (!host.querySelector('mood-player')) {
            bar.hidden = true;
            resetHostVisual(host);
          }
          return;
        }

        function doMoveBack() {
          if (!movedMap.has(el)) return;
          var p = movedMap.get(el);

          var saved = el._player;
          el._player = null;
          if (p && p.parentNode) p.parentNode.replaceChild(el, p);
          el._player = saved;

          movedMap.delete(el);

          try {
            var clip = el.shadowRoot && el.shadowRoot.querySelector('.mcp-drawer-clip');
            if (clip) clip.setAttribute('data-pos', 'bottom');
          } catch (_) {}

          if (!host.querySelector('mood-player')) {
            bar.hidden = true;
            bar.classList.remove('drawer-open');
            resetHostVisual(host);
          }
        }

        if (!animate) {
          doMoveBack();
          log('归还 ' + (el.id || 'player') + '（无动画）');
          return;
        }

        slideOutHost(host, 460, fromOffset).then(function () {
          doMoveBack();
          return fadeInElement(el, 860);
        }).then(function () {
          log('归还 ' + (el.id || 'player') + ' 完成');
        });
      }

      /* ============ 下滑手势 ============ */

      function showHint(startRect) {
        if (!hintEl) hintEl = $(HINT_ID);
        if (!hintEl) return;
        hintEl.style.left = (startRect.left + startRect.width / 2) + 'px';
        hintEl.style.top  = (startRect.top - 32) + 'px';
        hintEl.classList.add('visible');
      }

      function hideHint() {
        if (!hintEl) hintEl = $(HINT_ID);
        if (hintEl) hintEl.classList.remove('visible');
      }

      document.addEventListener('pointerdown', function (e) {
        if (e.button !== undefined && e.button !== 0) return;

        var host = $(HOST_ID);
        var bar  = $(BAR_ID);
        if (!host || !bar || bar.hidden) return;
        if (!host.contains(e.target)) return;

        var path = e.composedPath ? e.composedPath() : [];
        for (var i = 0; i < path.length; i++) {
          var n = path[i];
          if (!n || n.nodeType !== 1) continue;
          if (n.matches && n.matches(
            '.mcp-btn, .mcp-side-btn, .mcp-cover-play, .mcp-pl-item, .mcp-drawer-inner, .mcp-progress'
          )) return;
        }

        var playerEl = host.querySelector('mood-player');
        if (!playerEl) return;

        host.getAnimations().forEach(function (a) {
          try { a.cancel(); } catch (_) {}
        });
        host.style.transform = '';
        host.style.opacity = '';

        gesture = {
          startX: e.clientX,
          startY: e.clientY,
          pointerId: e.pointerId,
          startTime: performance.now(),
          hostRect: host.getBoundingClientRect(),
          locked: false,
          active: false,
          player: playerEl
        };

        try { host.setPointerCapture(e.pointerId); } catch (_) {}
      }, { passive: true });

      document.addEventListener('pointermove', function (e) {
        if (!gesture || e.pointerId !== gesture.pointerId) return;
        var host = $(HOST_ID);
        if (!host) return;

        var dx = e.clientX - gesture.startX;
        var dy = e.clientY - gesture.startY;

        if (!gesture.locked) {
          if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 8) {
            gesture = null;
            hideHint();
            return;
          }
          if (dy > 6) {
            gesture.locked = true;
            gesture.active = true;
            showHint(gesture.hostRect);
          } else if (dy < -6) {
            gesture = null;
            return;
          }
        }

        if (gesture.active) {
          if (e.cancelable) e.preventDefault();
          var offset = Math.max(0, dy);
          host.style.transform = 'translateY(' + offset + 'px)';
          var maxDist = Math.max(80, gesture.hostRect.height * 1.5);
          host.style.opacity = String(Math.max(0.45, 1 - offset / maxDist));
        }
      }, { passive: false });

      document.addEventListener('pointerup', function (e) {
        if (!gesture || e.pointerId !== gesture.pointerId) return;
        var g = gesture;
        gesture = null;
        hideHint();

        var host = $(HOST_ID);
        if (!host) return;

        if (!g.active) {
          host.style.transform = '';
          host.style.opacity = '';
          return;
        }

        var dy = e.clientY - g.startY;
        var dt = Math.max(1, performance.now() - g.startTime);
        var velocity = dy / dt;
        var threshold = g.hostRect.height * 0.4;

        var m = (host.style.transform || '').match(/translateY\(([\d.-]+)px\)/);
        var fromOffset = m ? parseFloat(m[1]) : 0;
        host.style.transform = '';
        host.style.opacity = '';

        var shouldReturn = dy > threshold || (velocity > 0.6 && dy > 30);

        if (shouldReturn && g.player) {
          returnExisting(g.player, { animate: true, fromOffset: fromOffset });
        } else {
          host.animate(
            [
              { transform: 'translateY(' + fromOffset + 'px)' },
              { transform: 'translateY(0)' }
            ],
            { duration: 420, easing: 'cubic-bezier(.32,.72,0,1)', fill: 'forwards' }
          ).onfinish = function () {
            host.style.transform = '';
            host.style.opacity = '';
            var anims = host.getAnimations();
            var last = anims[anims.length - 1];
            if (last) { try { last.cancel(); } catch (_) {} }
          };
        }
      }, { passive: true });

      document.addEventListener('pointercancel', function () {
        if (!gesture) return;
        gesture = null;
        hideHint();
        var host = $(HOST_ID);
        if (!host) return;
        host.style.transform = '';
        host.style.opacity = '';
      });

      /* ============ 播放触发搬迁 ============ */

      document.addEventListener('mood:play', function (e) {
        var el = findPlayer(e);
        if (!el) return;
        if (el.closest('#' + HOST_ID)) return;
        moveToGlobal(el);
      });

      log('搬迁逻辑就绪');
    })();
  </script>

  <footer id="footer" role="contentinfo">
    &copy; {new Date().getFullYear()} <a href={urls.siteUrl}>{options.title}</a>.
    一起来堆雪人！
  </footer>
</Base>


---
/**
 * Snowi theme — Index (home page) component
 * 极简日记流 · 卡片布局 + 侧边栏
 *
 * 保留能力：
 *  - 作者头像（Gravatar / avatarUrl）
 *  - 图片重排（单图 / 多图网格）
 *  - LivePhoto（原始容器 + 正方形容器重建）
 *  - 灯箱（.lightbox-img）
 *  - mood-player 播放器 + GlobalPlayer 迁移
 *  - 分页、搜索、作者页、评论锚点
 *  - sidebarData（最新文章 / 最近回复 / 分类 / 归档 / 其它）
 */
import Base from '@/layouts/Base.astro';
import type { ThemeIndexProps } from '@/lib/theme-props';
import { buildAuthorLink } from '@/lib/content';
import GlobalPlayer from './GlobalPlayer.astro';

type Props = ThemeIndexProps;

const {
  options, urls, user, isLoggedIn, pages, sidebarData, currentPath, pluginCtx,
  posts, pagination,
} = Astro.props;

const isIndex = currentPath === '/';

const normalizePath = (p: string) => (p || '').replace(/\/+$/, '') || '/';
const isPageActive = (slug: string) =>
  normalizePath(currentPath) === normalizePath(`/${slug}`);

/* 侧边栏数据兜底 */
const recentPosts = sidebarData?.recentPosts ?? [];
const recentComments = sidebarData?.recentComments ?? [];
const categories = sidebarData?.categories ?? [];
const archives = sidebarData?.archives ?? [];
const hasSidebar =
  recentPosts.length > 0 ||
  recentComments.length > 0 ||
  categories.length > 0 ||
  archives.length > 0;

/* ------------------------------------------------------------------ */
/* 日期拆解：日 / 星期 / 年-月 / 时:分                                  */
/* ------------------------------------------------------------------ */
type DateParts = { day: string; weekday: string; yearMonth: string; time: string };

function getDateParts(ts: number, tz?: string): DateParts {
  try {
    const fmt = new Intl.DateTimeFormat('zh-CN', {
      timeZone: tz || undefined,
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      weekday: 'short',
    });
    const parts = fmt.formatToParts(new Date(ts * 1000));
    const pick = (t: string) => parts.find((p) => p.type === t)?.value || '';
    let hour = pick('hour');
    if (hour === '24') hour = '00';
    const weekday = pick('weekday').replace('星期', '周').replace('周天', '周日');
    return {
      day: pick('day'),
      weekday,
      yearMonth: `${pick('year')}/${pick('month')}`,
      time: `${hour}:${pick('minute')}`,
    };
  } catch {
    const d = new Date(ts * 1000);
    const p2 = (n: number) => String(n).padStart(2, '0');
    return {
      day: p2(d.getDate()),
      weekday: '',
      yearMonth: `${d.getFullYear()}/${p2(d.getMonth() + 1)}`,
      time: `${p2(d.getHours())}:${p2(d.getMinutes())}`,
    };
  }
}

/* ------------------------------------------------------------------ */
/* 文章预处理：抽取图片 / LivePhoto，剥离为纯文本摘要                    */
/* ------------------------------------------------------------------ */
type MediaItem = {
  type: 'image' | 'livephoto';
  html: string;
  src?: string;
  videoSrc?: string;
};

function processPost(post: any) {
  let excerpt = post.excerpt || '';
  const mediaItems: MediaItem[] = [];

  // 1. LivePhoto 容器
  const livePhotoRegex = /<div[^>]*class="[^"]*live-photo[^"]*"[^>]*>[\s\S]*?<\/div>/g;
  let match: RegExpExecArray | null;
  while ((match = livePhotoRegex.exec(excerpt)) !== null) {
    const html = match[0];
    const imgMatch = html.match(/<img[^>]*src="([^">]+)"/);
    const videoMatch =
      html.match(/<video[^>]*>[\s\S]*?<source[^>]*src="([^">]+)"/) ||
      html.match(/<video[^>]*src="([^">]+)"/);
    if (imgMatch) {
      mediaItems.push({
        type: 'livephoto',
        html,
        src: imgMatch[1],
        videoSrc: videoMatch ? videoMatch[1] : undefined,
      });
    }
  }
  excerpt = excerpt.replace(livePhotoRegex, '');

  // 2. 普通图片
  const imgRegex = /<img[^>]+src="([^">]+)"[^>]*>/g;
  while ((match = imgRegex.exec(excerpt)) !== null) {
    mediaItems.push({ type: 'image', src: match[1], html: '' });
  }
  excerpt = excerpt.replace(/<img[^>]+>/g, '').trim();

  // 3. 头像
  const avatarUrl = (post.author as any)?.avatarUrl || '/img/avatar.svg';

  return {
    ...post,
    excerpt,
    mediaItems,
    avatarUrl,
    date: getDateParts(post.created, options.timezone),
    authorName: post.author?.screenName || post.author?.name || '未知',
  };
}

const processedPosts = posts.map(processPost);

/* 多图场景下重建正方形容器（保留 video 播放能力） */
function buildGridLivePhoto(src: string, videoSrc?: string): string {
  return `<div class="live-photo" style="position:relative;width:100%;height:100%;overflow:hidden;">
    <img class="live-photo-img" src="${src}" alt="Live Photo" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block;">
    <video class="live-photo-video" playsinline muted preload="auto" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;">
      <source src="${videoSrc || ''}" type="video/mp4">
    </video>
  </div>`;
}
---

<!-- 提前应用暗色主题，避免首屏闪烁 -->
<script is:inline>
  try {
    if (localStorage.getItem('snowi-theme') === 'dark') {
      document.documentElement.classList.add('snowi-dark');
    }
  } catch (e) {}
</script>

<Base options={options} urls={urls} user={user} isLoggedIn={isLoggedIn} pluginCtx={pluginCtx}>
  <div class="snowi-page">

    <!-- ================= 页首 ================= -->
    <header class="site-header">
      <div class="header-brand">
        <h1 class="site-title">{options.title}</h1>
        {options.description && <p class="site-subtitle">{options.description}</p>}
      </div>

      <nav class="header-nav">
        <a
          href={urls.siteUrl + '/'}
          class:list={['nav-item', { active: isIndex }]}
        >首页</a>
        {pages.map((page) => (
          <a
            href={page.permalink}
            title={page.title}
            class:list={['nav-item', { active: isPageActive(page.slug) }]}
          >{page.title}</a>
        ))}
        <button type="button" class="nav-item nav-search-toggle" id="snowiSearchToggle">搜索</button>
      </nav>

      <form class="header-search" id="snowiSearch" method="post" action={urls.siteUrl + '/'} role="search">
        <label for="s" class="sr-only">搜索关键字</label>
        <input type="text" id="s" name="s" class="text" placeholder="输入关键字搜索" autocomplete="off" />
        <button type="submit" class="search-submit">搜索</button>
      </form>
    </header>

    <!-- ================= 主体：卡片流 + 侧边栏 ================= -->
    <div class="page-layout">

      <main class="cards-container" role="main">
        {processedPosts.length === 0 ? (
          <div class="card-wrapper">
            <article class="post-card">
              <div class="post-text">
                <p>这里还没有任何文章，请通过管理后台发布第一篇文章。</p>
              </div>
            </article>
          </div>
        ) : (
          processedPosts.map((post) => (
            <div class="card-wrapper">
              <article class="post-card" itemscope itemtype="http://schema.org/BlogPosting">
                <!-- 整卡点击层 -->
                <a href={post.permalink} class="card-overlay" aria-label={post.title}></a>

                <!-- 头部：日期 + 作者 -->
                <header class="post-header">
                  <div class="header-left">
                    <div class="date-top">
                      <span class="day-num" itemprop="datePublished" datetime={new Date(post.created * 1000).toISOString()}>
                        {post.date.day}
                      </span>
                      {post.date.weekday && <span class="weekday">{post.date.weekday}</span>}
                    </div>
                    <div class="date-bottom">
                      <span class="year-month">{post.date.yearMonth}</span>
                      <span class="time">{post.date.time}</span>
                    </div>
                  </div>

                  <div class="header-right">
                    <a
                      class="author-name"
                      href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'}
                      rel="author"
                      itemprop="name"
                    >@{post.authorName}</a>
                    <img
                      src={post.avatarUrl}
                      alt={post.authorName}
                      class="author-avatar"
                      loading="lazy"
                    />
                  </div>
                </header>

                <!-- 正文 -->
                {post.excerpt && (
                  <div class="post-text" itemprop="articleBody" set:html={post.excerpt} />
                )}

                <!-- 媒体：单图 -->
                {post.mediaItems.length === 1 && post.mediaItems[0].type === 'image' && (
                  <div class="post-images post-media" data-count="1">
                    <img
                      src={post.mediaItems[0].src}
                      alt="配图"
                      loading="lazy"
                      class="lightbox-img"
                    />
                  </div>
                )}

                {post.mediaItems.length === 1 && post.mediaItems[0].type === 'livephoto' && (
                  <div
                    class="post-images post-media"
                    data-count="1"
                    set:html={post.mediaItems[0].html}
                  />
                )}

                <!-- 媒体：多图网格 -->
                {post.mediaItems.length > 1 && (
                  <div
                    class="post-images post-media-grid"
                    data-count={post.mediaItems.length}
                  >
                    {post.mediaItems.map((item) =>
                      item.type === 'image' ? (
                        <img
                          src={item.src}
                          alt="配图"
                          loading="lazy"
                          class="lightbox-img"
                        />
                      ) : (
                        <div
                          class="media-cell"
                          set:html={buildGridLivePhoto(item.src!, item.videoSrc)}
                        />
                      )
                    )}
                  </div>
                )}

                <!-- 分类 -->
                {post.categories.length > 0 && (
                  <div class="post-category">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                      <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                    <span>
                      {post.categories.map((c, i) => (
                        <>
                          {i > 0 && ' / '}
                          <a href={c.permalink}>{c.name}</a>
                        </>
                      ))}
                    </span>
                    {post.status === 'private' && <span class="private-tag">私密</span>}
                  </div>
                )}

                <!-- 底部操作 -->
                <footer class="post-actions">
                  <a
                    class="action-btn"
                    href={`${post.permalink}#comments`}
                    aria-label="评论"
                    itemprop="discussionUrl"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    {post.commentsNum > 0 && <span class="action-count">{post.commentsNum}</span>}
                  </a>
                  <button class="action-btn share-btn" type="button" aria-label="分享下载">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                      <polyline points="16 6 12 2 8 6"></polyline>
                      <line x1="12" y1="2" x2="12" y2="15"></line>
                    </svg>
                  </button>
                </footer>
              </article>
            </div>
          ))
        )}
      </main>

      <!-- ================= 分页 ================= -->
      {pagination.totalPages > 1 && (
        <nav class="page-navigator">
          {pagination.hasPrev && <a class="prev" href={pagination.prevUrl!}>&laquo; 前一页</a>}
          {pagination.hasNext && <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>}
        </nav>
      )}

      <!-- ================= 侧边栏 ================= -->
      <aside class="sidebar-section" role="complementary">
        {recentPosts.length > 0 && (
          <section class="widget">
            <h3 class="widget-title">最新文章</h3>
            <ul class="widget-list">
              {recentPosts.map((p: any) => (
                <li><a href={p.permalink}>{p.title}</a></li>
              ))}
            </ul>
          </section>
        )}

        {recentComments.length > 0 && (
          <section class="widget">
            <h3 class="widget-title">最近回复</h3>
            <ul class="widget-list widget-comments">
              {recentComments.map((c: any) => (
                <li>
                  <a href={c.permalink} class="widget-comment-link">
                    <span class="widget-comment-author">{c.author}</span>
                    <span class="widget-comment-excerpt">{c.excerpt}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {categories.length > 0 && (
          <section class="widget">
            <h3 class="widget-title">分类</h3>
            <ul class="widget-list widget-tags">
              {categories.map((cat: any) => (
                <li>
                  <a href={cat.permalink} class="widget-tag">
                    {cat.name}<span class="widget-tag-count">{cat.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {archives.length > 0 && (
          <section class="widget">
            <h3 class="widget-title">归档</h3>
            <ul class="widget-list">
              {archives.map((archive: any) => (
                <li><a href={archive.permalink}>{archive.date}</a></li>
              ))}
            </ul>
          </section>
        )}

        {hasSidebar && (
          <section class="widget">
            <h3 class="widget-title">其它</h3>
            <ul class="widget-list">
              {isLoggedIn ? (
                <>
                  <li>
                    <a href={urls.adminUrl}>
                      进入后台{user?.screenName || user?.name ? `（${user?.screenName || user?.name}）` : ''}
                    </a>
                  </li>
                  <li>
                    <form method="post" action={urls.logoutUrl} class="logout-form">
                      <button type="submit">退出登录</button>
                    </form>
                  </li>
                </>
              ) : (
                <li><a href={urls.loginUrl}>登录</a></li>
              )}
              <li><a href={urls.feedUrl}>文章 RSS</a></li>
              <li><a href={urls.commentsFeedUrl}>评论 RSS</a></li>
            </ul>
          </section>
        )}
      </aside>
    </div>

    <!-- ================= 页脚 ================= -->
    <footer class="page-footer">
      <button class="theme-toggle" id="snowiThemeToggle" type="button">
        <span id="snowiThemeIcon">🌙</span>
        <span id="snowiThemeText">切换至暗色模式</span>
      </button>

      <p class="site-copyright">
        &copy; {new Date().getFullYear()} <a href={urls.siteUrl}>{options.title}</a> · 一起来堆雪人！
      </p>
    </footer>

  </div>

  <!-- 播放器脚本（先加载，确保 customElements 就绪） -->
  <script is:inline src="/js/mood-player.min.js"></script>

  <!-- 全局吸附播放器：搬迁逻辑 + 吸附条，位于内容之外，切页不被 Swup 替换 -->
  <GlobalPlayer />
</Base>

<!-- ==================================================================== -->
<!-- 交互脚本                                                             -->
<!-- ==================================================================== -->
<script is:inline define:vars={{ siteTitle: options.title }}>
  (function () {
    var page = document.querySelector('.snowi-page');
    if (!page) return;

    /* ---------------- 主题切换 ---------------- */
    var root = document.documentElement;
    var toggle = document.getElementById('snowiThemeToggle');
    var iconEl = document.getElementById('snowiThemeIcon');
    var textEl = document.getElementById('snowiThemeText');

    function applyTheme(isDark) {
      if (isDark) root.classList.add('snowi-dark');
      else root.classList.remove('snowi-dark');
      if (iconEl) iconEl.textContent = isDark ? '☀️' : '🌙';
      if (textEl) textEl.textContent = isDark ? '切换至亮色模式' : '切换至暗色模式';
    }

    var stored = null;
    try { stored = localStorage.getItem('snowi-theme'); } catch (e) {}
    applyTheme(stored === 'dark');

    if (toggle) {
      toggle.addEventListener('click', function () {
        var isDark = !root.classList.contains('snowi-dark');
        applyTheme(isDark);
        try { localStorage.setItem('snowi-theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
    }

    /* ---------------- 搜索展开 ---------------- */
    var searchToggle = document.getElementById('snowiSearchToggle');
    var searchForm = document.getElementById('snowiSearch');
    if (searchToggle && searchForm) {
      searchToggle.addEventListener('click', function () {
        var open = searchForm.classList.toggle('open');
        searchToggle.classList.toggle('active', open);
        if (open) {
          var input = searchForm.querySelector('input');
          if (input) input.focus();
        }
      });
    }

    /* ---------------- 分享截图 ---------------- */
    var CAPTURE_PADDING = '16px 12px 20px';
    var H2C_URL = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';

    function ensureHtml2Canvas() {
      if (window.html2canvas) return Promise.resolve(window.html2canvas);
      if (window.__snowiH2C) return window.__snowiH2C;
      window.__snowiH2C = new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = H2C_URL;
        s.onload = function () { resolve(window.html2canvas); };
        s.onerror = reject;
        document.head.appendChild(s);
      });
      return window.__snowiH2C;
    }

    function waitImageReady(img) {
      if (img.complete && img.naturalWidth > 0) return Promise.resolve();
      return new Promise(function (resolve) {
        var done = function () { resolve(); };
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
        setTimeout(done, 6000);
      });
    }

    function createCoverDataURL(img, targetW, targetH, pixelRatio) {
      var cw = Math.max(1, Math.round(targetW * pixelRatio));
      var ch = Math.max(1, Math.round(targetH * pixelRatio));
      var canvas = document.createElement('canvas');
      canvas.width = cw;
      canvas.height = ch;
      var ctx = canvas.getContext('2d');
      if (!ctx) return null;

      var iw = img.naturalWidth;
      var ih = img.naturalHeight;
      if (!iw || !ih) return null;

      var targetRatio = cw / ch;
      var srcRatio = iw / ih;
      var sx = 0, sy = 0, sw = iw, sh = ih;
      if (srcRatio > targetRatio) {
        sw = ih * targetRatio;
        sx = (iw - sw) / 2;
      } else {
        sh = iw / targetRatio;
        sy = (ih - sh) / 2;
      }

      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, cw, ch);

      try { return canvas.toDataURL('image/png'); }
      catch (e) { console.warn('图片无法导出', e); return null; }
    }

    async function snapshotCardImages(wrapper, pixelRatio) {
      var imgs = Array.prototype.slice.call(wrapper.querySelectorAll('img'));
      if (imgs.length === 0) return [];
      await Promise.all(imgs.map(waitImageReady));

      var origPadding = wrapper.style.padding;
      wrapper.style.padding = CAPTURE_PADDING;
      void wrapper.offsetWidth;

      var snapshots = imgs.map(function (img) {
        var rect = img.getBoundingClientRect();
        var w = Math.max(1, Math.round(rect.width));
        var h = Math.max(1, Math.round(rect.height));
        return { w: w, h: h, dataURL: createCoverDataURL(img, w, h, pixelRatio) };
      });

      wrapper.style.padding = origPadding;
      return snapshots;
    }

    var loadingIconHTML =
      '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width:16px;height:16px;">' +
      '<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3c4.97 0 9 4.03 9 9">' +
      '<animateTransform attributeName="transform" dur="1.5s" repeatCount="indefinite" type="rotate" values="0 12 12;360 12 12"/>' +
      '</path></svg>';

    var shareBtns = document.querySelectorAll('.share-btn');
    shareBtns.forEach(function (btn) {
      btn.addEventListener('click', async function () {
        if (this.disabled) return;

        var wrapper = this.closest('.card-wrapper');
        if (!wrapper) return;

        var originalHTML = this.innerHTML;
        var computedColor = window.getComputedStyle(this).color;

        this.innerHTML = loadingIconHTML;
        this.disabled = true;

        try {
          var h2c = await ensureHtml2Canvas();
          var highResScale = (window.devicePixelRatio || 1) * 1.2;
          var bgSource = document.querySelector('.snowi-page') || document.body;
          var currentBg = getComputedStyle(bgSource).getPropertyValue('--bg-color').trim() || '#f2f3f5';

          var snapshots = await snapshotCardImages(wrapper, highResScale);

          var canvas = await h2c(wrapper, {
            useCORS: true,
            allowTaint: false,
            backgroundColor: currentBg,
            scale: highResScale,
            dpi: 300,
            logging: false,
            onclone: function (clonedDoc, element) {
              element.style.padding = CAPTURE_PADDING;

              var watermark = clonedDoc.createElement('div');
              watermark.className = 'snowi-watermark';
              watermark.textContent = '❄️ ' + siteTitle + '.';
              element.appendChild(watermark);

              var clonedBtn = element.querySelector('.share-btn');
              if (clonedBtn) {
                clonedBtn.innerHTML =
                  '<svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:none;stroke:' +
                  computedColor +
                  ';stroke-width:2;stroke-linecap:round;stroke-linejoin:round;">' +
                  '<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>' +
                  '<polyline points="16 6 12 2 8 6"></polyline>' +
                  '<line x1="12" y1="2" x2="12" y2="15"></line></svg>';
              }

              var clonedImgs = element.querySelectorAll('img');
              clonedImgs.forEach(function (img, index) {
                var snap = snapshots[index];
                if (!snap) return;
                if (snap.dataURL) img.setAttribute('src', snap.dataURL);
                img.style.width = snap.w + 'px';
                img.style.height = snap.h + 'px';
                img.style.maxWidth = 'none';
                img.style.maxHeight = 'none';
                img.style.objectFit = 'fill';
              });
            },
          });

          var link = document.createElement('a');
          link.download = 'Snowi-Diary-' + Date.now() + '.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
        } catch (err) {
          console.error('截图失败:', err);
          alert('截图生成失败，请检查图片跨域问题。');
        } finally {
          this.innerHTML = originalHTML;
          this.disabled = false;
        }
      });
    });
  })();
</script>

<!-- ==================================================================== -->
<!-- 样式                                                                 -->
<!-- ==================================================================== -->
<style is:global>
  /* ---------- 变量 ---------- */
  .snowi-page {
    --bg-color: #f2f3f5;
    --card-bg: #ffffff;
    --text-main: #444444;
    --text-sub: #888888;
    --icon-color: #888888;
    --btn-hover: rgba(0, 0, 0, 0.05);

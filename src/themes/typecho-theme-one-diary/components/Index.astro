---
/**
 * Snowi theme — Index (home page)
 */
import Base from '@/layouts/Base.astro';
import type { ThemeIndexProps } from '@/lib/theme-props';
import { buildAuthorLink } from '@/lib/content';
import GlobalPlayer from './GlobalPlayer.astro';

type Props = ThemeIndexProps;

const {
  options, urls, user, isLoggedIn, pages, currentPath, pluginCtx,
  posts, pagination, sidebarData,
} = Astro.props;

const isIndex = currentPath === '/';

const normalizePath = (p: string) => (p || '').replace(/\/+$/, '') || '/';
const isPageActive = (slug: string) =>
  normalizePath(currentPath) === normalizePath(`/${slug}`);

const recentPosts = sidebarData?.recentPosts ?? [];
const recentComments = sidebarData?.recentComments ?? [];
const sidebarCategories = sidebarData?.categories ?? [];
const archives = sidebarData?.archives ?? [];
const hasSidebar = recentPosts.length > 0 || recentComments.length > 0 || sidebarCategories.length > 0 || archives.length > 0;

/* 日期拆解 */
type DateParts = { day: string; weekday: string; yearMonth: string; time: string };
function getDateParts(ts: number, tz?: string): DateParts {
  const date = new Date(ts * 1000);
  const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  
  try {
    const fmt = new Intl.DateTimeFormat('zh-CN', {
      timeZone: tz || undefined, year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hour12: false
    });
    const parts = fmt.formatToParts(date);
    const pick = (t: string) => parts.find((p) => p.type === t)?.value || '';
    let hour = pick('hour');
    if (hour === '24') hour = '00';
    
    const weekdayFmt = new Intl.DateTimeFormat('zh-CN', { timeZone: tz || undefined, weekday: 'short' });
    let weekday = weekdayFmt.format(date).replace('星期', '周').replace('周天', '周日').replace('星期日', '周日');
    
    return { day: pick('day'), weekday, yearMonth: `${pick('year')}/${pick('month')}`, time: `${hour}:${pick('minute')}` };
  } catch {
    const p2 = (n: number) => String(n).padStart(2, '0');
    return { 
      day: p2(date.getDate()), 
      weekday: days[date.getDay()], 
      yearMonth: `${date.getFullYear()}/${p2(date.getMonth() + 1)}`, 
      time: `${p2(date.getHours())}:${p2(date.getMinutes())}` 
    };
  }
}

/* 文章预处理 */
type MediaItem = { type: 'image' | 'livephoto'; html: string; src?: string; videoSrc?: string };
function processPost(post: any) {
  let excerpt = post.excerpt || '';
  const mediaItems: MediaItem[] = [];

  const livePhotoRegex = /<div[^>]*class="[^"]*live-photo[^"]*"[^>]*>[\s\S]*?<\/div>/g;
  let match: RegExpExecArray | null;
  while ((match = livePhotoRegex.exec(excerpt)) !== null) {
    const html = match[0];
    const imgMatch = html.match(/<img[^>]*src="([^">]+)"/);
    const videoMatch = html.match(/<video[^>]*>[\s\S]*?<source[^>]*src="([^">]+)"/) || html.match(/<video[^>]*src="([^">]+)"/);
    if (imgMatch) {
      mediaItems.push({ type: 'livephoto', html, src: imgMatch[1], videoSrc: videoMatch ? videoMatch[1] : undefined });
    }
  }
  excerpt = excerpt.replace(livePhotoRegex, '');

  const imgRegex = /<img[^>]+src="([^">]+)"[^>]*>/g;
  while ((match = imgRegex.exec(excerpt)) !== null) {
    mediaItems.push({ type: 'image', src: match[1], html: '' });
  }
  excerpt = excerpt.replace(/<img[^>]+>/g, '').trim();

  const avatarUrl = (post.author as any)?.avatarUrl || '/img/avatar.svg';

  return {
    ...post, excerpt, mediaItems, avatarUrl,
    date: getDateParts(post.created, options.timezone),
    authorName: post.author?.screenName || post.author?.name || '未知',
  };
}

const processedPosts = posts.map(processPost);

function buildGridLivePhoto(src: string, videoSrc?: string): string {
  return `<div class="live-photo">
    <img class="live-photo-img" src="${src}" alt="Live Photo">
    <video class="live-photo-video" playsinline muted preload="auto">
      <source src="${videoSrc || ''}" type="video/mp4">
    </video>
  </div>`;
}
---

<script is:inline>
  try {
    if (localStorage.getItem('theme') === 'dark') {
      document.documentElement.classList.add('snowi-dark');
    }
  } catch (e) {}
</script>

<Base options={options} urls={urls} user={user} isLoggedIn={isLoggedIn} pluginCtx={pluginCtx}>
  <div class="snowi-page">

    <header class="site-header">
      <div class="header-brand">
        <h1 class="site-title">{options.title}</h1>
        {options.description && <p class="site-subtitle">{options.description}</p>}
      </div>
      <nav class="header-nav">
        <a href={urls.siteUrl + '/'} class:list={['nav-item', { active: isIndex }]}>首页</a>
        {pages.map((page) => (
          <a href={page.permalink} class:list={['nav-item', { active: isPageActive(page.slug) }]}>{page.title}</a>
        ))}
        <a href="#" class="nav-item" id="snowiSearchToggle">搜索</a>
      </nav>

      <form class="header-search" id="snowiSearch" method="post" action={urls.siteUrl + '/'} role="search">
        <input type="text" name="s" placeholder="输入关键字搜索" autocomplete="off" />
        <button type="submit">搜索</button>
      </form>
    </header>

    <div class="cards-container">
      {processedPosts.length === 0 ? (
        <div class="card-wrapper">
          <article class="post-card">
            <div class="post-text"><p>这里还没有任何文章，请通过管理后台发布。</p></div>
          </article>
        </div>
      ) : (
        processedPosts.map((post) => (
          <div class="card-wrapper">
            <article class="post-card" itemscope itemtype="http://schema.org/BlogPosting">
              <a href={post.permalink} class="card-overlay" aria-label={post.title}></a>

              <header class="post-header">
                <div class="header-left">
                  <div class="date-top">
                    <span class="day-num" itemprop="datePublished" datetime={new Date(post.created * 1000).toISOString()}>{post.date.day}</span>
                    {post.date.weekday && <span class="weekday">{post.date.weekday}</span>}
                  </div>
                  <div class="date-bottom">
                    <span class="year-month">{post.date.yearMonth}</span>
                    <span class="time">{post.date.time}</span>
                  </div>
                </div>
                <div class="header-right">
                  <a class="author-name" href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'} rel="author" itemprop="name">
                    @{post.authorName}
                  </a>
                  <img src={post.avatarUrl} alt={post.authorName} class="author-avatar" loading="lazy" />
                </div>
              </header>

              {post.excerpt && (
                <div class="post-text" itemprop="articleBody" set:html={post.excerpt} />
              )}

              {post.mediaItems.length === 1 && post.mediaItems[0].type === 'image' && (
                <div class="post-images post-media" data-count="1">
                  <img src={post.mediaItems[0].src} alt="配图" loading="lazy" class="lightbox-img" />
                </div>
              )}
              {post.mediaItems.length === 1 && post.mediaItems[0].type === 'livephoto' && (
                <div class="post-images post-media" data-count="1" set:html={post.mediaItems[0].html} />
              )}

              {post.mediaItems.length > 1 && (
                <div class="post-images post-media-grid" data-count={post.mediaItems.length}>
                  {post.mediaItems.map((item) =>
                    item.type === 'image' ? (
                      <img src={item.src} alt="配图" loading="lazy" class="lightbox-img" />
                    ) : (
                      <div class="media-cell" set:html={buildGridLivePhoto(item.src!, item.videoSrc)} />
                    )
                  )}
                </div>
              )}

              {post.categories.length > 0 && (
                <div class="post-category">
                  <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                  <span>
                    {post.categories.map((c, i) => (
                      <>{i > 0 && ' / '}<a href={c.permalink}>{c.name}</a></>
                    ))}
                  </span>
                </div>
              )}

              <footer class="post-actions">
                <a class="action-btn" href={`${post.permalink}#comments`} aria-label="评论">
                  <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                </a>
                <button class="action-btn share-btn" type="button" aria-label="分享下载">
                  <svg viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
                </button>
              </footer>
            </article>
          </div>
        ))
      )}
    </div>

    {pagination.totalPages > 1 && (
      <nav class="page-navigator">
        {pagination.hasPrev && <a class="prev" href={pagination.prevUrl!}>&laquo; 前一页</a>}
        {pagination.hasNext && <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>}
      </nav>
    )}

    {hasSidebar && (
      <aside class="sidebar-section">
        {recentPosts.length > 0 && (
          <div class="widget">
            <h3 class="widget-title">最新文章</h3>
            <ul class="widget-list">
              {recentPosts.map((p: any) => <li><a href={p.permalink}>{p.title}</a></li>)}
            </ul>
          </div>
        )}
        {recentComments.length > 0 && (
          <div class="widget">
            <h3 class="widget-title">最近回复</h3>
            <ul class="widget-list">
              {recentComments.map((c: any) => (
                <li>
                  <a href={c.permalink}>
                    <span class="comment-user">{c.author}:</span>
                    <span class="comment-excerpt">{c.excerpt}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {sidebarCategories.length > 0 && (
          <div class="widget">
            <h3 class="widget-title">分类</h3>
            <ul class="widget-list">
              {sidebarCategories.map((cat: any) => (
                <li><a href={cat.permalink}>{cat.name} <span class="widget-count">{cat.count}</span></a></li>
              ))}
            </ul>
          </div>
        )}
        {archives.length > 0 && (
          <div class="widget">
            <h3 class="widget-title">归档</h3>
            <ul class="widget-list">
              {archives.map((a: any) => <li><a href={a.permalink}>{a.date}</a></li>)}
            </ul>
          </div>
        )}
        <div class="widget">
          <h3 class="widget-title">其它</h3>
          <ul class="widget-list">
            {isLoggedIn ? (
              <>
                <li><a href={urls.adminUrl}>后台 ({user?.screenName || user?.name})</a></li>
                <li><form method="post" action={urls.logoutUrl}><button type="submit" class="logout-btn">退出登录</button></form></li>
              </>
            ) : (
              <li><a href={urls.loginUrl}>登录</a></li>
            )}
            <li><a href={urls.feedUrl}>文章 RSS</a></li>
          </ul>
        </div>
      </aside>
    )}

    <footer class="page-footer">
      <button class="theme-toggle" id="themeToggle">
        <span id="themeIcon">🌙</span>
        <span id="themeText">切换至暗色模式</span>
      </button>
    </footer>
  </div>

  <script is:inline src="/js/screenshot.js"></script>
  <script is:inline src="/js/mood-player.min.js"></script>
  <GlobalPlayer />
</Base>

<script is:inline define:vars={{ siteTitle: options.title }}>
  (function () {
    var root = document.documentElement;
    var body = document.body;

    var pageEl = document.querySelector('.snowi-page');
    if (pageEl) {
       if (root.classList.contains('snowi-dark')) {
          body.classList.add('dark-mode');
       }
    }

    var themeToggle = document.getElementById('themeToggle');
    var themeIcon = document.getElementById('themeIcon');
    var themeText = document.getElementById('themeText');

    function updateThemeUI(isDark) {
      if (isDark) {
        body.classList.add('dark-mode');
        root.classList.add('snowi-dark');
        themeIcon.innerText = '☀️';
        themeText.innerText = '切换至亮色模式';
      } else {
        body.classList.remove('dark-mode');
        root.classList.remove('snowi-dark');
        themeIcon.innerText = '🌙';
        themeText.innerText = '切换至暗色模式';
      }
    }

    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        var isDark = !body.classList.contains('dark-mode');
        updateThemeUI(isDark);
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
    }

    var searchToggle = document.getElementById('snowiSearchToggle');
    var searchForm = document.getElementById('snowiSearch');
    if (searchToggle && searchForm) {
      searchToggle.addEventListener('click', function(e) {
        e.preventDefault();
        var open = searchForm.classList.toggle('open');
        if (open) searchForm.querySelector('input').focus();
      });
    }

    var shareBtns = document.querySelectorAll('.share-btn');
    var loadingIconHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="share-loading-icon spin"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3c4.97 0 9 4.03 9 9"></path></svg>`;
    var CAPTURE_PADDING = '16px 12px 20px';

    function waitImageReady(img) {
      if (img.complete && img.naturalWidth > 0) return Promise.resolve();
      return new Promise(resolve => {
        const done = () => resolve();
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
        setTimeout(done, 6000);
      });
    }

    function createCoverDataURL(img, targetW, targetH, pixelRatio) {
      const cw = Math.max(1, Math.round(targetW * pixelRatio));
      const ch = Math.max(1, Math.round(targetH * pixelRatio));
      const canvas = document.createElement('canvas');
      canvas.width = cw;
      canvas.height = ch;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;
      const iw = img.naturalWidth, ih = img.naturalHeight;
      if (!iw || !ih) return null;
      const targetRatio = cw / ch, srcRatio = iw / ih;
      let sx = 0, sy = 0, sw = iw, sh = ih;
      if (srcRatio > targetRatio) { sw = ih * targetRatio; sx = (iw - sw) / 2; } 
      else { sh = iw / targetRatio; sy = (ih - sh) / 2; }
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, cw, ch);
      try { return canvas.toDataURL('image/png'); } catch (e) { return null; }
    }

    async function snapshotCardImages(wrapper, pixelRatio) {
      const imgs = Array.from(wrapper.querySelectorAll('img'));
      if (imgs.length === 0) return [];
      await Promise.all(imgs.map(waitImageReady));
      const origPadding = wrapper.style.padding;
      wrapper.style.padding = CAPTURE_PADDING;
      void wrapper.offsetWidth;
      const snapshots = imgs.map(img => {
        const rect = img.getBoundingClientRect();
        const w = Math.max(1, Math.round(rect.width));
        const h = Math.max(1, Math.round(rect.height));
        return { w, h, dataURL: createCoverDataURL(img, w, h, pixelRatio) };
      });
      wrapper.style.padding = origPadding;
      return snapshots;
    }

    shareBtns.forEach(btn => {
      btn.addEventListener('click', async function () {
        if (this.disabled) return;
        if (typeof html2canvas !== 'function') {
          alert('截图组件未加载（/js/screenshot.js）');
          return;
        }
        const currentWrapper = this.closest('.card-wrapper');
        const originalHTML = this.innerHTML;
        const computedColor = window.getComputedStyle(this).color;

        this.innerHTML = loadingIconHTML;
        this.disabled = true;

        try {
          const highResScale = (window.devicePixelRatio || 1) * 1.2;
          const currentBg = getComputedStyle(pageEl).getPropertyValue('--bg-color').trim() || '#f2f3f5';
          const snapshots = await snapshotCardImages(currentWrapper, highResScale);

          const canvas = await html2canvas(currentWrapper, {
            useCORS: true,
            allowTaint: false,
            backgroundColor: currentBg,
            scale: highResScale,
            dpi: 300,
            logging: false,
            ignoreElements: (el) => el.tagName === 'MOOD-PLAYER' || el.tagName === 'VIDEO',
            onclone: (clonedDoc, element) => {
              element.style.padding = CAPTURE_PADDING;

              element.style.setProperty('--bg-color', currentBg);
              element.style.setProperty('--card-bg', getComputedStyle(pageEl).getPropertyValue('--card-bg').trim());
              element.style.setProperty('--text-main', getComputedStyle(pageEl).getPropertyValue('--text-main').trim());
              element.style.setProperty('--text-sub', getComputedStyle(pageEl).getPropertyValue('--text-sub').trim());
              element.style.setProperty('--footer-bg', getComputedStyle(pageEl).getPropertyValue('--footer-bg').trim());
              element.style.setProperty('--watermark-color', getComputedStyle(pageEl).getPropertyValue('--watermark-color').trim());

              const allSvgs = element.querySelectorAll('svg');
              allSvgs.forEach(svg => svg.style.display = 'none');

              const watermark = clonedDoc.createElement('div');
              watermark.className = 'snowi-watermark';
              watermark.innerText = '❄️ ' + siteTitle + '.';
              element.appendChild(watermark);

              const clonedBtn = element.querySelector('.share-btn');
              if (clonedBtn) {
                clonedBtn.innerHTML = `<svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:none;stroke:${computedColor};stroke-width:2;stroke-linecap:round;stroke-linejoin:round;"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>`;
                clonedBtn.style.display = 'flex';
              }

              const clonedImgs = element.querySelectorAll('img');
              clonedImgs.forEach((img, index) => {
                const snap = snapshots[index];
                if (!snap) return;
                if (snap.dataURL) img.setAttribute('src', snap.dataURL);
                img.style.width = snap.w + 'px';
                img.style.height = snap.h + 'px';
                img.style.maxWidth = 'none';
                img.style.maxHeight = 'none';
                img.style.objectFit = 'fill';
              });
            }
          });

          const link = document.createElement('a');
          link.download = 'Snowi-' + Date.now() + '.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
        } catch (err) {
          console.error('截图失败:', err);
          alert('截图生成失败，可能是组件兼容性问题。');
        } finally {
          this.innerHTML = originalHTML;
          this.disabled = false;
        }
      });
    });
  })();
</script>

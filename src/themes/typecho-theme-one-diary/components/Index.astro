---
/**
 * Snowi theme — Index (home page) component
 * 极简日记流 · 卡片布局 + 响应式侧边栏
 */
import Base from '@/layouts/Base.astro';
import type { ThemeIndexProps } from '@/lib/theme-props';
import { buildAuthorLink } from '@/lib/content';
import GlobalPlayer from './GlobalPlayer.astro';

type Props = ThemeIndexProps;

const {
  options, urls, user, isLoggedIn, pages, currentPath, pluginCtx,
  posts, pagination, sidebarData,
} = Astro.props;

const isIndex = currentPath === '/';

const normalizePath = (p: string) => (p || '').replace(/\/+$/, '') || '/';
const isPageActive = (slug: string) =>
  normalizePath(currentPath) === normalizePath(`/${slug}`);

/* 侧边栏数据 */
const recentPosts = sidebarData?.recentPosts ?? [];
const recentComments = sidebarData?.recentComments ?? [];
const sidebarCategories = sidebarData?.categories ?? [];
const archives = sidebarData?.archives ?? [];
const hasSidebar = recentPosts.length > 0 || recentComments.length > 0 || sidebarCategories.length > 0 || archives.length > 0;

/* 日期拆解 */
type DateParts = { day: string; weekday: string; yearMonth: string; time: string };
function getDateParts(ts: number, tz?: string): DateParts {
  try {
    const fmt = new Intl.DateTimeFormat('zh-CN', {
      timeZone: tz || undefined, year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hour12: false, weekday: 'short',
    });
    const parts = fmt.formatToParts(new Date(ts * 1000));
    const pick = (t: string) => parts.find((p) => p.type === t)?.value || '';
    let hour = pick('hour');
    if (hour === '24') hour = '00';
    const weekday = pick('weekday').replace('星期', '周').replace('周天', '周日');
    return { day: pick('day'), weekday, yearMonth: `${pick('year')}/${pick('month')}`, time: `${hour}:${pick('minute')}` };
  } catch {
    const d = new Date(ts * 1000);
    const p2 = (n: number) => String(n).padStart(2, '0');
    return { day: p2(d.getDate()), weekday: '', yearMonth: `${d.getFullYear()}/${p2(d.getMonth() + 1)}`, time: `${p2(d.getHours())}:${p2(d.getMinutes())}` };
  }
}

/* 文章预处理 */
type MediaItem = { type: 'image' | 'livephoto'; html: string; src?: string; videoSrc?: string };
function processPost(post: any) {
  let excerpt = post.excerpt || '';
  const mediaItems: MediaItem[] = [];

  const livePhotoRegex = /<div[^>]*class="[^"]*live-photo[^"]*"[^>]*>[\s\S]*?<\/div>/g;
  let match: RegExpExecArray | null;
  while ((match = livePhotoRegex.exec(excerpt)) !== null) {
    const html = match[0];
    const imgMatch = html.match(/<img[^>]*src="([^">]+)"/);
    const videoMatch = html.match(/<video[^>]*>[\s\S]*?<source[^>]*src="([^">]+)"/) || html.match(/<video[^>]*src="([^">]+)"/);
    if (imgMatch) {
      mediaItems.push({ type: 'livephoto', html, src: imgMatch[1], videoSrc: videoMatch ? videoMatch[1] : undefined });
    }
  }
  excerpt = excerpt.replace(livePhotoRegex, '');

  const imgRegex = /<img[^>]+src="([^">]+)"[^>]*>/g;
  while ((match = imgRegex.exec(excerpt)) !== null) {
    mediaItems.push({ type: 'image', src: match[1], html: '' });
  }
  excerpt = excerpt.replace(/<img[^>]+>/g, '').trim();

  const avatarUrl = (post.author as any)?.avatarUrl || '/img/avatar.svg';

  return {
    ...post, excerpt, mediaItems, avatarUrl,
    date: getDateParts(post.created, options.timezone),
    authorName: post.author?.screenName || post.author?.name || '未知',
  };
}

const processedPosts = posts.map(processPost);

function buildGridLivePhoto(src: string, videoSrc?: string): string {
  return `<div class="live-photo" style="position:relative;width:100%;height:100%;overflow:hidden;">
    <img class="live-photo-img" src="${src}" alt="Live Photo" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;display:block;">
    <video class="live-photo-video" playsinline muted preload="auto" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;">
      <source src="${videoSrc || ''}" type="video/mp4">
    </video>
  </div>`;
}
---

<!-- 提前应用暗色主题，防闪烁 -->
<script is:inline>
  try {
    if (localStorage.getItem('snowi-theme') === 'dark') {
      document.documentElement.classList.add('snowi-dark');
    }
  } catch (e) {}
</script>

<Base options={options} urls={urls} user={user} isLoggedIn={isLoggedIn} pluginCtx={pluginCtx}>
  <div class="snowi-page">
    <div class="layout-wrapper">
      
      <!-- ================= 顶部 Header ================= -->
      <header class="site-header">
        <div class="header-top-row">
          <div class="site-branding">
            <div class="site-title">{options.title}</div>
            {options.description && <div class="site-desc">{options.description}</div>}
          </div>
          
          <form class="search-box" method="post" action={urls.siteUrl + '/'} role="search">
            <input type="text" name="s" placeholder="输入关键字搜索" autocomplete="off" />
            <button type="submit" aria-label="搜索">
              <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
          </form>
        </div>

        <nav class="site-nav">
          <a href={urls.siteUrl + '/'} class:list={[{ active: isIndex }]}>首页</a>
          {pages.map((page) => (
            <a href={page.permalink} class:list={[{ active: isPageActive(page.slug) }]}>{page.title}</a>
          ))}
        </nav>
      </header>

      <!-- ================= 主体内容区 ================= -->
      <div class="content-wrapper">
        
        <!-- === 左侧：文章流 === -->
        <main class="main-content">
          {processedPosts.length === 0 ? (
            <article class="post-card">
              <div class="post-text"><p>这里还没有任何文章。</p></div>
            </article>
          ) : (
            processedPosts.map((post) => (
              <article class="post-card" itemscope itemtype="http://schema.org/BlogPosting">
                <!-- 整卡点击层 -->
                <a href={post.permalink} class="card-overlay" aria-label={post.title}></a>

                <header class="post-header">
                  <div class="header-left">
                    <div class="date-top">
                      <span class="day-num" itemprop="datePublished" datetime={new Date(post.created * 1000).toISOString()}>
                        {post.date.day}
                      </span>
                      {post.date.weekday && <span class="weekday">{post.date.weekday}</span>}
                    </div>
                    <div class="date-bottom">
                      <span class="year-month">{post.date.yearMonth}</span>
                      <span class="time">{post.date.time}</span>
                    </div>
                  </div>

                  <div class="header-right">
                    <a class="author-name" href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'} rel="author" itemprop="name">
                      @{post.authorName}
                    </a>
                    <img src={post.avatarUrl} alt={post.authorName} class="author-avatar" loading="lazy" />
                  </div>
                </header>

                <!-- 文字摘要 -->
                {post.excerpt && (
                  <div class="post-text" itemprop="articleBody" set:html={post.excerpt} />
                )}

                <!-- 媒体区 -->
                {post.mediaItems.length === 1 && post.mediaItems[0].type === 'image' && (
                  <div class="post-images post-media" data-count="1">
                    <img src={post.mediaItems[0].src} alt="配图" loading="lazy" class="lightbox-img" />
                  </div>
                )}
                {post.mediaItems.length === 1 && post.mediaItems[0].type === 'livephoto' && (
                  <div class="post-images post-media" data-count="1" set:html={post.mediaItems[0].html} />
                )}
                {post.mediaItems.length > 1 && (
                  <div class="post-images post-media-grid" data-count={post.mediaItems.length}>
                    {post.mediaItems.map((item) =>
                      item.type === 'image' ? (
                        <img src={item.src} alt="配图" loading="lazy" class="lightbox-img" />
                      ) : (
                        <div class="media-cell" set:html={buildGridLivePhoto(item.src!, item.videoSrc)} />
                      )
                    )}
                  </div>
                )}

                <!-- 分类 -->
                {post.categories.length > 0 && (
                  <div class="post-category">
                    <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                    <span>
                      {post.categories.map((c, i) => (
                        <>{i > 0 && ' / '}<a href={c.permalink}>{c.name}</a></>
                      ))}
                    </span>
                  </div>
                )}

                <!-- 底部操作区 -->
                <footer class="post-actions">
                  <a class="action-btn" href={`${post.permalink}#comments`} aria-label="评论">
                    <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    {post.commentsNum > 0 && <span class="action-count">{post.commentsNum}</span>}
                  </a>
                  <button class="action-btn share-btn" type="button" aria-label="分享下载">
                    <svg viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
                  </button>
                </footer>
              </article>
            ))
          )}

          {pagination.totalPages > 1 && (
            <nav class="page-navigator">
              {pagination.hasPrev && <a class="prev" href={pagination.prevUrl!}>&laquo; 前一页</a>}
              {pagination.hasNext && <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>}
            </nav>
          )}
        </main>

        <!-- === 右侧：侧边栏 (手机端自动堆叠在下方) === -->
        {hasSidebar && (
          <aside class="sidebar">
            {recentPosts.length > 0 && (
              <div class="widget">
                <h3 class="widget-title">最新文章</h3>
                <ul class="widget-list">
                  {recentPosts.map((p: any) => <li><a href={p.permalink}>{p.title}</a></li>)}
                </ul>
              </div>
            )}

            {recentComments.length > 0 && (
              <div class="widget widget-recent-comments">
                <h3 class="widget-title">最近回复</h3>
                <ul class="widget-list">
                  {recentComments.map((c: any) => (
                    <li>
                      <a href={c.permalink}>
                        <span class="comment-user">{c.author}:</span>
                        <span class="comment-excerpt">{c.excerpt}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {sidebarCategories.length > 0 && (
              <div class="widget">
                <h3 class="widget-title">分类</h3>
                <ul class="widget-list">
                  {sidebarCategories.map((cat: any) => (
                    <li><a href={cat.permalink}>{cat.name}<span class="widget-count">{cat.count}</span></a></li>
                  ))}
                </ul>
              </div>
            )}

            {archives.length > 0 && (
              <div class="widget">
                <h3 class="widget-title">归档</h3>
                <ul class="widget-list">
                  {archives.map((a: any) => <li><a href={a.permalink}>{a.date}</a></li>)}
                </ul>
              </div>
            )}

            <div class="widget">
              <h3 class="widget-title">其它</h3>
              <ul class="widget-list">
                {isLoggedIn ? (
                  <>
                    <li><a href={urls.adminUrl}>后台 ({user?.screenName || user?.name})</a></li>
                    <li><form method="post" action={urls.logoutUrl}><button type="submit" class="logout-btn">退出登录</button></form></li>
                  </>
                ) : (
                  <li><a href={urls.loginUrl}>登录</a></li>
                )}
                <li><a href={urls.feedUrl}>文章 RSS</a></li>
                <li><a href={urls.commentsFeedUrl}>评论 RSS</a></li>
              </ul>
            </div>
          </aside>
        )}
      </div>

      <!-- ================= 页脚 ================= -->
      <footer class="page-footer">
        <button class="theme-toggle" id="snowiThemeToggle" type="button">
          <span id="snowiThemeIcon">🌙</span>
          <span id="snowiThemeText">切换至暗色模式</span>
        </button>
        <p class="site-copyright">&copy; {new Date().getFullYear()} {options.title} · 一起来堆雪人！</p>
      </footer>

    </div>
  </div>

  <script is:inline src="/js/mood-player.min.js"></script>
  <GlobalPlayer />
</Base>

<!-- ==================================================================== -->
<!-- 脚本部分 -->
<!-- ==================================================================== -->
<script is:inline define:vars={{ siteTitle: options.title }}>
  (function () {
    var page = document.querySelector('.snowi-page');
    if (!page) return;

    /* ---------------- 亮暗主题切换 ---------------- */
    var root = document.documentElement;
    var toggle = document.getElementById('snowiThemeToggle');
    var iconEl = document.getElementById('snowiThemeIcon');
    var textEl = document.getElementById('snowiThemeText');

    function applyTheme(isDark) {
      if (isDark) root.classList.add('snowi-dark');
      else root.classList.remove('snowi-dark');
      if (iconEl) iconEl.textContent = isDark ? '☀️' : '🌙';
      if (textEl) textEl.textContent = isDark ? '切换至亮色模式' : '切换至暗色模式';
    }

    var stored = null;
    try { stored = localStorage.getItem('snowi-theme'); } catch (e) {}
    applyTheme(stored === 'dark');

    if (toggle) {
      toggle.addEventListener('click', function () {
        var isDark = !root.classList.contains('snowi-dark');
        applyTheme(isDark);
        try { localStorage.setItem('snowi-theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
    }

    /* ---------------- 分享截图 ---------------- */
    var H2C_URL = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';

    function ensureHtml2Canvas() {
      if (window.html2canvas) return Promise.resolve(window.html2canvas);
      if (window.__snowiH2C) return window.__snowiH2C;
      window.__snowiH2C = new Promise(function (resolve, reject) {
        var s = document.createElement('script');
        s.src = H2C_URL;
        s.onload = function () { resolve(window.html2canvas); };
        s.onerror = reject;
        document.head.appendChild(s);
      });
      return window.__snowiH2C;
    }

    function waitImageReady(img) {
      if (img.complete && img.naturalWidth > 0) return Promise.resolve();
      return new Promise(function (resolve) {
        var done = function () { resolve(); };
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
        setTimeout(done, 6000);
      });
    }

    function createCoverDataURL(img, targetW, targetH, pixelRatio) {
      var cw = Math.max(1, Math.round(targetW * pixelRatio));
      var ch = Math.max(1, Math.round(targetH * pixelRatio));
      var canvas = document.createElement('canvas');
      canvas.width = cw;
      canvas.height = ch;
      var ctx = canvas.getContext('2d');
      if (!ctx) return null;
      var iw = img.naturalWidth, ih = img.naturalHeight;
      if (!iw || !ih) return null;
      var targetRatio = cw / ch, srcRatio = iw / ih;
      var sx = 0, sy = 0, sw = iw, sh = ih;
      if (srcRatio > targetRatio) { sw = ih * targetRatio; sx = (iw - sw) / 2; }
      else { sh = iw / targetRatio; sy = (ih - sh) / 2; }
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, cw, ch);
      try { return canvas.toDataURL('image/png'); } catch (e) { return null; }
    }

    async function snapshotCardImages(wrapper, pixelRatio) {
      var imgs = Array.prototype.slice.call(wrapper.querySelectorAll('img'));
      if (imgs.length === 0) return [];
      await Promise.all(imgs.map(waitImageReady));
      var snapshots = imgs.map(function (img) {
        var rect = img.getBoundingClientRect();
        var w = Math.max(1, Math.round(rect.width));
        var h = Math.max(1, Math.round(rect.height));
        return { w: w, h: h, dataURL: createCoverDataURL(img, w, h, pixelRatio) };
      });
      return snapshots;
    }

    var loadingIconHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" style="width:16px;height:16px;animation:spin 1s linear infinite;"><style>@keyframes spin{100%{transform:rotate(360deg)}}</style><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3c4.97 0 9 4.03 9 9"></path></svg>`;

    var shareBtns = document.querySelectorAll('.share-btn');
    shareBtns.forEach(function (btn) {
      btn.addEventListener('click', async function () {
        if (this.disabled) return;
        var wrapper = this.closest('.post-card');
        if (!wrapper) return;

        var originalHTML = this.innerHTML;
        var computedColor = window.getComputedStyle(this).color;

        this.innerHTML = loadingIconHTML;
        this.disabled = true;

        try {
          var h2c = await ensureHtml2Canvas();
          var highResScale = (window.devicePixelRatio || 1) * 1.2;
          var style = window.getComputedStyle(page);
          
          // 提取当前主题颜色，避免 html2canvas 读取 CSS 变量失败
          var bgColor = style.getPropertyValue('--bg-color').trim() || '#f2f3f5';
          var cardBg = style.getPropertyValue('--card-bg').trim() || '#ffffff';
          var textMain = style.getPropertyValue('--text-main').trim() || '#444444';
          var textSub = style.getPropertyValue('--text-sub').trim() || '#888888';
          var footerBg = style.getPropertyValue('--footer-bg').trim() || '#fafafa';
          var watermarkColor = style.getPropertyValue('--watermark-color').trim() || '#999999';

          var snapshots = await snapshotCardImages(wrapper, highResScale);

          var canvas = await h2c(wrapper, {
            useCORS: true,
            allowTaint: false,
            backgroundColor: bgColor,
            scale: highResScale,
            logging: false,
            // 过滤无法渲染的元素
            ignoreElements: function(el) {
              return el.tagName === 'MOOD-PLAYER' || el.tagName === 'VIDEO';
            },
            onclone: function (clonedDoc, element) {
              // 强制注入 CSS 变量，防止在克隆环境下失效
              element.style.setProperty('--bg-color', bgColor);
              element.style.setProperty('--card-bg', cardBg);
              element.style.setProperty('--text-main', textMain);
              element.style.setProperty('--text-sub', textSub);
              element.style.setProperty('--footer-bg', footerBg);
              element.style.setProperty('--watermark-color', watermarkColor);

              // 清理所有 svg 防止渲染崩坏
              var allSvgs = element.querySelectorAll('svg');
              allSvgs.forEach(svg => { svg.style.display = 'none'; });

              // 替换按钮图标
              var clonedBtn = element.querySelector('.share-btn');
              if (clonedBtn) clonedBtn.innerHTML = '';

              // 添加水印
              var watermark = clonedDoc.createElement('div');
              watermark.className = 'snowi-watermark';
              watermark.textContent = '❄️ ' + siteTitle + '.';
              element.appendChild(watermark);

              // 处理图片拉伸问题
              var clonedImgs = element.querySelectorAll('img');
              clonedImgs.forEach(function (img, index) {
                var snap = snapshots[index];
                if (!snap) return;
                if (snap.dataURL) img.setAttribute('src', snap.dataURL);
                img.style.width = snap.w + 'px';
                img.style.height = snap.h + 'px';
                img.style.maxWidth = 'none';
                img.style.maxHeight = 'none';
                img.style.objectFit = 'fill';
              });
            },
          });

          var link = document.createElement('a');
          link.download = 'Snowi-' + Date.now() + '.png';
          link.href = canvas.toDataURL('image/png');
          link.click();
        } catch (err) {
          console.error('截图失败:', err);
          alert('截图生成失败，可能是浏览器兼容性问题。');
        } finally {
          this.innerHTML = originalHTML;
          this.disabled = false;
        }
      });
    });
  })();
</script>

<!-- ==================================================================== -->
<!-- 样式部分 -->
<!-- ==================================================================== -->
<style is:global>
  /* ---------- 全局重置与变量 ---------- */
  html, body {
    margin: 0; padding: 0; width: 100%;
    background-color: var(--bg-color, #f2f3f5);
    overflow-x: hidden; /* 消除两侧白边 */
  }

  .snowi-page {
    --bg-color: #f2f3f5;
    --card-bg: #ffffff;
    --text-main: #444444;
    --text-sub: #888888;
    --icon-color: #888888;
    --btn-hover: rgba(0, 0, 0, 0.05);
    --media-bg: #eeeeee;
    --footer-bg: #fafafa;
    --border-color: #eaeaea;
    --accent-color: #333333;
    --watermark-color: #999999;

    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    min-height: 100vh;
    line-height: 1.5;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  html.snowi-dark .snowi-page {
    --bg-color: #121212;
    --card-bg: #242426;
    --text-main: #dcdcdc;
    --text-sub: #aaaaaa;
    --icon-color: #aaaaaa;
    --btn-hover: rgba(255, 255, 255, 0.1);
    --media-bg: #333333;
    --footer-bg: #1e1e20;
    --border-color: #333333;
    --accent-color: #ffffff;
    --watermark-color: #666666;
  }

  .snowi-page *, .snowi-page *::before, .snowi-page *::after {
    box-sizing: border-box;
  }

  .snowi-page * {
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .snowi-page a { text-decoration: none; color: inherit; }

  /* ---------- 布局容器 ---------- */
  .snowi-page .layout-wrapper {
    max-width: 1040px;
    margin: 0 auto;
    padding: 20px 16px;
  }

  /* ---------- Header ---------- */
  .snowi-page .site-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
  }

  .snowi-page .header-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .snowi-page .site-branding { display: flex; flex-direction: column; gap: 4px; }
  .snowi-page .site-title { font-size: 24px; font-weight: 800; color: var(--text-main); letter-spacing: 1px; }
  .snowi-page .site-desc { font-size: 13px; color: var(--text-sub); }

  .snowi-page .search-box {
    display: flex;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 6px 14px;
    width: 100%;
    max-width: 280px;
  }

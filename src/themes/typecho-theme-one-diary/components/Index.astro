---
/**
 * Snowi theme — Index (home page)
 */
import Base from '@/layouts/Base.astro';
import type { ThemeIndexProps } from '@/lib/theme-props';
import { buildAuthorLink } from '@/lib/content';
import GlobalPlayer from './GlobalPlayer.astro';
import ThemeScripts from './ThemeScripts.astro';

type Props = ThemeIndexProps;

const {
  options, urls, user, isLoggedIn, pages, currentPath, pluginCtx,
  posts, pagination, sidebarData,
} = Astro.props;

const isIndex = currentPath === '/';

const normalizePath = (p: string) => (p || '').replace(/\/+$/, '') || '/';
const isPageActive = (slug: string) =>
  normalizePath(currentPath) === normalizePath(`/${slug}`);

const recentPosts = sidebarData?.recentPosts ?? [];
const recentComments = sidebarData?.recentComments ?? [];
const sidebarCategories = sidebarData?.categories ?? [];
const archives = sidebarData?.archives ?? [];
const hasSidebar = recentPosts.length > 0 || recentComments.length > 0 || sidebarCategories.length > 0 || archives.length > 0;

/* 日期拆解 */
type DateParts = { day: string; weekday: string; yearMonth: string; time: string };
function getDateParts(ts: number, tz?: string): DateParts {
  const date = new Date(ts * 1000);
  const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
  
  try {
    const fmt = new Intl.DateTimeFormat('zh-CN', {
      timeZone: tz || undefined, year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hour12: false
    });
    const parts = fmt.formatToParts(date);
    const pick = (t: string) => parts.find((p) => p.type === t)?.value || '';
    let hour = pick('hour');
    if (hour === '24') hour = '00';
    
    const weekdayFmt = new Intl.DateTimeFormat('zh-CN', { timeZone: tz || undefined, weekday: 'short' });
    let weekday = weekdayFmt.format(date).replace('星期', '周').replace('周天', '周日').replace('星期日', '周日');
    
    return { day: pick('day'), weekday, yearMonth: `${pick('year')}/${pick('month')}`, time: `${hour}:${pick('minute')}` };
  } catch {
    const p2 = (n: number) => String(n).padStart(2, '0');
    return { 
      day: p2(date.getDate()), 
      weekday: days[date.getDay()], 
      yearMonth: `${date.getFullYear()}/${p2(date.getMonth() + 1)}`, 
      time: `${p2(date.getHours())}:${p2(date.getMinutes())}` 
    };
  }
}

/* 文章预处理 */
type MediaItem = { type: 'image' | 'livephoto'; html: string; src?: string; videoSrc?: string };
function processPost(post: any) {
  let excerpt = post.excerpt || '';
  const mediaItems: MediaItem[] = [];

  const livePhotoRegex = /<div[^>]*class="[^"]*live-photo[^"]*"[^>]*>[\s\S]*?<\/div>/g;
  let match: RegExpExecArray | null;
  while ((match = livePhotoRegex.exec(excerpt)) !== null) {
    const html = match[0];
    const imgMatch = html.match(/<img[^>]*src="([^">]+)"/);
    const videoMatch = html.match(/<video[^>]*>[\s\S]*?<source[^>]*src="([^">]+)"/) || html.match(/<video[^>]*src="([^">]+)"/);
    if (imgMatch) {
      mediaItems.push({ type: 'livephoto', html, src: imgMatch[1], videoSrc: videoMatch ? videoMatch[1] : undefined });
    }
  }
  excerpt = excerpt.replace(livePhotoRegex, '');

  const imgRegex = /<img[^>]+src="([^">]+)"[^>]*>/g;
  while ((match = imgRegex.exec(excerpt)) !== null) {
    mediaItems.push({ type: 'image', src: match[1], html: '' });
  }
  excerpt = excerpt.replace(/<img[^>]+>/g, '').trim();

  const avatarUrl = (post.author as any)?.avatarUrl || '/img/avatar.svg';

  return {
    ...post, excerpt, mediaItems, avatarUrl,
    date: getDateParts(post.created, options.timezone),
    authorName: post.author?.screenName || post.author?.name || '未知',
  };
}

const processedPosts = posts.map(processPost);

function buildGridLivePhoto(src: string, videoSrc?: string): string {
  return `<div class="live-photo">
    <img class="live-photo-img" src="${src}" alt="Live Photo">
    <video class="live-photo-video" playsinline muted preload="auto" poster="${src}">
      <source src="${videoSrc || ''}" type="video/mp4">
    </video>
  </div>`;
}
---

<script is:inline>
  try {
    var snowiTheme = localStorage.getItem('snowi-theme') || localStorage.getItem('theme');
    if (snowiTheme === 'dark') document.documentElement.classList.add('snowi-dark');
  } catch (e) {}
</script>

<Base options={options} urls={urls} user={user} isLoggedIn={isLoggedIn} pluginCtx={pluginCtx}>
  <div class="snowi-page">

    <header class="site-header" id="header">
      <div class="header-brand">
        <h1 class="site-title">{options.title}</h1>
        {options.description && <p class="site-subtitle">{options.description}</p>}
      </div>
      <nav class="header-nav">
        <a href={urls.siteUrl + '/'} class:list={['nav-item', { active: isIndex }]}>首页</a>
        {pages.map((page) => (
          <a href={page.permalink} class:list={['nav-item', { active: isPageActive(page.slug) }]}>{page.title}</a>
        ))}
        <button type="button" class="nav-item" id="snowiSearchToggle">搜索</button>
      </nav>

      <form class="header-search" id="snowiSearch" method="post" action={urls.siteUrl + '/'} role="search">
        <label for="s" class="sr-only">搜索关键字</label>
        <input type="text" id="s" name="s" class="text" placeholder="输入关键字搜索" autocomplete="off" />
        <button type="submit" class="search-submit">搜索</button>
      </form>
    </header>

    <div class="page-layout">
      <main class="post-container" id="main" role="main">

        {processedPosts.length === 0 ? (
          <div class="card-wrapper">
            <article class="post-card">
              <div class="post-text"><p>这里还没有任何文章，请通过管理后台发布。</p></div>
            </article>
          </div>
        ) : (
          processedPosts.map((post) => (
            <div class="card-wrapper">
              <article class="post-card" itemscope itemtype="http://schema.org/BlogPosting">
                <a href={post.permalink} class="card-overlay" aria-label={post.title}></a>

                <header class="post-header">
                  <div class="header-left">
                    <div class="date-top">
                      <span class="day-num" itemprop="datePublished" datetime={new Date(post.created * 1000).toISOString()}>{post.date.day}</span>
                      {post.date.weekday && <span class="weekday">{post.date.weekday}</span>}
                    </div>
                    <div class="date-bottom">
                      <span class="year-month">{post.date.yearMonth}</span>
                      <span class="time">{post.date.time}</span>
                    </div>
                  </div>
                  <div class="header-right">
                    <a class="author-name" href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'} rel="author" itemprop="name">
                      @{post.authorName}
                    </a>
                    <a
                      class="author-avatar-link"
                      href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'}
                      rel="author"
                      aria-label={post.authorName}
                    >
                      <img src={post.avatarUrl} alt={post.authorName} class="author-avatar" loading="lazy" />
                    </a>
                  </div>
                </header>

                {post.excerpt && (
                  <div class="post-text" itemprop="articleBody" set:html={post.excerpt} />
                )}

                {post.mediaItems.length === 1 && post.mediaItems[0].type === 'image' && (
                  <div class="post-images post-media" data-count="1">
                    <img src={post.mediaItems[0].src} alt="配图" loading="lazy" class="lightbox-img" />
                  </div>
                )}
                {post.mediaItems.length === 1 && post.mediaItems[0].type === 'livephoto' && (
                  <div class="post-images post-media" data-count="1" set:html={post.mediaItems[0].html} />
                )}

                {post.mediaItems.length > 1 && (
                  <div class="post-images post-media-grid" data-count={post.mediaItems.length}>
                    {post.mediaItems.map((item) =>
                      item.type === 'image' ? (
                        <img src={item.src} alt="配图" loading="lazy" class="lightbox-img" />
                      ) : (
                        <div class="media-cell" set:html={buildGridLivePhoto(item.src!, item.videoSrc)} />
                      )
                    )}
                  </div>
                )}

                {post.categories.length > 0 && (
                  <div class="post-category">
                    <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                    <span>
                      {post.categories.map((c, i) => (
                        <>{i > 0 && ' / '}<a href={c.permalink}>{c.name}</a></>
                      ))}
                    </span>
                  </div>
                )}

                <footer class="post-actions">
                  <a class="action-btn" href={`${post.permalink}#comments`} aria-label="评论">
                    <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    {post.commentsNum > 0 && <span class="action-count">{post.commentsNum}</span>}
                  </a>
                  <button class="action-btn share-btn" type="button" aria-label="分享下载">
                    <svg viewBox="0 0 24 24"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
                  </button>
                </footer>
              </article>
            </div>
          ))
        )}

        {pagination.totalPages > 1 && (
          <nav class="page-navigator">
            {pagination.hasPrev && <a class="prev" href={pagination.prevUrl!}>&laquo; 前一页</a>}
            {pagination.hasNext && <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>}
          </nav>
        )}
      </main>

      <aside class:list={['sidebar-section', { 'sidebar-empty': !hasSidebar }]} id="secondary" role="complementary">
        {hasSidebar && (
          <>
            {recentPosts.length > 0 && (
              <div class="widget">
                <h3 class="widget-title">最新文章</h3>
                <ul class="widget-list">
                  {recentPosts.map((p: any) => <li><a href={p.permalink}>{p.title}</a></li>)}
                </ul>
              </div>
            )}
            {recentComments.length > 0 && (
              <div class="widget">
                <h3 class="widget-title">最近回复</h3>
                <ul class="widget-list widget-comments">
                  {recentComments.map((c: any) => (
                    <li>
                      <a href={c.permalink} class="widget-comment-link">
                        <span class="widget-comment-author">{c.author}</span>
                        <span class="widget-comment-excerpt">{c.excerpt}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {sidebarCategories.length > 0 && (
              <div class="widget">
                <h3 class="widget-title">分类</h3>
                <ul class="widget-list">
                  {sidebarCategories.map((cat: any) => (
                    <li><a href={cat.permalink}>{cat.name} <span class="widget-count">{cat.count}</span></a></li>
                  ))}
                </ul>
              </div>
            )}
            {archives.length > 0 && (
              <div class="widget">
                <h3 class="widget-title">归档</h3>
                <ul class="widget-list">
                  {archives.map((a: any) => <li><a href={a.permalink}>{a.date}</a></li>)}
                </ul>
              </div>
            )}
            <div class="widget">
              <h3 class="widget-title">其它</h3>
              <ul class="widget-list">
                {isLoggedIn ? (
                  <>
                    <li><a href={urls.adminUrl} data-no-swup>后台 ({user?.screenName || user?.name})</a></li>
                    <li><form method="post" action={urls.logoutUrl}><button type="submit" class="logout-btn">退出登录</button></form></li>
                  </>
                ) : (
                  <li><a href={urls.loginUrl} data-no-swup>登录</a></li>
                )}
                <li><a href={urls.feedUrl} data-no-swup>文章 RSS</a></li>
              </ul>
            </div>
          </>
        )}
      </aside>
    </div>

    <footer class="page-footer" id="footer">
      <button class="theme-toggle" id="snowiThemeToggle" type="button">
        <span id="snowiThemeIcon">🌙</span>
        <span id="snowiThemeText">切换至暗色模式</span>
      </button>

      <p class="site-copyright">
        &copy; {new Date().getFullYear()} <a href={urls.siteUrl}>{options.title}</a> · 一起来堆雪人！
      </p>
    </footer>
  </div>

  <script is:inline src="/js/mood-player.min.js"></script>
  <ThemeScripts siteTitle={options.title} />
  <GlobalPlayer />
</Base>

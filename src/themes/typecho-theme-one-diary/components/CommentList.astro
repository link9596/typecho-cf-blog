---
/**
 * Snowi theme — Recursive comment list component
 *
 * 结构轻改：头像 + 作者 + 时间横排，正文独立成块，便于卡片化。
 * 属性 / 事件 / 递归逻辑与原组件完全一致：
 *  - li 保留 id="comment-{coid}"，供 TypechoComment.reply 迁移 #respond
 *  - 回复链接保留 onclick / data-coid / rel
 *  - 子评论仍走 Astro.self 递归
 */
import type { CommentNode, CommentOptions } from '@/lib/theme-props';
import { formatDate } from '@/lib/content';

interface Props {
  comments: CommentNode[];
  commentOptions: CommentOptions;
  gravatarMap: Record<number, string>;
  permalink: string;
}

const { comments, commentOptions, gravatarMap, permalink } = Astro.props;
---
{comments.map((node) => (
  <li class="comment-body" id={`comment-${node.coid}`}>
    <div class="comment-main">
      <div class="comment-head">
        {commentOptions.showAvatar && (
          <img
            class="avatar"
            src={gravatarMap[node.coid] || `https://gravatar.com/avatar/?d=identicon&s=40`}
            alt={node.author}
            width="32"
            height="32"
            loading="lazy"
          />
        )}
        <div class="comment-head-info">
          <cite class="fn">
            {node.url && commentOptions.showUrl ? (
              <a href={node.url} rel="external nofollow">{node.author}</a>
            ) : (
              node.author
            )}
          </cite>
          <time
            class="comment-time"
            datetime={new Date(node.created * 1000).toISOString()}
          >
            {formatDate(node.created, commentOptions.dateFormat, commentOptions.timezone)}
          </time>
        </div>
      </div>

      <div class="comment-content" set:html={node.text} />

      {commentOptions.allowComment && (
        <div class="comment-reply">
          <a
            href="#respond"
            data-coid={node.coid}
            class="comment-reply-link"
            rel="nofollow"
            onclick={`return TypechoComment.reply('comment-${node.coid}', ${node.coid})`}
          >回复</a>
        </div>
      )}
    </div>

    {node.children.length > 0 && (
      <div class="comment-children">
        <ol class="comment-list">
          <Astro.self
            comments={node.children}
            commentOptions={commentOptions}
            gravatarMap={gravatarMap}
            permalink={permalink}
          />
        </ol>
      </div>
    )}
  </li>
))}

<!-- ==================================================================== -->
<!-- 评论样式（全局注入，组件递归多次也只注入一次）                        -->
<!-- ==================================================================== -->
<style is:global>
  /* ---------- 列表容器 ---------- */
  .snowi-page .comment-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .snowi-page .comment-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-main);
    word-break: break-word;
  }

  /* ---------- 单条评论气泡 ---------- */
  .snowi-page .comment-main {
    background-color: var(--footer-bg);
    border-radius: 12px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  /* ---------- 头部：头像 + 作者 + 时间 ---------- */
  .snowi-page .comment-head {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .snowi-page .comment-head .avatar {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    object-fit: cover;
    background-color: var(--media-bg);
    flex-shrink: 0;
    display: block;
  }

  .snowi-page .comment-head-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .snowi-page .comment-head .fn {
    font-style: normal;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-main);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .snowi-page .comment-head .fn a {
    color: inherit;
    text-decoration: none;
  }

  .snowi-page .comment-head .fn a:hover {
    color: var(--text-sub);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .snowi-page .comment-head .comment-time {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3px;
    color: var(--text-sub);
  }

  /* ---------- 评论正文 ---------- */
  .snowi-page .comment-content {
    font-size: 14px;
    line-height: 1.75;
    color: var(--text-main);
    word-break: break-word;
  }

  .snowi-page .comment-content p {
    margin: 0 0 8px;
  }

  .snowi-page .comment-content p:last-child {
    margin-bottom: 0;
  }

  .snowi-page .comment-content a {
    color: var(--text-main);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--text-sub);
    word-break: break-word;
  }

  .snowi-page .comment-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 6px 0;
    display: block;
    background-color: var(--media-bg);
  }

  .snowi-page .comment-content blockquote {
    margin: 8px 0;
    padding: 8px 12px;
    border-left: 3px solid var(--text-sub);
    background-color: var(--card-bg);
    border-radius: 0 8px 8px 0;
    color: var(--text-sub);
  }

  .snowi-page .comment-content code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em;
    background-color: var(--card-bg);
    padding: 2px 6px;
    border-radius: 6px;
  }

  .snowi-page .comment-content pre {
    background-color: var(--card-bg);
    padding: 12px;
    border-radius: 10px;
    overflow-x: auto;
    margin: 8px 0;
  }

  .snowi-page .comment-content pre code {
    background: none;
    padding: 0;
  }

  /* ---------- 回复按钮 ---------- */
  .snowi-page .comment-reply {
    display: flex;
    justify-content: flex-end;
  }

  .snowi-page .comment-reply-link {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-sub);
    text-decoration: none;
    padding: 3px 10px;
    border-radius: 10px;
    background-color: var(--btn-hover);
    transition: all 0.2s;
  }

  .snowi-page .comment-reply-link:hover {
    color: var(--text-main);
    background-color: var(--media-bg);
  }

  /* ---------- 子评论 ---------- */
  .snowi-page .comment-children {
    margin-top: 8px;
    padding-left: 12px;
    border-left: 2px solid var(--btn-hover);
  }

  /* 抵消 Post / Page 里对嵌套 .comment-list 的通用缩进，避免双重边框 */
  .snowi-page .comment-children > .comment-list {
    margin: 0;
    padding-left: 0;
    border-left: none;
  }

  /* ---------- #respond 被迁移进某条评论时 ---------- */
  .snowi-page .comment-body > .respond {
    margin-top: 4px;
    background-color: var(--footer-bg);
    border-radius: 12px;
    padding: 14px;
  }

  .snowi-page .comment-body > .respond .respond-title {
    font-size: 14px;
  }
</style>
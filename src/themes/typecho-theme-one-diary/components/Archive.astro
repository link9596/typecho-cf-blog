---
/**
 * Snowi theme — Archive list component
 *
 * 共享模板：分类 / 标签 / 作者 / 搜索 / 归档 页面通用。
 *
 * 保持 Snowi 极简日记流风格：
 *  - 页首 / 页脚 / 主题切换 / 搜索展开 与其它页面一致
 *  - 归档标题 + 类型徽章 作为首张卡片
 *  - 每篇文章一张日记卡片（日期 + 作者 + 标题 + 摘要 + 分类 + 评论/阅读全文）
 *  - 分页 + 侧边栏（最新文章 / 最近回复 / 分类 / 归档 / 其它）
 *  - 保留 GlobalPlayer，切页时吸附播放器不丢失
 */
import Base from '@/layouts/Base.astro';
import type { ThemeArchiveProps } from '@/lib/theme-props';
import { buildAuthorLink, getDateParts } from '@/lib/content';
import GlobalPlayer from './GlobalPlayer.astro';
import ThemeScripts from './ThemeScripts.astro';
import VisibilityTag from './VisibilityTag.astro';

type Props = ThemeArchiveProps;

const {
  options, urls, user, isLoggedIn, pages, sidebarData, currentPath, pluginCtx,
  archiveTitle, archiveType, posts, pagination,
} = Astro.props;

const isIndex = currentPath === '/';

const normalizePath = (p: string) => (p || '').replace(/\/+$/, '') || '/';
const isPageActive = (slug: string) =>
  normalizePath(currentPath) === normalizePath(`/${slug}`);

/* 侧边栏数据兜底 */
const recentPosts = sidebarData?.recentPosts ?? [];
const recentComments = sidebarData?.recentComments ?? [];
const sidebarCategories = sidebarData?.categories ?? [];
const archives = sidebarData?.archives ?? [];
const hasSidebar =
  recentPosts.length > 0 ||
  recentComments.length > 0 ||
  sidebarCategories.length > 0 ||
  archives.length > 0;

/* 归档类型标签 */
const archiveTypeLabel: Record<string, string> = {
  category: '分类',
  tag: '标签',
  author: '作者',
  search: '搜索',
  index: '归档',
  date: '日期',
};
const typeLabel = archiveTypeLabel[archiveType] || '归档';

/* 预处理文章：附加日期 / 作者名 */
const processedPosts = posts.map((post) => ({
  ...post,
  date: getDateParts(post.created, options.timezone),
  authorName: post.author?.screenName || post.author?.name || '未知',
  avatarUrl: (post.author as any)?.avatarUrl || '/img/avatar.svg',
}));

const emptyText = archiveType === 'search' ? '没有找到匹配的文章。' : '暂时没有文章。';
---

<!-- 提前应用暗色主题，避免首屏闪烁 -->
<script is:inline>
  try {
    if ((localStorage.getItem('snowi-theme') || localStorage.getItem('theme')) === 'dark') {
      document.documentElement.classList.add('snowi-dark');
    }
  } catch (e) {}
</script>

<Base
  title={archiveTitle}
  options={options}
  urls={urls}
  user={user}
  isLoggedIn={isLoggedIn}
  pluginCtx={pluginCtx}
>
  <div class="snowi-page">

    <!-- ================= 页首 ================= -->
    <header class="site-header" id="header">
      <div class="header-brand">
        <h1 class="site-title">{options.title}</h1>
        {options.description && <p class="site-subtitle">{options.description}</p>}
      </div>

      <nav class="header-nav">
        <a
          href={urls.siteUrl + '/'}
          class:list={['nav-item', { active: isIndex }]}
        >首页</a>
        {pages.map((page) => (
          <a
            href={page.permalink}
            title={page.title}
            class:list={['nav-item', { active: isPageActive(page.slug) }]}
          >{page.title}</a>
        ))}
        <button type="button" class="nav-item nav-search-toggle" id="snowiSearchToggle">搜索</button>
      </nav>

      <form class="header-search" id="snowiSearch" method="post" action={urls.siteUrl + '/'} role="search">
        <label for="s" class="sr-only">搜索关键字</label>
        <input type="text" id="s" name="s" class="text" placeholder="输入关键字搜索" autocomplete="off" />
        <button type="submit" class="search-submit">搜索</button>
      </form>
    </header>

    <!-- ================= 主体：归档列表 + 侧边栏 ================= -->
    <div class="page-layout">

      <main class="cards-container" id="main" role="main">

        <!-- ========== 归档标题卡片 ========== -->
        <div class="card-wrapper">
          <div class="post-card archive-header-card">
            <span class="archive-type-badge">{typeLabel}</span>
            <h2 class="archive-title">{archiveTitle}</h2>
            <p class="archive-count">
              共 <strong>{posts.length}</strong> 篇
              {pagination.totalPages > 1 && (
                <> · 第 {pagination.currentPage} / {pagination.totalPages} 页</>
              )}
            </p>
          </div>
        </div>

        <!-- ========== 文章卡片流 ========== -->
        {processedPosts.length === 0 ? (
          <div class="card-wrapper">
            <div class="post-card empty-card">
              <div class="empty-icon" aria-hidden="true">❄️</div>
              <p class="empty-text">{emptyText}</p>
            </div>
          </div>
        ) : (
          processedPosts.map((post) => (
            <div class="card-wrapper">
              <article class="post-card" itemscope itemtype="http://schema.org/BlogPosting">
                <!-- 整卡点击层 -->
                <a href={post.permalink} class="card-overlay" aria-label={post.title}></a>

                <!-- 头部：日期 + 作者 -->
                <header class="post-header">
                  <div class="header-left">
                    <div class="date-top">
                      <span
                        class="day-num"
                        itemprop="datePublished"
                        datetime={new Date(post.created * 1000).toISOString()}
                      >{post.date.day}</span>
                      {post.date.weekday && <span class="weekday">{post.date.weekday}</span>}
                    </div>
                    <div class="date-bottom">
                      <span class="year-month">{post.date.yearMonth}</span>
                      <span class="time">{post.date.time}</span>
                      <VisibilityTag status={post.status} />
                    </div>
                  </div>

                  <div class="header-right">
                    <a
                      class="author-name"
                      href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'}
                      rel="author"
                      itemprop="author"
                    >@{post.authorName}</a>
                    <a
                      class="author-avatar-link"
                      href={post.author ? buildAuthorLink(post.author.uid, urls.siteUrl) : '#'}
                      rel="author"
                      aria-label={post.authorName}
                    >
                      <img
                        src={post.avatarUrl}
                        alt={post.authorName}
                        class="author-avatar"
                        loading="lazy"
                      />
                    </a>
                  </div>
                </header>

                <!-- 标题 -->
                <h2 class="post-title" itemprop="name headline">
                  <a itemprop="url" href={post.permalink}>{post.title}</a>
                </h2>

                <!-- 摘要 -->
                {post.excerpt && (
                  <div class="post-excerpt" itemprop="articleBody" set:html={post.excerpt} />
                )}

                <!-- 分类 -->
                {post.categories.length > 0 && (
                  <div class="post-category">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                      <line x1="7" y1="7" x2="7.01" y2="7"></line>
                    </svg>
                    <span>
                      {post.categories.map((c, i) => (
                        <>
                          {i > 0 && ' / '}
                          <a href={c.permalink}>{c.name}</a>
                        </>
                      ))}
                    </span>
                  </div>
                )}

                <!-- 底部操作 -->
                <footer class="post-actions">
                  <a
                    class="action-btn"
                    href={`${post.permalink}#comments`}
                    aria-label="评论"
                    itemprop="discussionUrl"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    {post.commentsNum > 0 && <span class="action-count">{post.commentsNum}</span>}
                  </a>
                  <a
                    class="action-btn read-more-btn"
                    href={post.permalink}
                    aria-label="阅读全文"
                  >
                    <span>阅读全文</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </footer>
              </article>
            </div>
          ))
        )}

        <!-- ========== 分页 ========== -->
        {pagination.totalPages > 1 && (
          <nav class="page-navigator">
            {pagination.hasPrev && <a class="prev" href={pagination.prevUrl!}>&laquo; 前一页</a>}
            {pagination.hasNext && <a class="next" href={pagination.nextUrl!}>后一页 &raquo;</a>}
          </nav>
        )}
      </main>

      <!-- ================= 侧边栏 ================= -->
      <aside class:list={['sidebar-section', { 'sidebar-empty': !hasSidebar }]} id="secondary" role="complementary">
        {recentPosts.length > 0 && (
          <section class="widget">
            <h3 class="widget-title">最新文章</h3>
            <ul class="widget-list">
              {recentPosts.map((p: any) => (
                <li><a href={p.permalink}>{p.title}</a></li>
              ))}
            </ul>
          </section>
        )}

        {recentComments.length > 0 && (
          <section class="widget">
            <h3 class="widget-title">最近回复</h3>
            <ul class="widget-list widget-comments">
              {recentComments.map((c: any) => (
                <li>
                  <a href={c.permalink} class="widget-comment-link">
                    <span class="widget-comment-author">{c.author}</span>
                    <span class="widget-comment-excerpt">{c.excerpt}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {sidebarCategories.length > 0 && (
          <section class="widget">
            <h3 class="widget-title">分类</h3>
            <ul class="widget-list">
                  {sidebarCategories.map((cat: any) => (
                    <li><a href={cat.permalink}>{cat.name} <span class="widget-count">{cat.count}</span></a></li>
                  ))}
                </ul>
          </section>
        )}

        {archives.length > 0 && (
          <section class="widget">
            <h3 class="widget-title">归档</h3>
            <ul class="widget-list">
              {archives.map((archive: any) => (
                <li><a href={archive.permalink}>{archive.date}</a></li>
              ))}
            </ul>
          </section>
        )}

        {hasSidebar && (
          <section class="widget">
            <h3 class="widget-title">其它</h3>
            <ul class="widget-list">
              {isLoggedIn ? (
                <>
                  <li>
                    <a href={urls.adminUrl} data-no-swup>
                      进入后台{user?.screenName || user?.name ? `（${user?.screenName || user?.name}）` : ''}
                    </a>
                  </li>
                  <li>
                    <form method="post" action={urls.logoutUrl} class="logout-form">
                      <button type="submit">退出登录</button>
                    </form>
                  </li>
                </>
              ) : (
                <li><a href={urls.loginUrl} data-no-swup>登录</a></li>
              )}
              <li><a href={urls.feedUrl} data-no-swup>文章 RSS</a></li>
              <li><a href={urls.commentsFeedUrl} data-no-swup>评论 RSS</a></li>
            </ul>
          </section>
        )}
      </aside>
    </div>

    <!-- ================= 页脚 ================= -->
    <footer class="page-footer" id="footer">
      <button class="theme-toggle" id="snowiThemeToggle" type="button">
        <span id="snowiThemeIcon">🌙</span>
        <span id="snowiThemeText">切换至暗色模式</span>
      </button>

      <p class="site-copyright">
        &copy; {new Date().getFullYear()} <a href={urls.siteUrl}>{options.title}</a> · 一起来堆雪人！
      </p>
    </footer>

  </div>

  <!-- 全局吸附播放器：搬迁逻辑 + 吸附条，位于内容之外，切页不被 Swup 替换 -->
  <GlobalPlayer />
  <ThemeScripts siteTitle={options.title} />
</Base>

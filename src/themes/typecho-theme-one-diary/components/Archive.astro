    --bg-color: #f2f3f5;
    --card-bg: #ffffff;
    --text-main: #444444;
    --text-sub: #888888;
    --icon-color: #888888;
    --btn-hover: rgba(0, 0, 0, 0.05);
    --media-bg: #eeeeee;
    --footer-bg: #fafafa;
    --watermark-color: #999999;

    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 16px 24px;
    min-height: 100vh;
    width: 100%;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  html.snowi-dark .snowi-page {
    --bg-color: #121212;
    --card-bg: #242426;
    --text-main: #dcdcdc;
    --text-sub: #aaaaaa;
    --icon-color: #aaaaaa;
    --btn-hover: rgba(255, 255, 255, 0.1);
    --media-bg: #333333;
    --footer-bg: #1e1e20;
    --watermark-color: #666666;
  }

  .snowi-page,
  .snowi-page *,
  .snowi-page *::before,
  .snowi-page *::after {
    box-sizing: border-box;
  }

  .snowi-page * {
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .snowi-page .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- 页首 ---------- */
  .snowi-page .site-header {
    width: 100%;
    max-width: 440px;
    margin-bottom: 20px;
    padding: 0 4px;
  }

  .snowi-page .header-brand {
    margin-bottom: 24px;
  }

  .snowi-page .site-title {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--text-main);
    margin: 0 0 8px;

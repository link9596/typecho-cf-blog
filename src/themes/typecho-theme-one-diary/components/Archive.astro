    line-height: 1.2;
    color: var(--text-sub);
    padding: 8px 18px;
    border: none;
    border-radius: 20px;
    background-color: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .snowi-page .nav-item:hover {
    background-color: var(--btn-hover);
    color: var(--text-main);
  }

  .snowi-page .nav-item.active {
    background-color: var(--card-bg);
    color: var(--text-main);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  html.snowi-dark .snowi-page .nav-item.active {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .snowi-page .header-search {
    display: none;
    gap: 8px;
    margin-top: 14px;
  }

  .snowi-page .header-search.open {
    display: flex;
  }


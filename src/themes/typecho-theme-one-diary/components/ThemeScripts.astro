---
/**
 * Snowi theme — shared client behaviour
 */
interface Props {
  siteTitle?: string;
}

const { siteTitle = '' } = Astro.props;
---

<script is:inline define:vars={{ siteTitle }}>
  (function () {
    'use strict';

    if (window.__snowiThemeInit) return;
    window.__snowiThemeInit = true;

    var root = document.documentElement;
    var STORAGE_KEY = 'snowi-theme';
    var LEGACY_KEY = 'theme';

    /* ================= 主题切换 ================= */

    function getStoredTheme() {
      try {
        return localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_KEY);
      } catch (e) { return null; }
    }

    function setStoredTheme(value) {
      try {
        localStorage.setItem(STORAGE_KEY, value);
        localStorage.removeItem(LEGACY_KEY);
      } catch (e) {}
    }

    function isDark() {
      return root.classList.contains('snowi-dark');
    }

    function syncThemeUI() {
      var dark = isDark();
      var icons = document.querySelectorAll('#snowiThemeIcon, #themeIcon');
      for (var i = 0; i < icons.length; i++) icons[i].textContent = dark ? '☀️' : '🌙';
      
      var texts = document.querySelectorAll('#snowiThemeText, #themeText');
      for (var j = 0; j < texts.length; j++) texts[j].textContent = dark ? '切换至亮色模式' : '切换至暗色模式';
      
      var buttons = document.querySelectorAll('#snowiThemeToggle, #themeToggle');
      for (var k = 0; k < buttons.length; k++) buttons[k].setAttribute('aria-pressed', dark ? 'true' : 'false');
    }

    function applyTheme(dark, persist) {
      if (dark) root.classList.add('snowi-dark');
      else root.classList.remove('snowi-dark');
      if (persist) setStoredTheme(dark ? 'dark' : 'light');
      syncThemeUI();
    }

    var storedTheme = getStoredTheme();
    if (storedTheme === 'dark') root.classList.add('snowi-dark');
    else if (storedTheme === 'light') root.classList.remove('snowi-dark');
    syncThemeUI();

    /* ================= 评论回复 ================= */

    window.TypechoComment = {
      dom: function (id) { return document.getElementById(id); },
      reply: function (commentId, coid) {
        var comment = this.dom(commentId), respond = this.dom('respond'), cancelLink = this.dom('cancel-comment-reply-link'), parentInput = this.dom('comment-parent');
        if (!comment || !respond || !parentInput) return true;
        parentInput.value = coid; comment.appendChild(respond);
        if (cancelLink) cancelLink.style.display = '';
        try { var textarea = this.dom('textarea'); if (textarea) textarea.focus(); } catch (e) {}
        return false;
      },
      cancelReply: function () {
        var respond = this.dom('respond'), cancelLink = this.dom('cancel-comment-reply-link'), parentInput = this.dom('comment-parent'), comments = this.dom('comments');
        if (!respond || !comments || !parentInput) return false;
        parentInput.value = '0'; if (cancelLink) cancelLink.style.display = 'none'; comments.appendChild(respond);
        return false;
      }
    };

    /* ================= 播放器脚本 ================= */

    function ensureMoodPlayer() {
      try { if (typeof customElements === 'undefined' || customElements.get('mood-player')) return; } catch (e) { return; }
      if (!document.querySelector('mood-player')) return;
      if (window.__snowiMoodPlayerLoading) return;
      window.__snowiMoodPlayerLoading = true;
      var script = document.createElement('script');
      script.src = '/js/mood-player.min.js';
      script.async = true;
      script.onload = function () { window.__snowiMoodPlayerLoading = false; };
      script.onerror = function () { window.__snowiMoodPlayerLoading = false; };
      document.head.appendChild(script);
    }
    ensureMoodPlayer();

    /* ================= 分享截图（原生 Canvas 方案） ================= */

    var FONT_STACK = '"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Helvetica Neue",Arial,sans-serif';
    
    function getPageType() {
      if (document.querySelector('.post-detail-card')) return 'post';
      if (document.querySelector('.page-detail-card')) return 'page';
      if (document.querySelector('.archive-header-card')) return 'archive';
      return 'index';
    }

    function showCaptureOverlay() {
      var overlay = document.createElement('div');
      overlay.className = 'snowi-capture-overlay';
      overlay.innerHTML = '<span class="snowi-capture-spinner"></span><span>生成图片中…</span>';
      document.body.appendChild(overlay);
      return overlay;
    }

    function roundRectPath(c, x, y, w, h, r) {
      r = Math.min(r, w / 2, h / 2);
      c.beginPath(); c.moveTo(x + r, y);
      c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r);
      c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r);
      c.closePath();
    }

    function wrapText(c, text, maxWidth) {
      var lines = [], chars = Array.from(text || '');
      var isWordChar = function(ch) { return /[A-Za-z0-9@#$%&*_+\-='"]/.test(ch); };
      var line = '', i = 0;
      while (i < chars.length) {
        var token = chars[i];
        if (isWordChar(token)) {
          var j = i + 1;
          while (j < chars.length && isWordChar(chars[j])) { token += chars[j]; j++; }
          i = j;
        } else { i++; }
        if (line === '') {
          if (token === ' ') continue;
          line = token; continue;
        }
        if (c.measureText(line + token).width > maxWidth) {
          lines.push(line); line = token === ' ' ? '' : token;
        } else { line += token; }
      }
      if (line !== '') lines.push(line);
      return lines.length ? lines : [''];
    }

    // 安全加载图片，强制 CORS 和破缓存
    function loadImageCorsSafe(src) {
      if (!src || /^(data:|blob:)/i.test(src)) return Promise.resolve(null);
      return new Promise(function (resolve) {
        var img = new Image();
        img.crossOrigin = 'anonymous';
        var cacheBustUrl = src + (src.indexOf('?') > -1 ? '&' : '?') + 'snowi_t=' + Date.now();
        
        var timer = setTimeout(function () { resolve(null); }, 8000);
        img.onload = function () {
          clearTimeout(timer);
          if (typeof img.decode === 'function') {
            img.decode().then(function() { resolve(img); }).catch(function() { resolve(img); });
          } else {
            resolve(img);
          }
        };
        img.onerror = function () { clearTimeout(timer); resolve(null); };
        img.src = cacheBustUrl;
      });
    }

    /* ================= 核心绘图逻辑 ================= */
    async function drawCardToCanvas(wrapper, siteTitle) {
      var CARD_W = 600;
      var PAD = 28;
      var CONTENT_W = CARD_W - PAD * 2;
      var SCALE = 2;

      var dark = isDark();
      var colorBg = dark ? '#1e1e1e' : '#ffffff';
      var colorTitle = dark ? '#f0f0f0' : '#1a1a1a';
      var colorText = dark ? '#d4d4d4' : '#2f3238';
      var colorSub = dark ? '#999999' : '#888888';

      // 1. 提取 DOM 数据
      var data = {
        dayNum: (wrapper.querySelector('.day-num') || {}).textContent || '',
        weekday: (wrapper.querySelector('.weekday') || {}).textContent || '',
        yearMonth: (wrapper.querySelector('.year-month') || {}).textContent || '',
        time: (wrapper.querySelector('.time') || {}).textContent || '',
        authorName: (wrapper.querySelector('.author-name') || {}).textContent || '',
        avatarSrc: wrapper.querySelector('.author-avatar') ? wrapper.querySelector('.author-avatar').getAttribute('src') : '',
        paragraphs: [],
        images: []
      };

      // 提取正文（按 p 标签分段，并剔除空段）
      var pEls = wrapper.querySelectorAll('.post-text p');
      if (pEls.length > 0) {
        for (var i = 0; i < pEls.length; i++) {
          var txt = pEls[i].textContent.trim();
          if (txt) data.paragraphs.push(txt);
        }
      } else {
        var textEl = wrapper.querySelector('.post-text');
        if (textEl && textEl.textContent.trim()) data.paragraphs.push(textEl.textContent.trim());
      }

      // 提取配图
      var imgEls = wrapper.querySelectorAll('.post-images img');
      for (var i = 0; i < imgEls.length; i++) {
        var src = imgEls[i].getAttribute('src');
        if (src) data.images.push(src);
      }

      // 2. 加载图片资源
      var avatarImg = null;
      if (data.avatarSrc) avatarImg = await loadImageCorsSafe(data.avatarSrc);
      
      var loadedImgs = await Promise.all(data.images.map(function(src) { return loadImageCorsSafe(src); }));
      loadedImgs = loadedImgs.filter(Boolean);

      // 3. 计算高度与布局
      var measureCtx = document.createElement('canvas').getContext('2d');
      
      // 头部 (高 80px)
      var HEADER_H = 80;
      
      // 正文（字号 16px，行高 26px，段落间距 12px）
      var BODY_SIZE = 16;
      var LINE_H = 26;
      var PARA_GAP = 12;
      var bodyTotalH = 0;
      var textLines = []; // [{ text, isParaEnd }]
      
      measureCtx.font = BODY_SIZE + 'px ' + FONT_STACK;
      for (var p = 0; p < data.paragraphs.length; p++) {
        var lines = wrapText(measureCtx, data.paragraphs[p], CONTENT_W);
        for (var l = 0; l < lines.length; l++) {
          textLines.push({ text: lines[l], isParaEnd: (l === lines.length - 1) });
        }
      }
      bodyTotalH = textLines.length * LINE_H + (data.paragraphs.length > 0 ? data.paragraphs.length * PARA_GAP : 0);

      // 图片网格
      var imgAreaH = 0;
      var imgRects = [];
      var gap = 8;
      var numImgs = loadedImgs.length;
      
      if (numImgs === 1) {
        var nw = loadedImgs[0].naturalWidth || 1, nh = loadedImgs[0].naturalHeight || 1;
        var h = Math.round(CONTENT_W * nh / nw);
        imgRects.push({ x: PAD, y: 0, w: CONTENT_W, h: Math.min(h, 600), img: loadedImgs[0] });
        imgAreaH = imgRects[0].h + 20;
      } else if (numImgs > 1) {
        var cols = numImgs === 2 ? 2 : 3;
        var w = (CONTENT_W - gap * (cols - 1)) / cols;
        var rows = Math.ceil(numImgs / cols);
        for (var i = 0; i < numImgs; i++) {
          var r = Math.floor(i / cols), c = i % cols;
          imgRects.push({ x: PAD + c * (w + gap), y: r * (w + gap), w: w, h: w, img: loadedImgs[i] });
        }
        imgAreaH = rows * w + (rows - 1) * gap + 20;
      }

      // 底部水印 (高 60px)
      var FOOTER_H = 60;

      // 总高度
      var totalH = PAD + HEADER_H + bodyTotalH + imgAreaH + FOOTER_H;

      // 4. 正式绘制
      var canvas = document.createElement('canvas');
      canvas.width = CARD_W * SCALE;
      canvas.height = totalH * SCALE;
      var ctx = canvas.getContext('2d');
      ctx.scale(SCALE, SCALE);

      // 背景
      ctx.fillStyle = colorBg;
      ctx.fillRect(0, 0, CARD_W, totalH);

      var currentY = PAD;

      /* --- 头部 --- */
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      
      // 左侧：大日期 + 星期
      ctx.fillStyle = colorTitle;
      ctx.font = 'bold 32px ' + FONT_STACK;
      ctx.fillText(data.dayNum, PAD, currentY + 26);
      var dayW = ctx.measureText(data.dayNum).width;

      ctx.fillStyle = colorTitle;
      ctx.font = 'bold 16px ' + FONT_STACK;
      ctx.fillText(data.weekday, PAD + dayW + 8, currentY + 24);

      // 左侧：年月 + 时间
      ctx.fillStyle = colorSub;
      ctx.font = '13px ' + FONT_STACK;
      ctx.fillText(data.yearMonth + ' ' + data.time, PAD, currentY + 48);

      // 右侧：作者 + 头像
      var AVATAR = 40;
      if (avatarImg) {
        var ax = CARD_W - PAD - AVATAR, ay = currentY - 6;
        ctx.save();
        ctx.beginPath(); ctx.arc(ax + AVATAR/2, ay + AVATAR/2, AVATAR/2, 0, Math.PI * 2); ctx.clip();
        ctx.drawImage(avatarImg, ax, ay, AVATAR, AVATAR);
        ctx.restore();
      }
      if (data.authorName) {
        ctx.fillStyle = colorSub;
        ctx.font = '600 15px ' + FONT_STACK;
        ctx.textAlign = 'right';
        ctx.fillText(data.authorName, CARD_W - PAD - AVATAR - 12, currentY + 20);
      }

      currentY += HEADER_H;

      /* --- 正文 --- */
      ctx.fillStyle = colorText;
      ctx.font = BODY_SIZE + 'px ' + FONT_STACK;
      ctx.textAlign = 'left';
      
      for (var i = 0; i < textLines.length; i++) {
        var item = textLines[i];
        ctx.fillText(item.text, PAD, currentY + 16);
        currentY += LINE_H;
        if (item.isParaEnd) currentY += PARA_GAP;
      }
      
      if (data.paragraphs.length > 0) currentY += 8; // 正文与图片的间距

      /* --- 图片网格 --- */
      for (var i = 0; i < imgRects.length; i++) {
        var r = imgRects[i];
        var drawY = currentY + r.y;
        
        // 绘制底部的灰色占位
        ctx.save();
        roundRectPath(ctx, r.x, drawY, r.w, r.h, 8);
        ctx.fillStyle = dark ? '#2a2a2a' : '#f2f3f5';
        ctx.fill();
        
        // 绘制真实图片
        ctx.clip();
        var nw = r.img.naturalWidth, nh = r.img.naturalHeight;
        var dstRatio = r.w / r.h, srcRatio = nw / nh;
        var sx = 0, sy = 0, sw = nw, sh = nh;
        if (srcRatio > dstRatio) { sw = nh * dstRatio; sx = (nw - sw)/2; }
        else if (srcRatio < dstRatio) { sh = nw / dstRatio; sy = (nh - sh)/2; }
        ctx.drawImage(r.img, sx, sy, sw, sh, r.x, drawY, r.w, r.h);
        ctx.restore();
      }
      currentY += imgAreaH;

      /* --- 底部水印 --- */
      currentY += 10;
      ctx.fillStyle = colorSub;
      ctx.font = '600 14px ' + FONT_STACK;
      ctx.textAlign = 'center';
      ctx.fillText('❄️ ' + (siteTitle || 'Snowi'), CARD_W / 2, currentY + 16);

      return canvas;
    }

    /* ---------- 下载 ---------- */
    async function triggerDownload(canvas, filename) {
      return new Promise(function(resolve, reject) {
        try {
          canvas.toBlob(function(blob) {
            if (!blob) { reject(new Error('Canvas 转 Blob 失败(污染)')); return; }
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.download = filename;
            link.href = url;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(function() { URL.revokeObjectURL(url); resolve(); }, 1000);
          }, 'image/png');
        } catch(e) { reject(e); }
      });
    }

    /* ---------- 分享主流程 ---------- */
    async function handleShare(btn) {
      if (btn.disabled || btn.dataset.snowiBusy === '1') return;
      var wrapper = btn.closest('.card-wrapper');
      if (!wrapper) return;

      var overlay = showCaptureOverlay();
      btn.disabled = true;
      btn.dataset.snowiBusy = '1';

      try {
        var canvas = await drawCardToCanvas(wrapper, siteTitle);
        var type = getPageType();
        var prefix = type === 'index' ? 'Snowi-' : 'Snowi-' + type.charAt(0).toUpperCase() + type.slice(1) + '-';
        var filename = prefix + Date.now() + '.png';
        
        await triggerDownload(canvas, filename);
      } catch (err) {
        console.error('截图失败:', err);
        alert('生成图片失败，请稍后重试。');
      } finally {
        overlay.remove();
        btn.disabled = false;
        delete btn.dataset.snowiBusy;
      }
    }

    /* ================= 事件委托 ================= */

    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var themeBtn = target.closest('#snowiThemeToggle, #themeToggle');
      if (themeBtn) { e.preventDefault(); applyTheme(!isDark(), true); return; }

      var searchBtn = target.closest('#snowiSearchToggle');
      if (searchBtn) {
        e.preventDefault();
        var form = document.getElementById('snowiSearch');
        if (!form) return;
        var open = form.classList.toggle('open');
        searchBtn.classList.toggle('active', open);
        if (open) { var input = form.querySelector('input'); if (input) input.focus(); }
        return;
      }

      var shareBtn = target.closest('.share-btn');
      if (shareBtn) { e.preventDefault(); handleShare(shareBtn); return; }

      var card = target.closest('.post-card');
      if (!card) return;
      var cardOverlay = card.querySelector('.card-overlay');
      if (!cardOverlay) return;
      if (target.closest('a, button, input, textarea, select, label, form, video, audio, mood-player, .post-actions, .post-media, .post-media-grid, .live-photo, .post-category, .post-tags, .lightbox-img')) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      var selection = '';
      try { selection = String(window.getSelection ? window.getSelection() : ''); } catch (err) {}
      if (selection) return;

      e.preventDefault();
      cardOverlay.click();
    });

    /* ================= Swup / Astro 切页 ================= */

    document.addEventListener('astro:after-swap', function () {
      var main = document.getElementById('main');
      if (!main) return;
      main.classList.remove('snowi-page-in');
      void main.offsetWidth;
      main.classList.add('snowi-page-in');
    });

    document.addEventListener('astro:page-load', function () {
      syncThemeUI();
      ensureMoodPlayer();
      try { document.dispatchEvent(new Event('page:view')); } catch (e) {}
      try { document.dispatchEvent(new Event('swup:page:view')); } catch (e) {}
    });
  })();
</script>
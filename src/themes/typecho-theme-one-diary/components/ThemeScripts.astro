---
/**
 * Snowi theme — shared client behaviour
 *
 * 集中处理主题切换、搜索展开、分享截图与评论回复。
 * 所有交互都使用 document 级事件委托，因此 Swup 替换
 * #header / #main / #secondary / #footer 后无需重新绑定。
 */
interface Props {
  siteTitle?: string;
}

const { siteTitle = '' } = Astro.props;
---

<script is:inline define:vars={{ siteTitle }}>
  (function () {
    'use strict';

    if (window.__snowiThemeInit) return;
    window.__snowiThemeInit = true;

    var root = document.documentElement;
    var STORAGE_KEY = 'snowi-theme';
    var LEGACY_KEY = 'theme';

    /* ================= 主题切换 ================= */

    function getStoredTheme() {
      try {
        return localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_KEY);
      } catch (e) {
        return null;
      }
    }

    function setStoredTheme(value) {
      try {
        localStorage.setItem(STORAGE_KEY, value);
        localStorage.removeItem(LEGACY_KEY);
      } catch (e) {}
    }

    function isDark() {
      return root.classList.contains('snowi-dark');
    }

    function syncThemeUI() {
      var dark = isDark();
      var icons = document.querySelectorAll('#snowiThemeIcon, #themeIcon');
      for (var i = 0; i < icons.length; i++) {
        icons[i].textContent = dark ? '☀️' : '🌙';
      }
      var texts = document.querySelectorAll('#snowiThemeText, #themeText');
      for (var j = 0; j < texts.length; j++) {
        texts[j].textContent = dark ? '切换至亮色模式' : '切换至暗色模式';
      }
      var buttons = document.querySelectorAll('#snowiThemeToggle, #themeToggle');
      for (var k = 0; k < buttons.length; k++) {
        buttons[k].setAttribute('aria-pressed', dark ? 'true' : 'false');
      }
    }

    function applyTheme(dark, persist) {
      if (dark) root.classList.add('snowi-dark');
      else root.classList.remove('snowi-dark');
      if (persist) setStoredTheme(dark ? 'dark' : 'light');
      syncThemeUI();
    }

    var storedTheme = getStoredTheme();
    if (storedTheme === 'dark') root.classList.add('snowi-dark');
    else if (storedTheme === 'light') root.classList.remove('snowi-dark');
    syncThemeUI();

    /* ================= 评论回复 ================= */

    window.TypechoComment = {
      dom: function (id) {
        return document.getElementById(id);
      },
      reply: function (commentId, coid) {
        var comment = this.dom(commentId);
        var respond = this.dom('respond');
        var cancelLink = this.dom('cancel-comment-reply-link');
        var parentInput = this.dom('comment-parent');
        if (!comment || !respond || !parentInput) return true;
        parentInput.value = coid;
        comment.appendChild(respond);
        if (cancelLink) cancelLink.style.display = '';
        try {
          var textarea = this.dom('textarea');
          if (textarea) textarea.focus();
        } catch (e) {}
        return false;
      },
      cancelReply: function () {
        var respond = this.dom('respond');
        var cancelLink = this.dom('cancel-comment-reply-link');
        var parentInput = this.dom('comment-parent');
        var comments = this.dom('comments');
        if (!respond || !comments || !parentInput) return false;
        parentInput.value = '0';
        if (cancelLink) cancelLink.style.display = 'none';
        comments.appendChild(respond);
        return false;
      }
    };

    /* ================= 播放器脚本（按需加载，兼容 Swup） ================= */

    function ensureMoodPlayer() {
      try {
        if (typeof customElements === 'undefined' || customElements.get('mood-player')) return;
      } catch (e) {
        return;
      }
      if (!document.querySelector('mood-player')) return;
      if (window.__snowiMoodPlayerLoading) return;
      window.__snowiMoodPlayerLoading = true;
      var script = document.createElement('script');
      script.src = '/js/mood-player.min.js';
      script.async = true;
      script.onload = function () {
        window.__snowiMoodPlayerLoading = false;
      };
      script.onerror = function () {
        window.__snowiMoodPlayerLoading = false;
      };
      document.head.appendChild(script);
    }

    ensureMoodPlayer();

    /* ================= 分享截图（原生 Canvas 方案） ================= */

    var FONT_STACK = '"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Helvetica Neue",Arial,sans-serif';
    var TRANSPARENT_PIXEL = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
    var IS_SAFARI = /^((?!chrome|android).)*safari/i.test(navigator.userAgent) || /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    function pad2(n) { return n < 10 ? '0' + n : '' + n; }
    function stamp() {
      var d = new Date();
      return pad2(d.getMinutes()) + ':' + pad2(d.getSeconds()) + '.' + pad2(Math.floor(d.getMilliseconds() / 100));
    }

    function getPageType() {
      if (document.querySelector('.post-detail-card')) return 'post';
      if (document.querySelector('.page-detail-card')) return 'page';
      if (document.querySelector('.archive-header-card')) return 'archive';
      if (document.querySelector('.notfound-card')) return 'notfound';
      return 'index';
    }

    function showCaptureOverlay() {
      var overlay = document.createElement('div');
      overlay.className = 'snowi-capture-overlay';
      overlay.innerHTML = '<span class="snowi-capture-spinner"></span><span>生成图片中…</span>';
      document.body.appendChild(overlay);
      return overlay;
    }

    function roundRectPath(c, x, y, w, h, r) {
      r = Math.min(r, w / 2, h / 2);
      c.beginPath();
      c.moveTo(x + r, y);
      c.arcTo(x + w, y, x + w, y + h, r);
      c.arcTo(x + w, y + h, x, y + h, r);
      c.arcTo(x, y + h, x, y, r);
      c.arcTo(x, y, x + w, y, r);
      c.closePath();
    }

    function wrapText(c, text, maxWidth) {
      var lines = [];
      var chars = Array.from(text || '');
      var isWordChar = function(ch) { return /[A-Za-z0-9@#$%&*_+\-='"]/.test(ch); };
      var line = '', i = 0;
      while (i < chars.length) {
        var token = chars[i];
        if (isWordChar(token)) {
          var j = i + 1;
          while (j < chars.length && isWordChar(chars[j])) { token += chars[j]; j++; }
          i = j;
        } else { i++; }
        if (line === '') {
          if (token === ' ') continue;
          line = token; continue;
        }
        if (c.measureText(line + token).width > maxWidth) {
          lines.push(line);
          line = token === ' ' ? '' : token;
        } else { line += token; }
      }
      if (line !== '') lines.push(line);
      return lines.length ? lines : [''];
    }

    /* 图标绘制函数（复用） */
    function drawRepost(c, x, y, s, color) {
      var topY = y + s * 0.32, botY = y + s * 0.68, left = x + s * 0.08, right = x + s * 0.92;
      c.save(); c.strokeStyle = color; c.fillStyle = color; c.lineWidth = 1.5; c.lineCap = 'round'; c.lineJoin = 'round';
      c.beginPath(); c.moveTo(left + s * 0.06, topY); c.lineTo(right - s * 0.14, topY); c.stroke();
      c.beginPath(); c.moveTo(right - s * 0.30, topY - s * 0.16); c.lineTo(right - s * 0.08, topY); c.lineTo(right - s * 0.30, topY + s * 0.16); c.closePath(); c.fill();
      c.beginPath(); c.moveTo(right - s * 0.06, botY); c.lineTo(left + s * 0.14, botY); c.stroke();
      c.beginPath(); c.moveTo(left + s * 0.30, botY - s * 0.16); c.lineTo(left + s * 0.08, botY); c.lineTo(left + s * 0.30, botY + s * 0.16); c.closePath(); c.fill();
      c.restore();
    }
    function drawComment(c, x, y, s, color) {
      var bx = x + s * 0.08, by = y + s * 0.10, bw = s * 0.84, bh = s * 0.60, r = s * 0.18;
      c.save(); c.strokeStyle = color; c.fillStyle = color; c.lineWidth = 1.5; c.lineJoin = 'round';
      c.beginPath(); c.moveTo(bx + r, by); c.lineTo(bx + bw - r, by); c.quadraticCurveTo(bx + bw, by, bx + bw, by + r); c.lineTo(bx + bw, by + bh - r); c.quadraticCurveTo(bx + bw, by + bh, bx + bw - r, by + bh); c.lineTo(bx + bw * 0.42, by + bh); c.lineTo(bx + bw * 0.24, by + bh + s * 0.20); c.lineTo(bx + bw * 0.28, by + bh); c.lineTo(bx + r, by + bh); c.quadraticCurveTo(bx, by + bh, bx, by + bh - r); c.lineTo(bx, by + r); c.quadraticCurveTo(bx, by, bx + r, by); c.closePath(); c.stroke();
      var cy = by + bh / 2;
      [0.30, 0.50, 0.70].forEach(function(t) { c.beginPath(); c.arc(bx + bw * t, cy, s * 0.048, 0, Math.PI * 2); c.fill(); });
      c.restore();
    }
    function drawHeart(c, x, y, s, color) {
      var cx = x + s / 2;
      c.save(); c.strokeStyle = color; c.lineWidth = 1.5; c.lineJoin = 'round';
      c.beginPath(); c.moveTo(cx, y + s * 0.92); c.bezierCurveTo(cx - s * 0.58, y + s * 0.64, cx - s * 0.58, y + s * 0.02, cx, y + s * 0.28); c.bezierCurveTo(cx + s * 0.58, y + s * 0.02, cx + s * 0.58, y + s * 0.64, cx, y + s * 0.92); c.closePath(); c.stroke();
      c.restore();
    }

    /* 加载图片，尝试绕过缓存获取 CORS 图片 */
    function loadImageCorsSafe(src) {
      if (!src || /^(data:|blob:)/i.test(src)) return Promise.resolve(src);
      return new Promise(function (resolve) {
        var img = new Image();
        img.crossOrigin = 'anonymous';
        var cacheBustUrl = src + (src.indexOf('?') > -1 ? '&' : '?') + 'snowi_canvas_t=' + Date.now();
        
        var timer = setTimeout(function () { resolve(null); }, 6000);
        img.onload = function () { clearTimeout(timer); resolve(img); };
        img.onerror = function () { clearTimeout(timer); resolve(null); };
        img.src = cacheBustUrl;
      });
    }

    /* ================= 核心绘图逻辑 ================= */
    async function drawCardToCanvas(wrapper, siteTitle, addLog) {
      var CARD_W = 640;
      var PAD = 32;
      var CONTENT_W = CARD_W - PAD * 2;
      var SCALE = 2; // 高分辨率

      var dark = isDark();
      var colorBg = dark ? '#1e1e1e' : '#ffffff';
      var colorTitle = dark ? '#f0f0f0' : '#1a1a1a';
      var colorText = dark ? '#d4d4d4' : '#2f3238';
      var colorSub = dark ? '#999999' : '#9aa0a8';

      addLog('INFO', '正在提取卡片内容...');

      // 1. 提取 DOM 数据
      var data = {
        dateNum: '',
        dateWeek: '',
        dateTime: '',
        authorName: '',
        avatarSrc: '',
        content: '',
        images: []
      };

      // 尝试提取日期区块 (基于 Snowi 的 HTML 结构)
      var dateNumEl = wrapper.querySelector('.date-num, .day, h2, .big-date');
      if (dateNumEl && dateNumEl.textContent.trim().match(/^\d+$/)) {
        data.dateNum = dateNumEl.textContent.trim();
        var dateWeekEl = dateNumEl.nextElementSibling || dateNumEl.parentElement.querySelector('.week, span');
        if (dateWeekEl) data.dateWeek = dateWeekEl.textContent.trim();
      }
      
      var timeEl = wrapper.querySelector('.date-time, .post-time, .time');
      if (timeEl) data.dateTime = timeEl.innerText.replace(/\n/g, ' ').trim();

      // 提取作者
      var authorEl = wrapper.querySelector('.author-name, .post-author, .username, .nickname, h3');
      if (authorEl) data.authorName = authorEl.textContent.trim();

      // 提取图片
      var allImgs = Array.prototype.slice.call(wrapper.querySelectorAll('img'));
      if (allImgs.length > 0) {
        data.avatarSrc = allImgs[0].getAttribute('src');
        for (var i = 1; i < allImgs.length; i++) {
          var src = allImgs[i].getAttribute('src');
          if (src && !src.startsWith('data:image/svg')) data.images.push(src);
        }
      }

      // 提取正文
      var contentEl = wrapper.querySelector('.post-content, .post-text, .content, .text, p');
      if (contentEl) data.content = contentEl.innerText.trim();
      if (!data.content) {
        // 退而求其次，取最长的文本块
        var textNodes = Array.prototype.slice.call(wrapper.querySelectorAll('div, p, span'));
        var longest = textNodes.map(function(el) { return el.innerText.trim(); }).sort(function(a, b) { return b.length - a.length; })[0];
        data.content = longest || '';
      }

      // 2. 加载图片 (头像和配图)
      addLog('INFO', '正在拉取图片资源...');
      var loadedImgs = await Promise.all(data.images.map(function(src) {
        return loadImageCorsSafe(src).then(function(img) {
          if (!img) addLog('WARN', '图片跨域失败: ' + src.slice(0, 30) + '...');
          return img;
        });
      }));
      loadedImgs = loadedImgs.filter(Boolean); // 剔除失败的

      var avatarImg = null;
      if (data.avatarSrc) {
        avatarImg = await loadImageCorsSafe(data.avatarSrc);
        if (!avatarImg) addLog('WARN', '头像跨域失败');
      }

      addLog('INFO', '开始计算布局...');

      // 3. 计算高度
      var measureCtx = document.createElement('canvas').getContext('2d');
      
      // 头部高度
      var HEADER_H = 120;
      
      // 正文高度
      var BODY_SIZE = 20;
      var LINE_H = 32;
      measureCtx.font = BODY_SIZE + 'px ' + FONT_STACK;
      var bodyLines = wrapText(measureCtx, data.content, CONTENT_W);
      var bodyH = bodyLines.length * LINE_H + 20;

      // 图片网格区域
      var imgAreaH = 0;
      var imgRects = [];
      var gap = 12;
      var numImgs = loadedImgs.length;
      if (numImgs === 1) {
        var nw = loadedImgs[0].naturalWidth || 1;
        var nh = loadedImgs[0].naturalHeight || 1;
        var h = Math.round(CONTENT_W * nh / nw);
        h = Math.min(h, 800);
        imgRects.push({ x: PAD, y: 0, w: CONTENT_W, h: h, img: loadedImgs[0] });
        imgAreaH = h + 20;
      } else if (numImgs === 2) {
        var w = (CONTENT_W - gap) / 2;
        imgRects.push({ x: PAD, y: 0, w: w, h: w, img: loadedImgs[0] });
        imgRects.push({ x: PAD + w + gap, y: 0, w: w, h: w, img: loadedImgs[1] });
        imgAreaH = w + 20;
      } else if (numImgs === 3) {
        var w = (CONTENT_W - gap * 2) / 3;
        imgRects.push({ x: PAD, y: 0, w: w, h: w, img: loadedImgs[0] });
        imgRects.push({ x: PAD + w + gap, y: 0, w: w, h: w, img: loadedImgs[1] });
        imgRects.push({ x: PAD + w + gap * 2, y: 0, w: w, h: w, img: loadedImgs[2] });
        imgAreaH = w + 20;
      } else if (numImgs >= 4) {
        var cols = 3;
        var w = (CONTENT_W - gap * (cols - 1)) / cols;
        var rows = Math.ceil(numImgs / cols);
        for (var i = 0; i < numImgs; i++) {
          var r = Math.floor(i / cols);
          var c = i % cols;
          imgRects.push({ x: PAD + c * (w + gap), y: r * (w + gap), w: w, h: w, img: loadedImgs[i] });
        }
        imgAreaH = rows * w + (rows - 1) * gap + 20;
      }

      // 底部互动栏
      var FOOTER_H = 80;

      // 水印
      var WATERMARK_H = 60;

      var totalH = HEADER_H + bodyH + imgAreaH + FOOTER_H + WATERMARK_H + PAD;

      // 4. 正式绘制
      var canvas = document.createElement('canvas');
      canvas.width = CARD_W * SCALE;
      canvas.height = totalH * SCALE;
      var ctx = canvas.getContext('2d');
      ctx.scale(SCALE, SCALE);

      // 背景
      ctx.fillStyle = colorBg;
      ctx.fillRect(0, 0, CARD_W, totalH);

      var currentY = PAD;

      /* --- 头部 --- */
      // 左侧：大日期 + 星期
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      
      var textX = PAD;
      if (data.dateNum) {
        ctx.fillStyle = colorTitle;
        ctx.font = 'bold 28px ' + FONT_STACK;
        ctx.fillText(data.dateNum, textX, currentY + 24);
        var numWidth = ctx.measureText(data.dateNum).width;
        
        if (data.dateWeek) {
          ctx.fillStyle = colorTitle;
          ctx.font = 'bold 16px ' + FONT_STACK;
          ctx.fillText(data.dateWeek, textX + numWidth + 8, currentY + 22);
        }
      }
      
      if (data.dateTime) {
        ctx.fillStyle = colorSub;
        ctx.font = '14px ' + FONT_STACK;
        ctx.fillText(data.dateTime, textX, currentY + 50);
      }

      // 右侧：作者 + 头像
      var AVATAR = 44;
      if (avatarImg) {
        var ax = CARD_W - PAD - AVATAR;
        var ay = currentY;
        ctx.save();
        ctx.beginPath();
        ctx.arc(ax + AVATAR/2, ay + AVATAR/2, AVATAR/2, 0, Math.PI * 2);
        ctx.clip();
        ctx.drawImage(avatarImg, ax, ay, AVATAR, AVATAR);
        ctx.restore();
      }
      
      if (data.authorName) {
        ctx.fillStyle = colorSub;
        ctx.font = '600 16px ' + FONT_STACK;
        ctx.textAlign = 'right';
        ctx.fillText(data.authorName, CARD_W - PAD - AVATAR - 12, currentY + 28);
      }

      currentY += HEADER_H;

      /* --- 正文 --- */
      ctx.fillStyle = colorText;
      ctx.font = BODY_SIZE + 'px ' + FONT_STACK;
      ctx.textAlign = 'left';
      for (var i = 0; i < bodyLines.length; i++) {
        ctx.fillText(bodyLines[i], PAD, currentY + i * LINE_H + 16);
      }
      currentY += bodyH;

      /* --- 图片网格 --- */
      for (var i = 0; i < imgRects.length; i++) {
        var r = imgRects[i];
        var drawY = currentY + r.y;
        ctx.save();
        roundRectPath(ctx, r.x, drawY, r.w, r.h, 12);
        ctx.clip();
        
        // 居中裁剪
        var nw = r.img.naturalWidth, nh = r.img.naturalHeight;
        var dstRatio = r.w / r.h, srcRatio = nw / nh;
        var sx = 0, sy = 0, sw = nw, sh = nh;
        if (srcRatio > dstRatio) { sw = nh * dstRatio; sx = (nw - sw)/2; }
        else if (srcRatio < dstRatio) { sh = nw / dstRatio; sy = (nh - sh)/2; }
        
        ctx.drawImage(r.img, sx, sy, sw, sh, r.x, drawY, r.w, r.h);
        ctx.restore();
      }
      currentY += imgAreaH;

      /* --- 互动栏 (装饰) --- */
      var iconSize = 20;
      var itemW = CONTENT_W / 3;
      ctx.fillStyle = colorSub;
      ctx.font = '14px ' + FONT_STACK;
      ctx.textAlign = 'left';
      
      var icons = [drawComment, drawHeart, drawRepost];
      var vals = ['46', '1024', '128'];
      
      for (var i = 0; i < 3; i++) {
        var ix = PAD + i * itemW;
        icons[i](ctx, ix, currentY, iconSize, colorSub);
        ctx.fillText(vals[i], ix + iconSize + 8, currentY + 15);
      }
      currentY += FOOTER_H;

      /* --- 底部水印和日志 --- */
      ctx.fillStyle = colorSub;
      ctx.font = '14px ' + FONT_STACK;
      ctx.textAlign = 'left';
      ctx.fillText('❄️ ' + (siteTitle || 'Snowi'), PAD, currentY);

      // 把日志画进去
      var logStr = addLog.logs.slice(-5).join('\n');
      if (logStr) {
        ctx.font = '12px ui-monospace, monospace';
        ctx.fillStyle = dark ? 'rgba(255,255,255,0.3)' : 'rgba(0,0,0,0.3)';
        var logLines = wrapText(ctx, logStr, CONTENT_W);
        for (var i = 0; i < logLines.length; i++) {
           ctx.fillText(logLines[i], PAD, currentY + 22 + i * 16);
        }
      }

      return canvas;
    }

    /* ---------- 下载（Blob） ---------- */
    async function triggerDownload(canvas, filename) {
      return new Promise(function(resolve, reject) {
        try {
          canvas.toBlob(function(blob) {
            if (!blob) { reject(new Error('Canvas 转 Blob 失败(污染)')); return; }
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.download = filename;
            link.href = url;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(function() { URL.revokeObjectURL(url); resolve(); }, 1000);
          }, 'image/png');
        } catch(e) { reject(e); }
      });
    }

    /* ---------- 分享主流程 ---------- */
    async function handleShare(btn) {
      if (btn.disabled || btn.dataset.snowiBusy === '1') return;

      var wrapper = btn.closest('.card-wrapper');
      if (!wrapper) return;

      var overlay = showCaptureOverlay();
      var logLines = [];
      var finalError = null;
      var captureLog = function(level, msg) {
        var line = '[' + stamp() + '] [' + level + '] ' + msg;
        logLines.push(line);
        try { console.log('[snowi] ' + line); } catch (e) {}
      };
      // 绑定 logs 供绘图函数使用
      captureLog.logs = logLines;

      btn.disabled = true;
      btn.dataset.snowiBusy = '1';

      try {
        captureLog('INFO', '开始提取原生 Canvas...');
        var canvas = await drawCardToCanvas(wrapper, siteTitle, captureLog);
        
        var type = getPageType();
        var prefix = type === 'index' ? 'Snowi-' : 'Snowi-' + type.charAt(0).toUpperCase() + type.slice(1) + '-';
        var filename = prefix + Date.now() + '.png';
        
        captureLog('INFO', '导出图片...');
        await triggerDownload(canvas, filename);
        captureLog('OK', '下载已触发');
      } catch (err) {
        finalError = err;
        var msg = err && err.message ? err.message : String(err);
        captureLog('ERR', '异常: ' + msg);
      } finally {
        overlay.remove();
        btn.disabled = false;
        delete btn.dataset.snowiBusy;

        if (finalError) {
          var lastLines = logLines.slice(-6).join('\n');
          var errMsg = finalError.message || String(finalError);
          alert('截图生成失败：' + errMsg + '\n\n最近日志:\n' + lastLines);
        }
      }
    }

    /* ================= 事件委托（Swup 切页后依然有效） ================= */

    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var themeBtn = target.closest('#snowiThemeToggle, #themeToggle');
      if (themeBtn) {
        e.preventDefault();
        applyTheme(!isDark(), true);
        return;
      }

      var searchBtn = target.closest('#snowiSearchToggle');
      if (searchBtn) {
        e.preventDefault();
        var form = document.getElementById('snowiSearch');
        if (!form) return;
        var open = form.classList.toggle('open');
        searchBtn.classList.toggle('active', open);
        if (open) {
          var input = form.querySelector('input');
          if (input) input.focus();
        }
        return;
      }

      var shareBtn = target.closest('.share-btn');
      if (shareBtn) {
        e.preventDefault();
        handleShare(shareBtn);
        return;
      }

      /* 卡片空白 / 文字 / 日期区域也可以进入文章详情 */
      var card = target.closest('.post-card');
      if (!card) return;
      var cardOverlay = card.querySelector('.card-overlay');
      if (!cardOverlay) return;
      if (target.closest('a, button, input, textarea, select, label, form, video, audio, mood-player, .post-actions, .post-media, .post-media-grid, .live-photo, .post-category, .post-tags, .lightbox-img')) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      var selection = '';
      try {
        selection = String(window.getSelection ? window.getSelection() : '');
      } catch (err) {}
      if (selection) return;

      e.preventDefault();
      cardOverlay.click();
    });

    /* ================= Swup / Astro 切页 ================= */

    document.addEventListener('astro:after-swap', function () {
      var main = document.getElementById('main');
      if (!main) return;
      main.classList.remove('snowi-page-in');
      void main.offsetWidth;
      main.classList.add('snowi-page-in');
    });

    document.addEventListener('astro:page-load', function () {
      syncThemeUI();
      ensureMoodPlayer();
      try {
        document.dispatchEvent(new Event('page:view'));
      } catch (e) {}
      try {
        document.dispatchEvent(new Event('swup:page:view'));
      } catch (e) {}
    });
  })();
</script>
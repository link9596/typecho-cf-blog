---
/**
 * Snowi theme — shared client behaviour
 *
 * 集中处理主题切换、搜索展开、分享截图与评论回复。
 * 所有交互都使用 document 级事件委托，因此 Swup 替换
 * #header / #main / #secondary / #footer 后无需重新绑定。
 */
interface Props {
  siteTitle?: string;
}

const { siteTitle = '' } = Astro.props;
---

<script is:inline define:vars={{ siteTitle }}>
  (function () {
    'use strict';

    if (window.__snowiThemeInit) return;
    window.__snowiThemeInit = true;

    var root = document.documentElement;
    var STORAGE_KEY = 'snowi-theme';
    var LEGACY_KEY = 'theme';

    /* ================= 主题切换 ================= */

    function getStoredTheme() {
      try {
        return localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_KEY);
      } catch (e) {
        return null;
      }
    }

    function setStoredTheme(value) {
      try {
        localStorage.setItem(STORAGE_KEY, value);
        localStorage.removeItem(LEGACY_KEY);
      } catch (e) {}
    }

    function isDark() {
      return root.classList.contains('snowi-dark');
    }

    function syncThemeUI() {
      var dark = isDark();
      var icons = document.querySelectorAll('#snowiThemeIcon, #themeIcon');
      for (var i = 0; i < icons.length; i++) {
        icons[i].textContent = dark ? '☀️' : '🌙';
      }
      var texts = document.querySelectorAll('#snowiThemeText, #themeText');
      for (var j = 0; j < texts.length; j++) {
        texts[j].textContent = dark ? '切换至亮色模式' : '切换至暗色模式';
      }
      var buttons = document.querySelectorAll('#snowiThemeToggle, #themeToggle');
      for (var k = 0; k < buttons.length; k++) {
        buttons[k].setAttribute('aria-pressed', dark ? 'true' : 'false');
      }
    }

    function applyTheme(dark, persist) {
      if (dark) root.classList.add('snowi-dark');
      else root.classList.remove('snowi-dark');
      if (persist) setStoredTheme(dark ? 'dark' : 'light');
      syncThemeUI();
    }

    var storedTheme = getStoredTheme();
    if (storedTheme === 'dark') root.classList.add('snowi-dark');
    else if (storedTheme === 'light') root.classList.remove('snowi-dark');
    syncThemeUI();

    /* ================= 评论回复 ================= */

    window.TypechoComment = {
      dom: function (id) {
        return document.getElementById(id);
      },
      reply: function (commentId, coid) {
        var comment = this.dom(commentId);
        var respond = this.dom('respond');
        var cancelLink = this.dom('cancel-comment-reply-link');
        var parentInput = this.dom('comment-parent');
        if (!comment || !respond || !parentInput) return true;
        parentInput.value = coid;
        comment.appendChild(respond);
        if (cancelLink) cancelLink.style.display = '';
        try {
          var textarea = this.dom('textarea');
          if (textarea) textarea.focus();
        } catch (e) {}
        return false;
      },
      cancelReply: function () {
        var respond = this.dom('respond');
        var cancelLink = this.dom('cancel-comment-reply-link');
        var parentInput = this.dom('comment-parent');
        var comments = this.dom('comments');
        if (!respond || !comments || !parentInput) return false;
        parentInput.value = '0';
        if (cancelLink) cancelLink.style.display = 'none';
        comments.appendChild(respond);
        return false;
      }
    };

    /* ================= 播放器脚本（按需加载，兼容 Swup） ================= */

    function ensureMoodPlayer() {
      try {
        if (typeof customElements === 'undefined' || customElements.get('mood-player')) return;
      } catch (e) {
        return;
      }
      if (!document.querySelector('mood-player')) return;
      if (window.__snowiMoodPlayerLoading) return;
      window.__snowiMoodPlayerLoading = true;
      var script = document.createElement('script');
      script.src = '/js/mood-player.min.js';
      script.async = true;
      script.onload = function () {
        window.__snowiMoodPlayerLoading = false;
      };
      script.onerror = function () {
        window.__snowiMoodPlayerLoading = false;
      };
      document.head.appendChild(script);
    }

    ensureMoodPlayer();

    /* ================= 分享截图（html-to-image） ================= */

    var SNAPSHOT_SRC = '/js/screenshot.js';
    var TRANSPARENT_PIXEL =
      'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
    var IS_SAFARI =
      /^((?!chrome|android).)*safari/i.test(navigator.userAgent) ||
      /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    function pad2(n) {
      return n < 10 ? '0' + n : '' + n;
    }

    function stamp() {
      var d = new Date();
      return pad2(d.getMinutes()) + ':' + pad2(d.getSeconds()) + '.' +
        pad2(Math.floor(d.getMilliseconds() / 100));
    }

    function ensureHtmlToImage() {
      if (window.htmlToImage && typeof window.htmlToImage.toPng === 'function') {
        return Promise.resolve(window.htmlToImage);
      }
      if (window.__snowiH2I) return window.__snowiH2I;
      window.__snowiH2I = new Promise(function (resolve, reject) {
        var script = document.createElement('script');
        script.src = SNAPSHOT_SRC;
        script.async = true;
        script.onload = function () {
          if (window.htmlToImage && typeof window.htmlToImage.toPng === 'function') {
            resolve(window.htmlToImage);
          } else {
            reject(new Error('html-to-image missing'));
          }
        };
        script.onerror = function () {
          reject(new Error('script load failed: ' + SNAPSHOT_SRC));
        };
        document.head.appendChild(script);
      });
      return window.__snowiH2I;
    }

    function getPageType() {
      if (document.querySelector('.post-detail-card')) return 'post';
      if (document.querySelector('.page-detail-card')) return 'page';
      if (document.querySelector('.archive-header-card')) return 'archive';
      if (document.querySelector('.notfound-card')) return 'notfound';
      return 'index';
    }

    function showCaptureOverlay() {
      var overlay = document.createElement('div');
      overlay.className = 'snowi-capture-overlay';
      overlay.innerHTML = '<span class="snowi-capture-spinner"></span><span>生成图片中…</span>';
      document.body.appendChild(overlay);
      return overlay;
    }

    function waitFonts(timeout) {
      if (!document.fonts || !document.fonts.ready) return Promise.resolve();
      return Promise.race([
        document.fonts.ready,
        new Promise(function (resolve) {
          setTimeout(resolve, timeout || 2500);
        }),
      ]);
    }

    /* ---------- 图片预处理：转 Base64 + 时间戳破缓存 ---------- */
    async function prepareCardImages(wrapper, addLog) {
      var imgs = Array.prototype.slice.call(wrapper.querySelectorAll('img'));
      var restores = [];
      var tasks = [];
      var total = 0;
      var okCount = 0;

      imgs.forEach(function (img) {
        var src = img.getAttribute('src') || '';
        if (!src || /^(data:|blob:)/i.test(src)) return;
        total++;
      });

      if (total === 0) {
        addLog('INFO', '无外部图片，跳过预处理');
        return function restore() {};
      }

      addLog('INFO', '图片预处理开始 (共 ' + total + ' 张)');

      var idx = 0;
      imgs.forEach(function (img) {
        var src = img.getAttribute('src') || '';
        if (!src || /^(data:|blob:)/i.test(src)) return;

        idx++;
        var myIdx = idx;
        var startT = performance.now();

        var original = {
          img: img,
          src: src,
          srcset: img.getAttribute('srcset'),
          sizes: img.getAttribute('sizes'),
          crossorigin: img.getAttribute('crossorigin'),
          loading: img.getAttribute('loading'),
        };
        restores.push(original);

        img.removeAttribute('loading');
        img.removeAttribute('srcset');
        img.removeAttribute('sizes');

        tasks.push(new Promise(function (resolve) {
          var image = new Image();
          image.crossOrigin = 'anonymous';

          var cacheBustUrl =
            src + (src.indexOf('?') > -1 ? '&' : '?') + 'snowi_t=' + Date.now();

          var timer = setTimeout(function () {
            addLog('WARN', '图片 ' + myIdx + '/' + total + ' 超时 5s');
            resolve();
          }, 5000);

          image.onload = function () {
            clearTimeout(timer);
            var cost = Math.round(performance.now() - startT);
            try {
              var canvas = document.createElement('canvas');
              canvas.width = image.naturalWidth || image.width || 1;
              canvas.height = image.naturalHeight || image.height || 1;
              canvas.getContext('2d').drawImage(image, 0, 0);
              var dataUrl = canvas.toDataURL('image/png');
              img.setAttribute('src', dataUrl);
              okCount++;
              addLog(
                'OK',
                '图 ' + myIdx + '/' + total + ' 成功 (' + cost + 'ms, ' +
                Math.round(dataUrl.length / 1024) + 'KB)'
              );
            } catch (e) {
              addLog(
                'ERR',
                '图 ' + myIdx + '/' + total + ' 转 Base64 失败: ' +
                (e && e.message ? e.message : e)
              );
            }
            resolve();
          };

          image.onerror = function () {
            clearTimeout(timer);
            addLog(
              'WARN',
              '图 ' + myIdx + '/' + total + ' 跨域失败 (' +
              Math.round(performance.now() - startT) + 'ms)'
            );
            resolve();
          };

          image.src = cacheBustUrl;
        }));
      });

      await Promise.all(tasks);
      addLog('INFO', '图片预处理完成: ' + okCount + '/' + total + ' 成功');

      return function restore() {
        restores.forEach(function (item) {
          item.img.setAttribute('src', item.src);
          if (item.srcset) item.img.setAttribute('srcset', item.srcset);
          else item.img.removeAttribute('srcset');
          if (item.sizes) item.img.setAttribute('sizes', item.sizes);
          else item.img.removeAttribute('sizes');
          if (item.crossorigin !== null) item.img.setAttribute('crossorigin', item.crossorigin);
          else item.img.removeAttribute('crossorigin');
          if (item.loading) item.img.setAttribute('loading', item.loading);
          else item.img.removeAttribute('loading');
        });
      };
    }

    /* ---------- Safari 专用：toCanvas + 手动覆绘图片兜底 ---------- */
    async function captureWithOverdraw(wrapper, options, addLog) {
      addLog('INFO', 'toCanvas 开始 (ratio=' + (options.pixelRatio || 1) + ')');
      var canvas = await window.htmlToImage.toCanvas(wrapper, options);
      addLog('OK', 'toCanvas 完成 ' + canvas.width + 'x' + canvas.height);

      var ctx = canvas.getContext('2d');
      var wrapperRect = wrapper.getBoundingClientRect();
      var scale = options.pixelRatio || 1;
      var imgs = wrapper.querySelectorAll('img');
      var drawn = 0;

      for (var i = 0; i < imgs.length; i++) {
        var img = imgs[i];
        if (!img.complete || !img.naturalWidth) continue;
        var rect = img.getBoundingClientRect();
        if (!rect.width || !rect.height) continue;
        try {
          ctx.drawImage(
            img,
            (rect.left - wrapperRect.left) * scale,
            (rect.top - wrapperRect.top) * scale,
            rect.width * scale,
            rect.height * scale
          );
          drawn++;
        } catch (e) {
          addLog('WARN', '覆绘失败: ' + (e && e.message ? e.message : e));
        }
      }
      addLog('INFO', '覆绘 ' + drawn + '/' + imgs.length + ' 张');
      var out = canvas.toDataURL('image/png');
      addLog('OK', 'canvas toDataURL len=' + out.length);
      return out;
    }

    /* ---------- 下载（Blob） ---------- */
    async function triggerDownload(dataUrlOrBlob, filename) {
      var blob;
      if (typeof Blob !== 'undefined' && dataUrlOrBlob instanceof Blob) {
        blob = dataUrlOrBlob;
      } else if (typeof dataUrlOrBlob === 'string' && dataUrlOrBlob.indexOf('data:') === 0) {
        var parts = dataUrlOrBlob.split(',');
        var mimeMatch = parts[0].match(/:(.*?);/);
        var mime = mimeMatch ? mimeMatch[1] : 'image/png';
        var binary = atob(parts[1]);
        var array = new Uint8Array(binary.length);
        for (var i = 0; i < binary.length; i++) array[i] = binary.charCodeAt(i);
        blob = new Blob([array], { type: mime });
      } else {
        blob = dataUrlOrBlob;
      }

      var link = document.createElement('a');
      link.download = filename;
      var blobUrl = URL.createObjectURL(blob);
      link.href = blobUrl;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      setTimeout(function () {
        URL.revokeObjectURL(blobUrl);
      }, 1000);
    }

    /* ---------- 分享主流程 ---------- */
    async function handleShare(btn) {
      if (btn.disabled || btn.dataset.snowiBusy === '1') return;

      var wrapper = btn.closest('.card-wrapper');
      var pageEl = document.querySelector('.snowi-page');
      if (!wrapper || !pageEl) return;

      var overlay = showCaptureOverlay();
      var logEl = null;
      var logLines = [];
      var MAX_LOG_LINES = 25;
      var restoreImages = function () {};
      var previousPadding = wrapper.style.padding;
      var previousOverflow = wrapper.style.overflow;
      var previousVars = {};
      var cssVars = [
        '--bg-color', '--card-bg', '--text-main', '--text-sub',
        '--icon-color', '--btn-hover', '--media-bg', '--footer-bg',
        '--watermark-color',
      ];

      function addLog(level, msg) {
        var line = '[' + stamp() + '] [' + level + '] ' + msg;
        logLines.push(line);
        if (logLines.length > MAX_LOG_LINES) logLines.shift();
        if (logEl) logEl.textContent = logLines.join('\n');
        try {
          console.log('[snowi] ' + line);
        } catch (e) {}
      }

      btn.disabled = true;
      btn.dataset.snowiBusy = '1';

      try {
        /* 创建内嵌日志元素（会出现在截图里） */
        logEl = document.createElement('pre');
        logEl.className = 'snowi-capture-log';
        logEl.style.cssText = [
          'margin:16px 0 0',
          'padding:10px 12px',
          'background:#0f1115',
          'color:#c8c8c8',
          'font:11px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace',
          'white-space:pre-wrap',
          'word-break:break-all',
          'border-radius:8px',
          'max-height:430px',
          'overflow:hidden',
          'text-align:left',
          'box-sizing:border-box',
          'width:100%',
          'border:1px solid #2a2d33',
        ].join(';');
        wrapper.appendChild(logEl);

        /* 让日志不被卡片 overflow:hidden 裁掉 */
        wrapper.style.overflow = 'visible';
        wrapper.style.padding = '16px 12px 20px';

        var pageStyle = window.getComputedStyle(pageEl);
        var currentBg = pageStyle.getPropertyValue('--bg-color').trim() || '#f2f3f5';
        cssVars.forEach(function (name) {
          previousVars[name] = wrapper.style.getPropertyValue(name);
          wrapper.style.setProperty(name, pageStyle.getPropertyValue(name).trim());
        });

        var watermark = document.createElement('div');
        watermark.className = 'snowi-watermark';
        watermark.textContent = '❄️ ' + siteTitle + '.';
        wrapper.appendChild(watermark);

        addLog('INFO', '=== 截图开始 ===');
        addLog('INFO', '环境: ' + (IS_SAFARI ? 'Safari' : 'Chromium') + ' DPR=' + (window.devicePixelRatio || 1));

        if (!(window.htmlToImage && typeof window.htmlToImage.toPng === 'function')) {
          addLog('INFO', '加载 ' + SNAPSHOT_SRC);
          try {
            await ensureHtmlToImage();
            addLog('OK', 'htmlToImage 加载完成');
          } catch (e) {
            addLog('ERR', 'htmlToImage 加载失败: ' + (e && e.message ? e.message : e));
            alert('截图组件加载失败（/js/screenshot.js）');
            return;
          }
        } else {
          addLog('OK', 'htmlToImage 已就绪');
        }

        var type = getPageType();
        var highResScale = IS_SAFARI
          ? Math.min(window.devicePixelRatio || 1, 1.5)
          : (window.devicePixelRatio || 1) * 1.2;
        addLog('INFO', '页面=' + type + ' ratio=' + highResScale);

        addLog('INFO', '等待字体...');
        var ft = performance.now();
        await waitFonts(2500);
        addLog('OK', '字体就绪 (' + Math.round(performance.now() - ft) + 'ms)');

        var it = performance.now();
        restoreImages = await prepareCardImages(wrapper, addLog);
        addLog('OK', '图片预处理结束 (' + Math.round(performance.now() - it) + 'ms)');

        var captureOptions = {
          backgroundColor: currentBg,
          pixelRatio: highResScale,
          cacheBust: false,
          skipFonts: true,
          imagePlaceholder: TRANSPARENT_PIXEL,
          filter: function (node) {
            var tag = node && node.tagName;
            return tag !== 'MOOD-PLAYER' && tag !== 'VIDEO' && tag !== 'IFRAME' &&
              tag !== 'OBJECT' && tag !== 'EMBED' && tag !== 'CANVAS' && tag !== 'AUDIO';
          },
        };

        if (IS_SAFARI) {
          addLog('INFO', 'Safari 预热 (ratio=0.1)...');
          try {
            await window.htmlToImage.toPng(wrapper, {
              pixelRatio: 0.1,
              skipFonts: true,
              cacheBust: false,
            });
            addLog('OK', '预热完成');
          } catch (e) {
            addLog('WARN', '预热失败: ' + (e && e.message ? e.message : e));
          }
        }

        var dataUrl;
        var t0 = performance.now();
        addLog('INFO', 'toPng 开始...');
        try {
          dataUrl = await window.htmlToImage.toPng(wrapper, captureOptions);
          addLog(
            'OK',
            'toPng 成功 (' + Math.round(performance.now() - t0) + 'ms, len=' +
            (dataUrl ? dataUrl.length : 0) + ')'
          );
        } catch (firstErr) {
          addLog('ERR', 'toPng 失败: ' + (firstErr && firstErr.message ? firstErr.message : firstErr));
          addLog('INFO', '回退 toPng (ratio=1)...');
          var t1 = performance.now();
          dataUrl = await window.htmlToImage.toPng(wrapper, {
            backgroundColor: currentBg,
            pixelRatio: 1,
            cacheBust: false,
            skipFonts: true,
            imagePlaceholder: TRANSPARENT_PIXEL,
            filter: function (node) {
              var tag = node.tagName;
              var isHeavy = node.nodeType === 1 && node.classList &&
                (node.classList.contains('live-photo-badge') ||
                  node.classList.contains('player-placeholder'));
              return !isHeavy && tag !== 'MOOD-PLAYER' && tag !== 'VIDEO' &&
                tag !== 'IFRAME' && tag !== 'OBJECT' && tag !== 'EMBED' &&
                tag !== 'CANVAS' && tag !== 'AUDIO';
            },
          });
          addLog(
            'OK',
            '回退成功 (' + Math.round(performance.now() - t1) + 'ms, len=' +
            (dataUrl ? dataUrl.length : 0) + ')'
          );
        }

        if (IS_SAFARI && (!dataUrl || dataUrl.length < 2000)) {
          addLog('WARN', '结果可疑 len=' + (dataUrl ? dataUrl.length : 0) + '，启用覆绘兜底');
          var t2 = performance.now();
          dataUrl = await captureWithOverdraw(wrapper, captureOptions, addLog);
          addLog('OK', '覆绘成功 (' + Math.round(performance.now() - t2) + 'ms)');
        }

        if (!dataUrl || dataUrl.indexOf('data:image') !== 0) {
          throw new Error('empty capture');
        }

        var prefix =
          type === 'index'
            ? 'Snowi-'
            : 'Snowi-' + type.charAt(0).toUpperCase() + type.slice(1) + '-';
        var filename = prefix + Date.now() + '.png';
        addLog('INFO', '下载: ' + filename);
        await triggerDownload(dataUrl, filename);
        addLog('OK', '下载已触发');
      } catch (err) {
        var msg = err && err.message ? err.message : String(err);
        addLog('ERR', '流程异常: ' + msg);
        if (err && err.stack) {
          addLog('ERR', 'stack: ' + String(err.stack).split('\n').slice(0, 2).join(' | '));
        }
        alert('截图生成失败：' + msg + '\n\n如果方便，请截图页面或重新点分享（图片底部会含日志）。');
      } finally {
        restoreImages();
        if (logEl && logEl.parentNode) logEl.parentNode.removeChild(logEl);
        var watermark = wrapper.querySelector('.snowi-watermark');
        if (watermark && watermark.parentNode) watermark.parentNode.removeChild(watermark);
        overlay.remove();
        wrapper.style.padding = previousPadding;
        wrapper.style.overflow = previousOverflow;
        cssVars.forEach(function (name) {
          if (previousVars[name]) wrapper.style.setProperty(name, previousVars[name]);
          else wrapper.style.removeProperty(name);
        });
        btn.disabled = false;
        delete btn.dataset.snowiBusy;
      }
    }

    /* ================= 事件委托（Swup 切页后依然有效） ================= */

    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var themeBtn = target.closest('#snowiThemeToggle, #themeToggle');
      if (themeBtn) {
        e.preventDefault();
        applyTheme(!isDark(), true);
        return;
      }

      var searchBtn = target.closest('#snowiSearchToggle');
      if (searchBtn) {
        e.preventDefault();
        var form = document.getElementById('snowiSearch');
        if (!form) return;
        var open = form.classList.toggle('open');
        searchBtn.classList.toggle('active', open);
        if (open) {
          var input = form.querySelector('input');
          if (input) input.focus();
        }
        return;
      }

      var shareBtn = target.closest('.share-btn');
      if (shareBtn) {
        e.preventDefault();
        handleShare(shareBtn);
        return;
      }

      /* 卡片空白 / 文字 / 日期区域也可以进入文章详情 */
      var card = target.closest('.post-card');
      if (!card) return;
      var cardOverlay = card.querySelector('.card-overlay');
      if (!cardOverlay) return;
      if (target.closest('a, button, input, textarea, select, label, form, video, audio, mood-player, .post-actions, .post-media, .post-media-grid, .live-photo, .post-category, .post-tags, .lightbox-img')) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      var selection = '';
      try {
        selection = String(window.getSelection ? window.getSelection() : '');
      } catch (err) {}
      if (selection) return;

      e.preventDefault();
      cardOverlay.click();
    });

    /* ================= Swup / Astro 切页 ================= */

    document.addEventListener('astro:after-swap', function () {
      var main = document.getElementById('main');
      if (!main) return;
      main.classList.remove('snowi-page-in');
      void main.offsetWidth;
      main.classList.add('snowi-page-in');
    });

    document.addEventListener('astro:page-load', function () {
      syncThemeUI();
      ensureMoodPlayer();
      try {
        document.dispatchEvent(new Event('page:view'));
      } catch (e) {}
      try {
        document.dispatchEvent(new Event('swup:page:view'));
      } catch (e) {}
    });
  })();
</script>
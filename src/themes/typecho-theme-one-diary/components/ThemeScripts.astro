---
/**
 * Snowi theme — shared client behaviour
 *
 * 集中处理主题切换、搜索展开、分享截图与评论回复。
 * 所有交互都使用 document 级事件委托，因此 Swup 替换
 * #header / #main / #secondary / #footer 后无需重新绑定。
 */
interface Props {
  siteTitle?: string;
}

const { siteTitle = '' } = Astro.props;
---

<script is:inline define:vars={{ siteTitle }}>
  (function () {
    'use strict';

    if (window.__snowiThemeInit) return;
    window.__snowiThemeInit = true;

    var root = document.documentElement;
    var STORAGE_KEY = 'snowi-theme';
    var LEGACY_KEY = 'theme';

    /* ================= 主题切换 ================= */

    function getStoredTheme() {
      try {
        return localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_KEY);
      } catch (e) {
        return null;
      }
    }

    function setStoredTheme(value) {
      try {
        localStorage.setItem(STORAGE_KEY, value);
        localStorage.removeItem(LEGACY_KEY);
      } catch (e) {}
    }

    function isDark() {
      return root.classList.contains('snowi-dark');
    }

    function syncThemeUI() {
      var dark = isDark();
      var icons = document.querySelectorAll('#snowiThemeIcon, #themeIcon');
      for (var i = 0; i < icons.length; i++) {
        icons[i].textContent = dark ? '☀️' : '🌙';
      }
      var texts = document.querySelectorAll('#snowiThemeText, #themeText');
      for (var j = 0; j < texts.length; j++) {
        texts[j].textContent = dark ? '切换至亮色模式' : '切换至暗色模式';
      }
      var buttons = document.querySelectorAll('#snowiThemeToggle, #themeToggle');
      for (var k = 0; k < buttons.length; k++) {
        buttons[k].setAttribute('aria-pressed', dark ? 'true' : 'false');
      }
    }

    function applyTheme(dark, persist) {
      if (dark) root.classList.add('snowi-dark');
      else root.classList.remove('snowi-dark');
      if (persist) setStoredTheme(dark ? 'dark' : 'light');
      syncThemeUI();
    }

    var storedTheme = getStoredTheme();
    if (storedTheme === 'dark') root.classList.add('snowi-dark');
    else if (storedTheme === 'light') root.classList.remove('snowi-dark');
    syncThemeUI();

    /* ================= 评论回复 ================= */

    window.TypechoComment = {
      dom: function (id) {
        return document.getElementById(id);
      },
      reply: function (commentId, coid) {
        var comment = this.dom(commentId);
        var respond = this.dom('respond');
        var cancelLink = this.dom('cancel-comment-reply-link');
        var parentInput = this.dom('comment-parent');
        if (!comment || !respond || !parentInput) return true;
        parentInput.value = coid;
        comment.appendChild(respond);
        if (cancelLink) cancelLink.style.display = '';
        try {
          var textarea = this.dom('textarea');
          if (textarea) textarea.focus();
        } catch (e) {}
        return false;
      },
      cancelReply: function () {
        var respond = this.dom('respond');
        var cancelLink = this.dom('cancel-comment-reply-link');
        var parentInput = this.dom('comment-parent');
        var comments = this.dom('comments');
        if (!respond || !comments || !parentInput) return false;
        parentInput.value = '0';
        if (cancelLink) cancelLink.style.display = 'none';
        comments.appendChild(respond);
        return false;
      }
    };

    /* ================= 播放器脚本（按需加载，兼容 Swup） ================= */

    function ensureMoodPlayer() {
      try {
        if (typeof customElements === 'undefined' || customElements.get('mood-player')) return;
      } catch (e) {
        return;
      }
      if (!document.querySelector('mood-player')) return;
      if (window.__snowiMoodPlayerLoading) return;
      window.__snowiMoodPlayerLoading = true;
      var script = document.createElement('script');
      script.src = '/js/mood-player.min.js';
      script.async = true;
      script.onload = function () {
        window.__snowiMoodPlayerLoading = false;
      };
      script.onerror = function () {
        window.__snowiMoodPlayerLoading = false;
      };
      document.head.appendChild(script);
    }

    ensureMoodPlayer();

    /* ================= 分享截图（原生 Canvas 完美还原） ================= */

    var FONT_STACK = '"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Helvetica Neue",Arial,sans-serif';
    var IS_SAFARI = /^((?!chrome|android).)*safari/i.test(navigator.userAgent) || /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

    function pad2(n) { return n < 10 ? '0' + n : '' + n; }
    function stamp() {
      var d = new Date();
      return pad2(d.getMinutes()) + ':' + pad2(d.getSeconds()) + '.' + pad2(Math.floor(d.getMilliseconds() / 100));
    }

    function getPageType() {
      if (document.querySelector('.post-detail-card')) return 'post';
      if (document.querySelector('.page-detail-card')) return 'page';
      if (document.querySelector('.archive-header-card')) return 'archive';
      if (document.querySelector('.notfound-card')) return 'notfound';
      return 'index';
    }

    function showCaptureOverlay() {
      var overlay = document.createElement('div');
      overlay.className = 'snowi-capture-overlay';
      overlay.innerHTML = '<span class="snowi-capture-spinner"></span><span>生成图片中…</span>';
      document.body.appendChild(overlay);
      return overlay;
    }

    function roundRectPath(c, x, y, w, h, r) {
      r = Math.min(r, w / 2, h / 2);
      c.beginPath();
      c.moveTo(x + r, y);
      c.arcTo(x + w, y, x + w, y + h, r);
      c.arcTo(x + w, y + h, x, y + h, r);
      c.arcTo(x, y + h, x, y, r);
      c.arcTo(x, y, x + w, y, r);
      c.closePath();
    }

    function wrapText(c, text, maxWidth) {
      var lines = [];
      var chars = Array.from(text || '');
      var isWordChar = function(ch) { return /[A-Za-z0-9@#$%&*_+\-='"]/.test(ch); };
      var line = '', i = 0;
      while (i < chars.length) {
        var token = chars[i];
        if (isWordChar(token)) {
          var j = i + 1;
          while (j < chars.length && isWordChar(chars[j])) { token += chars[j]; j++; }
          i = j;
        } else { i++; }
        if (line === '') {
          if (token === ' ') continue;
          line = token; continue;
        }
        if (c.measureText(line + token).width > maxWidth) {
          lines.push(line);
          line = token === ' ' ? '' : token;
        } else { line += token; }
      }
      if (line !== '') lines.push(line);
      return lines.length ? lines : [''];
    }

    /* 加载图片，尝试绕过缓存获取 CORS 图片 */
    function loadImageCorsSafe(src) {
      if (!src || /^(data:|blob:)/i.test(src)) return Promise.resolve(src);
      return new Promise(function (resolve) {
        var img = new Image();
        img.crossOrigin = 'anonymous';
        var cacheBustUrl = src + (src.indexOf('?') > -1 ? '&' : '?') + 'snowi_canvas_t=' + Date.now();
        var timer = setTimeout(function () { resolve(null); }, 6000);
        img.onload = function () { clearTimeout(timer); resolve(img); };
        img.onerror = function () { clearTimeout(timer); resolve(null); };
        img.src = cacheBustUrl;
      });
    }

    /* ================= 核心绘图：完美还原 Snowi 卡片 ================= */
    async function drawCardToCanvas(wrapper, siteTitle, addLog) {
      var CARD_W = 600;
      var PAD = 24;
      var CONTENT_W = CARD_W - PAD * 2;
      var SCALE = 2; // 2倍图高清导出

      var dark = isDark();
      var colorBg = dark ? '#141518' : '#f4f5f7';       // 画布最外层背景
      var colorCardBg = dark ? '#1e1f24' : '#ffffff';   // 卡片主体背景
      var colorTitle = dark ? '#e1e3e8' : '#1a1a1a';    // 标题/日期颜色
      var colorText = dark ? '#c0c4cc' : '#333639';     // 正文颜色
      var colorSub = dark ? '#7a808b' : '#9aa0a8';      // 次要文字/图标颜色

      addLog('INFO', '正在解析卡片 DOM...');

      // 1. 数据提取 (精准对应 HTML 类名)
      var data = {
        dayNum: '', weekday: '', yearMonth: '', time: '',
        authorName: '', avatarSrc: '',
        contentText: '', hasAudio: false, images: []
      };

      var dayEl = wrapper.querySelector('.day-num');
      if (dayEl) data.dayNum = dayEl.textContent.trim();
      
      var weekdayEl = wrapper.querySelector('.weekday');
      if (weekdayEl) data.weekday = weekdayEl.textContent.trim();

      var ymEl = wrapper.querySelector('.year-month');
      if (ymEl) data.yearMonth = ymEl.textContent.trim();

      var timeEl = wrapper.querySelector('.time');
      if (timeEl) data.time = timeEl.textContent.trim();

      var authorEl = wrapper.querySelector('.author-name');
      if (authorEl) data.authorName = authorEl.textContent.trim();

      var avatarEl = wrapper.querySelector('.author-avatar');
      if (avatarEl) data.avatarSrc = avatarEl.getAttribute('src');

      var textEl = wrapper.querySelector('.post-text');
      if (textEl) {
        // 检查是否包含音乐播放器
        if (textEl.querySelector('mood-player')) {
          data.hasAudio = true;
          // 克隆一份以防污染原 DOM，再剔除播放器获取纯文本
          var clone = textEl.cloneNode(true);
          clone.querySelectorAll('mood-player').forEach(function(el) { el.remove(); });
          data.contentText = clone.innerText.trim();
        } else {
          data.contentText = textEl.innerText.trim();
        }
      }

      // 获取图片列表
      var imgEls = wrapper.querySelectorAll('.post-media img, .post-media-grid img');
      for (var i = 0; i < imgEls.length; i++) {
        var src = imgEls[i].getAttribute('src');
        if (src) data.images.push(src);
      }

      // 2. 加载资源
      addLog('INFO', '拉取图片和头像资源...');
      var loadedImgs = await Promise.all(data.images.map(function(src) {
        return loadImageCorsSafe(src).then(function(img) {
          if (!img) addLog('WARN', '图片跨域失败: ' + src.substring(0, 30));
          return img;
        });
      }));

      var avatarImg = null;
      if (data.avatarSrc) {
        avatarImg = await loadImageCorsSafe(data.avatarSrc);
        if (!avatarImg) addLog('WARN', '头像跨域失败');
      }

      addLog('INFO', '开始计算排版尺寸...');

      // 3. 高度测算
      var measureCtx = document.createElement('canvas').getContext('2d');
      
      // 正文
      var FONT_SIZE = 16;
      var LINE_H = 26;
      measureCtx.font = FONT_SIZE + 'px ' + FONT_STACK;
      var bodyLines = wrapText(measureCtx, data.contentText, CONTENT_W);
      var bodyH = bodyLines.length * LINE_H;
      
      // 头部
      var HEADER_H = 64;

      // 音乐卡片占位
      var AUDIO_H = data.hasAudio ? 64 + 16 : 0;

      // 图片网格
      var gap = 8;
      var numImgs = loadedImgs.length;
      var imgRects = [];
      var imgAreaH = 0;

      if (numImgs === 1) {
        var img = loadedImgs[0];
        var nw = img ? img.naturalWidth : 1;
        var nh = img ? img.naturalHeight : 1;
        var h = Math.round(CONTENT_W * (nh / nw));
        h = Math.min(h, 800); // 限制单图最大高度
        imgRects.push({ x: 0, y: 0, w: CONTENT_W, h: h, img: img });
        imgAreaH = h + 16;
      } else if (numImgs >= 2) {
        var cols = numImgs === 2 ? 2 : 3;
        var rows = Math.ceil(numImgs / cols);
        var w = (CONTENT_W - gap * (cols - 1)) / cols;
        for (var i = 0; i < numImgs; i++) {
          var r = Math.floor(i / cols);
          var c = i % cols;
          imgRects.push({ x: c * (w + gap), y: r * (w + gap), w: w, h: w, img: loadedImgs[i] });
        }
        imgAreaH = rows * w + (rows - 1) * gap + 16;
      }

      // 底部互动 (评论与分享)
      var FOOTER_H = 36;

      // 水印与日志
      var logStr = addLog.logs.slice(-6).join('\n');
      measureCtx.font = '11px ui-monospace, monospace';
      var logLines = wrapText(measureCtx, logStr, CONTENT_W);
      var logH = logLines.length * 16 + 10;

      // 总高度
      var totalH = PAD + HEADER_H + bodyH + AUDIO_H + imgAreaH + FOOTER_H + logH + PAD;

      // 4. 正式绘制
      var canvas = document.createElement('canvas');
      canvas.width = CARD_W * SCALE;
      canvas.height = totalH * SCALE;
      var ctx = canvas.getContext('2d');
      ctx.scale(SCALE, SCALE);

      // 外层背景
      ctx.fillStyle = colorBg;
      ctx.fillRect(0, 0, CARD_W, totalH);

      // 卡片主体（圆角矩形）
      ctx.save();
      roundRectPath(ctx, 0, 0, CARD_W, totalH, 20);
      ctx.clip();
      ctx.fillStyle = colorCardBg;
      ctx.fillRect(0, 0, CARD_W, totalH);
      
      var currentY = PAD;

      /* --- 1. 头部 --- */
      ctx.textBaseline = 'alphabetic';
      
      // 左侧：日期
      ctx.textAlign = 'left';
      if (data.dayNum) {
        ctx.fillStyle = colorTitle;
        ctx.font = 'bold 26px ' + FONT_STACK;
        ctx.fillText(data.dayNum, PAD, currentY + 24);
        
        var dayW = ctx.measureText(data.dayNum).width;
        if (data.weekday) {
          ctx.font = 'bold 14px ' + FONT_STACK;
          ctx.fillText(data.weekday, PAD + dayW + 6, currentY + 22);
        }
      }
      
      if (data.yearMonth || data.time) {
        ctx.fillStyle = colorSub;
        ctx.font = '12px ' + FONT_STACK;
        var subStr = data.yearMonth + (data.time ? '  ' + data.time : '');
        ctx.fillText(subStr, PAD, currentY + 46);
      }

      // 右侧：作者与头像
      var AVATAR = 44;
      var ax = CARD_W - PAD - AVATAR;
      var ay = currentY - 4;

      if (avatarImg) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(ax + AVATAR/2, ay + AVATAR/2, AVATAR/2, 0, Math.PI * 2);
        ctx.clip();
        ctx.drawImage(avatarImg, ax, ay, AVATAR, AVATAR);
        ctx.restore();
      } else {
        ctx.save();
        ctx.beginPath();
        ctx.arc(ax + AVATAR/2, ay + AVATAR/2, AVATAR/2, 0, Math.PI * 2);
        ctx.fillStyle = dark ? '#333' : '#eee';
        ctx.fill();
        ctx.restore();
      }

      if (data.authorName) {
        ctx.fillStyle = colorSub;
        ctx.font = '14px ' + FONT_STACK;
        ctx.textAlign = 'right';
        ctx.fillText(data.authorName, ax - 12, ay + AVATAR/2 + 5);
      }

      currentY += HEADER_H;

      /* --- 2. 正文 --- */
      ctx.textAlign = 'left';
      ctx.fillStyle = colorText;
      ctx.font = FONT_SIZE + 'px ' + FONT_STACK;
      for (var i = 0; i < bodyLines.length; i++) {
        ctx.fillText(bodyLines[i], PAD, currentY + i * LINE_H + 16);
      }
      currentY += bodyH;

      /* --- 3. 音乐播放器占位 --- */
      if (data.hasAudio) {
        currentY += 16;
        ctx.save();
        roundRectPath(ctx, PAD, currentY, CONTENT_W, 64, 12);
        ctx.fillStyle = dark ? '#2a2b30' : '#f5f6f8';
        ctx.fill();
        
        // 画个简单的音符图标
        ctx.fillStyle = colorSub;
        ctx.font = '24px Arial';
        ctx.fillText('🎵', PAD + 20, currentY + 40);
        
        ctx.font = '14px ' + FONT_STACK;
        ctx.fillStyle = colorText;
        ctx.fillText('分享了音乐', PAD + 60, currentY + 37);
        
        ctx.restore();
        currentY += 64;
      }

      /* --- 4. 图片网格 --- */
      if (imgRects.length > 0) {
        currentY += 16;
        for (var i = 0; i < imgRects.length; i++) {
          var r = imgRects[i];
          var dx = PAD + r.x;
          var dy = currentY + r.y;
          
          ctx.save();
          roundRectPath(ctx, dx, dy, r.w, r.h, 8);
          ctx.clip();
          
          if (r.img) {
            // 居中裁剪绘制 (object-fit: cover)
            var nw = r.img.naturalWidth, nh = r.img.naturalHeight;
            var dstRatio = r.w / r.h, srcRatio = nw / nh;
            var sx = 0, sy = 0, sw = nw, sh = nh;
            if (srcRatio > dstRatio) { sw = nh * dstRatio; sx = (nw - sw)/2; }
            else if (srcRatio < dstRatio) { sh = nw / dstRatio; sy = (nh - sh)/2; }
            ctx.drawImage(r.img, sx, sy, sw, sh, dx, dy, r.w, r.h);
          } else {
            // 跨域失败的灰色占位
            ctx.fillStyle = dark ? '#333' : '#eee';
            ctx.fillRect(dx, dy, r.w, r.h);
            ctx.fillStyle = colorSub;
            ctx.font = '12px ' + FONT_STACK;
            ctx.textAlign = 'center';
            ctx.fillText('加载失败', dx + r.w/2, dy + r.h/2);
          }
          ctx.restore();
        }
        currentY += imgAreaH;
      }

      /* --- 5. 底部互动栏 (完美复刻原页面的 SVG 图标) --- */
      currentY += 12;
      var iconSize = 20;
      
      // 评论 icon
      var commentPath = new Path2D("M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z");
      ctx.save();
      ctx.translate(PAD, currentY);
      ctx.scale(iconSize/24, iconSize/24);
      ctx.strokeStyle = colorSub;
      ctx.lineWidth = 2;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.stroke(commentPath);
      ctx.restore();

      // 分享 icon
      var sharePath1 = new Path2D("M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8");
      var sharePath2 = new Path2D("M16 6 12 2 8 6");
      var sharePath3 = new Path2D("M12 2v13");
      ctx.save();
      ctx.translate(PAD + 40, currentY); // 两个图标之间的间距
      ctx.scale(iconSize/24, iconSize/24);
      ctx.strokeStyle = colorSub;
      ctx.lineWidth = 2;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.stroke(sharePath1);
      ctx.stroke(sharePath2);
      ctx.stroke(sharePath3);
      ctx.restore();

      currentY += FOOTER_H;

      /* --- 6. 水印和日志 --- */
      currentY += 10;
      ctx.fillStyle = colorSub;
      ctx.font = '12px ' + FONT_STACK;
      ctx.textAlign = 'left';
      ctx.fillText('❄️ ' + (siteTitle || 'Snowi'), PAD, currentY + 10);

      if (logLines.length > 0) {
        ctx.font = '11px ui-monospace, monospace';
        ctx.fillStyle = dark ? 'rgba(255,255,255,0.25)' : 'rgba(0,0,0,0.3)';
        for (var i = 0; i < logLines.length; i++) {
          ctx.fillText(logLines[i], PAD, currentY + 30 + i * 16);
        }
      }

      ctx.restore(); // 恢复卡片主体裁剪
      return canvas;
    }

    /* ---------- 下载（Blob） ---------- */
    async function triggerDownload(canvas, filename) {
      return new Promise(function(resolve, reject) {
        try {
          canvas.toBlob(function(blob) {
            if (!blob) { reject(new Error('Canvas 转 Blob 失败(污染)')); return; }
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.download = filename;
            link.href = url;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(function() { URL.revokeObjectURL(url); resolve(); }, 1000);
          }, 'image/png');
        } catch(e) { reject(e); }
      });
    }

    /* ---------- 分享主流程 ---------- */
    async function handleShare(btn) {
      if (btn.disabled || btn.dataset.snowiBusy === '1') return;

      var wrapper = btn.closest('.card-wrapper');
      if (!wrapper) return;

      var overlay = showCaptureOverlay();
      var logLines = [];
      var finalError = null;
      var captureLog = function(level, msg) {
        var line = '[' + stamp() + '] [' + level + '] ' + msg;
        logLines.push(line);
        try { console.log('[snowi] ' + line); } catch (e) {}
      };
      captureLog.logs = logLines; // 供绘图函数使用

      btn.disabled = true;
      btn.dataset.snowiBusy = '1';

      try {
        captureLog('INFO', '开始提取原生 Canvas...');
        var canvas = await drawCardToCanvas(wrapper, siteTitle, captureLog);
        
        var type = getPageType();
        var prefix = type === 'index' ? 'Snowi-' : 'Snowi-' + type.charAt(0).toUpperCase() + type.slice(1) + '-';
        var filename = prefix + Date.now() + '.png';
        
        captureLog('INFO', '导出图片...');
        await triggerDownload(canvas, filename);
        captureLog('OK', '下载已触发');
      } catch (err) {
        finalError = err;
        var msg = err && err.message ? err.message : String(err);
        captureLog('ERR', '异常: ' + msg);
      } finally {
        overlay.remove();
        btn.disabled = false;
        delete btn.dataset.snowiBusy;

        if (finalError) {
          var lastLines = logLines.slice(-6).join('\n');
          var errMsg = finalError.message || String(finalError);
          alert('截图生成失败：' + errMsg + '\n\n最近日志:\n' + lastLines);
        }
      }
    }

    /* ================= 事件委托（Swup 切页后依然有效） ================= */

    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var themeBtn = target.closest('#snowiThemeToggle, #themeToggle');
      if (themeBtn) {
        e.preventDefault();
        applyTheme(!isDark(), true);
        return;
      }

      var searchBtn = target.closest('#snowiSearchToggle');
      if (searchBtn) {
        e.preventDefault();
        var form = document.getElementById('snowiSearch');
        if (!form) return;
        var open = form.classList.toggle('open');
        searchBtn.classList.toggle('active', open);
        if (open) {
          var input = form.querySelector('input');
          if (input) input.focus();
        }
        return;
      }

      var shareBtn = target.closest('.share-btn');
      if (shareBtn) {
        e.preventDefault();
        handleShare(shareBtn);
        return;
      }

      /* 卡片空白 / 文字 / 日期区域也可以进入文章详情 */
      var card = target.closest('.post-card');
      if (!card) return;
      var cardOverlay = card.querySelector('.card-overlay');
      if (!cardOverlay) return;
      if (target.closest('a, button, input, textarea, select, label, form, video, audio, mood-player, .post-actions, .post-media, .post-media-grid, .live-photo, .post-category, .post-tags, .lightbox-img')) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      var selection = '';
      try {
        selection = String(window.getSelection ? window.getSelection() : '');
      } catch (err) {}
      if (selection) return;

      e.preventDefault();
      cardOverlay.click();
    });

    /* ================= Swup / Astro 切页 ================= */

    document.addEventListener('astro:after-swap', function () {
      var main = document.getElementById('main');
      if (!main) return;
      main.classList.remove('snowi-page-in');
      void main.offsetWidth;
      main.classList.add('snowi-page-in');
    });

    document.addEventListener('astro:page-load', function () {
      syncThemeUI();
      ensureMoodPlayer();
      try {
        document.dispatchEvent(new Event('page:view'));
      } catch (e) {}
      try {
        document.dispatchEvent(new Event('swup:page:view'));
      } catch (e) {}
    });
  })();
</script>
      // 【关键修复1】改用 Data URI 加载 SVG，避免部分移动端浏览器对 Blob 的 CORS 限制报错
      var svgUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgString);
      var iconImg = new Image();
      
      await new Promise(function(resolve) {
        iconImg.onload = resolve;
        iconImg.onerror = resolve; // 即使失败也不阻断
        iconImg.src = svgUrl;
      });
      
      // 【关键修复2】增加宽高判断，防止加载失败导致 ctx.drawImage 抛出 InvalidStateError
      if (iconImg.width > 0 && iconImg.height > 0) {
        ctx.drawImage(iconImg, startX, textY - iconSize / 2, iconSize, iconSize);
      }

      ctx.fillStyle = isDark() ? '#888888' : '#999999';
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillText(textStr, startX + iconSize, textY);

      ctx.restore(); // 结束 translate

      return canvas;
    }

    function triggerDownload(canvas, filename) {
      return new Promise(function (resolve, reject) {
        try {
          canvas.toBlob(function (blob) {
            if (!blob) { 
              reject(new Error('Canvas 导出失败。多半是因为页面里引用了没有配置 CORS 头 (Access-Control-Allow-Origin) 的跨域图片，导致画布被污染。')); 
              return; 
            }
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.download = filename;
            link.href = url;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(function () { URL.revokeObjectURL(url); resolve(); }, 1000);
          }, 'image/png');
        } catch (e) { reject(e); }
      });
    }

    function showCaptureOverlay() {
      var o = document.createElement('div');
      o.className = 'snowi-capture-overlay';
      o.innerHTML = '<span class="snowi-capture-spinner"></span><span>生成图片中…</span>';
      document.body.appendChild(o);
      return o;
    }

    async function handleShare(btn) {
      if (btn.disabled || btn.dataset.snowiBusy === '1') return;
      var card = btn.closest('.post-card');
      if (!card) return;

      var overlay = showCaptureOverlay();
      btn.disabled = true;
      btn.dataset.snowiBusy = '1';

      try {
        var canvas = await drawCardToCanvas(card);
        var filename = 'Snowi-' + Date.now() + '.png';
        await triggerDownload(canvas, filename);
      } catch (err) {
        console.error('截图失败:', err);
        // 【关键修复3】将报错信息弹出，让你准确知道原因
        alert('生成图片失败！\n错误信息: ' + (err.message || err.name) + '\n(可以按 F12 打开控制台查看详细堆栈)');
      } finally {
        overlay.remove();
        btn.disabled = false;
        delete btn.dataset.snowiBusy;
      }
    }

    /* ================= 事件委托 ================= */

    document.addEventListener('click', function (e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var themeBtn = target.closest('#snowiThemeToggle, #themeToggle');
      if (themeBtn) { e.preventDefault(); applyTheme(!isDark(), true); return; }

      var searchBtn = target.closest('#snowiSearchToggle');
      if (searchBtn) {
        e.preventDefault();
        var form = document.getElementById('snowiSearch');
        if (!form) return;
        var open = form.classList.toggle('open');
        searchBtn.classList.toggle('active', open);
        if (open) { var input = form.querySelector('input'); if (input) input.focus(); }
        return;
      }

      var shareBtn = target.closest('.share-btn');
      if (shareBtn) { e.preventDefault(); handleShare(shareBtn); return; }

      var card = target.closest('.post-card');
      if (!card) return;
      var cardOverlay = card.querySelector('.card-overlay');
      if (!cardOverlay) return;
      if (target.closest('a, button, input, textarea, select, label, form, video, audio, mood-player, .post-actions, .post-media, .post-media-grid, .live-photo, .post-category, .post-tags, .lightbox-img')) return;
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      var selection = '';
      try { selection = String(window.getSelection ? window.getSelection() : ''); } catch (err) {}
      if (selection) return;

      e.preventDefault();
      cardOverlay.click();
    });

    /* ================= Astro 切页 ================= */

    document.addEventListener('astro:after-swap', function () {
      var main = document.getElementById('main');
      if (!main) return;
      main.classList.remove('snowi-page-in');
      void main.offsetWidth;
      main.classList.add('snowi-page-in');
    });

    document.addEventListener('astro:page-load', function () {
      syncThemeUI();
      ensureMoodPlayer();
      try { document.dispatchEvent(new Event('page:view')); } catch (e) {}
      try { document.dispatchEvent(new Event('swup:page:view')); } catch (e) {}
    });
  })();
</script>

---
/**
 * Snowi theme — shared client behaviour
 */
interface Props {
  siteTitle?: string;
}

const { siteTitle = '' } = Astro.props;
---

<script is:inline define:vars={{ siteTitle }}>
  (function () {
    'use strict';

    if (window.__snowiThemeInit) return;
    window.__snowiThemeInit = true;

    var root = document.documentElement;
    var STORAGE_KEY = 'snowi-theme';
    var LEGACY_KEY = 'theme';

    /* ================= 主题切换 ================= */

    function getStoredTheme() {
      try { return localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_KEY); }
      catch (e) { return null; }
    }
    function setStoredTheme(v) {
      try { localStorage.setItem(STORAGE_KEY, v); localStorage.removeItem(LEGACY_KEY); }
      catch (e) {}
    }
    function isDark() { return root.classList.contains('snowi-dark'); }
    function syncThemeUI() {
      var dark = isDark();
      document.querySelectorAll('#snowiThemeIcon, #themeIcon').forEach(function (el) {
        el.textContent = dark ? '☀️' : '🌙';
      });
      document.querySelectorAll('#snowiThemeText, #themeText').forEach(function (el) {
        el.textContent = dark ? '切换至亮色模式' : '切换至暗色模式';
      });
      document.querySelectorAll('#snowiThemeToggle, #themeToggle').forEach(function (el) {
        el.setAttribute('aria-pressed', dark ? 'true' : 'false');
      });
    }
    function applyTheme(dark, persist) {
      root.classList.toggle('snowi-dark', dark);
      if (persist) setStoredTheme(dark ? 'dark' : 'light');
      syncThemeUI();
    }
    var storedTheme = getStoredTheme();
    if (storedTheme === 'dark') root.classList.add('snowi-dark');
    else if (storedTheme === 'light') root.classList.remove('snowi-dark');
    syncThemeUI();

    /* ================= 评论回复 ================= */

    window.TypechoComment = {
      dom: function (id) { return document.getElementById(id); },
      reply: function (commentId, coid) {
        var c = this.dom(commentId), r = this.dom('respond'),
            cl = this.dom('cancel-comment-reply-link'), p = this.dom('comment-parent');
        if (!c || !r || !p) return true;
        p.value = coid; c.appendChild(r);
        if (cl) cl.style.display = '';
        try { var t = this.dom('textarea'); if (t) t.focus(); } catch (e) {}
        return false;
      },
      cancelReply: function () {
        var r = this.dom('respond'), cl = this.dom('cancel-comment-reply-link'),
            p = this.dom('comment-parent'), cm = this.dom('comments');
        if (!r || !cm || !p) return false;
        p.value = '0';
        if (cl) cl.style.display = 'none';
        cm.appendChild(r);
        return false;
      }
    };

    /* ================= 播放器 ================= */

    function ensureMoodPlayer() {
      try {
        if (typeof customElements === 'undefined' || customElements.get('mood-player')) return;
      } catch (e) { return; }
      if (!document.querySelector('mood-player')) return;
      if (window.__snowiMoodPlayerLoading) return;
      window.__snowiMoodPlayerLoading = true;
      var s = document.createElement('script');
      s.src = '/js/mood-player.min.js';
      s.async = true;
      s.onload = s.onerror = function () { window.__snowiMoodPlayerLoading = false; };
      document.head.appendChild(s);
    }
    ensureMoodPlayer();

    /* =========================================================
     *                分享截图 —— Canvas 高精度精绘方案
     * ========================================================= */

    var SCALE = 3;          // 3倍图，提升分辨率
    var PAD = 24;           // 外围留白宽度
    var WATERMARK_H = 32;   // 底部留给水印的高度

    function roundRectPath(ctx, x, y, w, h, r) {
      r = Math.min(r, w / 2, h / 2);
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + w - r, y);
      ctx.arcTo(x + w, y, x + w, y + r, r);
      ctx.lineTo(x + w, y + h - r);
      ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
      ctx.lineTo(x + r, y + h);
      ctx.arcTo(x, y + h, x, y + h - r, r);
      ctx.lineTo(x, y + r);
      ctx.arcTo(x, y, x + r, y, r);
      ctx.closePath();
    }

    function roundRectPathCorners(ctx, x, y, w, h, tl, tr, br, bl) {
      tl = Math.min(tl, w / 2, h / 2) || 0;
      tr = Math.min(tr, w / 2, h / 2) || 0;
      br = Math.min(br, w / 2, h / 2) || 0;
      bl = Math.min(bl, w / 2, h / 2) || 0;
      ctx.beginPath();
      ctx.moveTo(x + tl, y);
      ctx.lineTo(x + w - tr, y);
      ctx.arcTo(x + w, y, x + w, y + tr, tr);
      ctx.lineTo(x + w, y + h - br);
      ctx.arcTo(x + w, y + h, x + w - br, y + h, br);
      ctx.lineTo(x + bl, y + h);
      ctx.arcTo(x, y + h, x, y + h - bl, bl);
      ctx.lineTo(x, y + tl);
      ctx.arcTo(x, y, x + tl, y, tl);
      ctx.closePath();
    }

    function loadSafeImage(src) {
      return new Promise(function (resolve) {
        if (!src) return resolve(null);
        var img = new Image();
        if (!/^data:/i.test(src)) {
          img.crossOrigin = 'anonymous';
          var sep = src.indexOf('?') > -1 ? '&' : '?';
          src = src + sep + '_snowi_shot=' + Date.now();
        }
        var timer = setTimeout(function () { resolve(null); }, 10000);
        img.onload = function () { clearTimeout(timer); resolve(img); };
        img.onerror = function () { clearTimeout(timer); resolve(null); };
        img.src = src;
      });
    }

    async function preloadImages(card) {
      var imgs = Array.prototype.slice.call(card.querySelectorAll('img'));
      var map = new Map();
      await Promise.all(imgs.map(async function (img) {
        if (img._snowiSafeLoaded) return;
        var src = img.currentSrc || img.src || img.getAttribute('src');
        var safe = await loadSafeImage(src);
        if (safe) map.set(img, safe);
        img._snowiSafeLoaded = true;
      }));
      return map;
    }

    function fillTextWithLetterSpacing(ctx, text, x, y, spacing) {
      if (!spacing) { ctx.fillText(text, x, y); return; }
      var chars = Array.from(text);
      var cx = x;
      for (var i = 0; i < chars.length; i++) {
        ctx.fillText(chars[i], cx, y);
        cx += ctx.measureText(chars[i]).width + spacing;
      }
    }

    function drawTextNode(ctx, textNode, baseX, baseY) {
      var text = textNode.textContent;
      if (!text || !text.trim()) return;
      var parent = textNode.parentElement;
      if (!parent) return;
      var style = getComputedStyle(parent);
      var fontSize = parseFloat(style.fontSize) || 14;
      var fontWeight = style.fontWeight || '400';
      var fontFamily = style.fontFamily || 'sans-serif';
      var color = style.color || '#000';
      var letterSpacing = parseFloat(style.letterSpacing) || 0;
      var underline = style.textDecorationLine && style.textDecorationLine.indexOf('underline') !== -1;
      var underlineColor = style.textDecorationColor && style.textDecorationColor !== 'currentcolor' ? style.textDecorationColor : color;

      ctx.save();
      ctx.font = fontWeight + ' ' + fontSize + 'px ' + fontFamily;
      ctx.fillStyle = color;
      ctx.textBaseline = 'middle';
      ctx.textAlign = 'left';

      var range = document.createRange();
      range.selectNodeContents(textNode);
      var rects = range.getClientRects();
      if (!rects.length) { ctx.restore(); return; }

      if (rects.length === 1) {
        var r = rects[0];
        var x0 = r.left - baseX;
        var cy0 = (r.top + r.bottom) / 2 - baseY;
        fillTextWithLetterSpacing(ctx, text, x0, cy0, letterSpacing);
        if (underline) {
          ctx.fillStyle = underlineColor;
          var uw = ctx.measureText(text).width;
          ctx.fillRect(x0, cy0 + fontSize * 0.15 + 2, uw, 1);
        }
        ctx.restore();
        return;
      }

      var chars = Array.from(text);
      var charRange = document.createRange();
      var lineGroups = [];
      var currentLine = null;

      for (var i = 0; i < chars.length; i++) {
        charRange.setStart(textNode, i);
        charRange.setEnd(textNode, i + 1);
        var cr = charRange.getBoundingClientRect();
        if (cr.width === 0 && cr.height === 0) continue;
        var midY = (cr.top + cr.bottom) / 2;
        var lineIdx = -1;
        for (var j = 0; j < rects.length; j++) {
          if (Math.abs(midY - (rects[j].top + rects[j].bottom) / 2) < 3) { lineIdx = j; break; }
        }
        if (lineIdx === -1) continue;
        if (!currentLine || currentLine.lineIdx !== lineIdx) {
          currentLine = { lineIdx: lineIdx, start: i, end: i + 1 };
          lineGroups.push(currentLine);
        } else { currentLine.end = i + 1; }
      }

      for (var g = 0; g < lineGroups.length; g++) {
        var group = lineGroups[g];
        var lineText = chars.slice(group.start, group.end).join('');
        if (!lineText.trim()) continue;
        var rr = rects[group.lineIdx];
        var lx = rr.left - baseX;
        var lcy = (rr.top + rr.bottom) / 2 - baseY;
        fillTextWithLetterSpacing(ctx, lineText, lx, lcy, letterSpacing);
        if (underline) {
          ctx.fillStyle = underlineColor;
          var lw = ctx.measureText(lineText).width;
          ctx.fillRect(lx, lcy + fontSize * 0.15 + 2, lw, 1);
        }
      }
      ctx.restore();
    }

    function drawImageEl(ctx, imgEl, baseX, baseY, imgMap) {
      var r = imgEl.getBoundingClientRect();
      if (r.width <= 0 || r.height <= 0) return;
      var x = r.left - baseX;
      var y = r.top - baseY;
      var w = r.width;
      var h = r.height;
      var style = getComputedStyle(imgEl);
      var radius = parseFloat(style.borderTopLeftRadius) || 0;
      var safe = imgMap.get(imgEl) || null;
      var nw = safe ? safe.naturalWidth : 0;
      var nh = safe ? safe.naturalHeight : 0;

      ctx.save();
      if (radius > 0) {
        roundRectPath(ctx, x, y, w, h, radius);
        ctx.clip();
      }
      if (!safe || !nw || !nh) {
        ctx.fillStyle = style.backgroundColor || '#eeeeee';
        ctx.fillRect(x, y, w, h);
        ctx.restore();
        return;
      }
      var dstRatio = w / h;
      var srcRatio = nw / nh;
      var sx = 0, sy = 0, sw = nw, sh = nh;
      var fit = style.objectFit;

      if (fit === 'cover') {
        if (srcRatio > dstRatio) { sw = nh * dstRatio; sx = (nw - sw) / 2; }
        else if (srcRatio < dstRatio) { sh = nw / dstRatio; sy = (nh - sh) / 2; }
      } else if (fit === 'contain') {
        var scale = Math.min(w / nw, h / nh);
        var dw = nw * scale;
        var dh = nh * scale;
        var dx = x + (w - dw) / 2;
        var dy = y + (h - dh) / 2;
        try { ctx.drawImage(safe, dx, dy, dw, dh); } catch (e) {}
        ctx.restore();
        return;
      }
      try { ctx.drawImage(safe, sx, sy, sw, sh, x, y, w, h); }
      catch (e) { ctx.fillStyle = style.backgroundColor || '#eeeeee'; ctx.fillRect(x, y, w, h); }
      ctx.restore();
    }

    function svgElementToPath(el) {
      var tag = el.tagName.toLowerCase();
      var a = function (k) { return parseFloat(el.getAttribute(k)) || 0; };
      var p;
      if (tag === 'path') {
        var d = el.getAttribute('d');
        if (!d) return null;
        try { return new Path2D(d); } catch (e) { return null; }
      }
      if (tag === 'line') {
        p = new Path2D(); p.moveTo(a('x1'), a('y1')); p.lineTo(a('x2'), a('y2')); return p;
      }
      if (tag === 'polyline' || tag === 'polygon') {
        var raw = (el.getAttribute('points') || '').trim();
        if (!raw) return null;
        var pts = raw.split(/[\s,]+/).map(Number);
        if (pts.length < 4) return null;
        p = new Path2D(); p.moveTo(pts[0], pts[1]);
        for (var i = 2; i < pts.length; i += 2) p.lineTo(pts[i], pts[i + 1]);
        if (tag === 'polygon') p.closePath();
        return p;
      }
      if (tag === 'circle') {
        p = new Path2D(); p.arc(a('cx'), a('cy'), a('r'), 0, Math.PI * 2); return p;
      }
      if (tag === 'rect') {
        p = new Path2D(); p.rect(a('x'), a('y'), a('width'), a('height')); return p;
      }
      if (tag === 'ellipse') {
        p = new Path2D(); p.ellipse(a('cx'), a('cy'), a('rx'), a('ry'), 0, 0, Math.PI * 2); return p;
      }
      return null;
    }

    function drawSvg(ctx, svgEl, baseX, baseY) {
      var r = svgEl.getBoundingClientRect();
      if (r.width <= 0 || r.height <= 0) return;
      var vb = svgEl.getAttribute('viewBox');
      if (!vb) return;
      var parts = vb.trim().split(/[\s,]+/).map(Number);
      if (parts.length !== 4) return;
      var vx = parts[0], vy = parts[1], vw = parts[2], vh = parts[3];
      if (!vw || !vh) return;

      ctx.save();
      ctx.translate(r.left - baseX, r.top - baseY);
      ctx.scale(r.width / vw, r.height / vh);
      ctx.translate(-vx, -vy);

      var children = svgEl.querySelectorAll('path, line, polyline, polygon, circle, rect, ellipse');
      for (var i = 0; i < children.length; i++) {
        var child = children[i];
        var path = svgElementToPath(child);
        if (!path) continue;
        var cs = getComputedStyle(child);
        var fill = cs.fill;
        var stroke = cs.stroke;
        var sw = parseFloat(cs.strokeWidth) || 1;

        ctx.lineCap = cs.strokeLinecap || 'round';
        ctx.lineJoin = cs.strokeLinejoin || 'round';

        if (fill && fill !== 'none' && fill !== 'rgba(0, 0, 0, 0)') {
          ctx.fillStyle = fill; ctx.fill(path);
        }
        if (stroke && stroke !== 'none') {
          ctx.strokeStyle = stroke; ctx.lineWidth = sw; ctx.stroke(path);
        }
      }
      ctx.restore();
    }

    async function drawNode(node, ctx, baseX, baseY, imgMap) {
      if (node.nodeType === Node.TEXT_NODE) {
        drawTextNode(ctx, node, baseX, baseY);
        return;
      }
      if (node.nodeType !== Node.ELEMENT_NODE) return;

      var el = node;
      var tag = el.tagName;

      if (tag === 'SCRIPT' || tag === 'STYLE' || tag === 'NOSCRIPT' || tag === 'TEMPLATE') return;
      if (el.classList.contains('card-overlay') || el.classList.contains('snowi-capture-overlay')) return;

      var style = getComputedStyle(el);
      if (style.display === 'none' || style.visibility === 'hidden' || parseFloat(style.opacity) === 0) return;
      if (tag === 'VIDEO') return;

      var rect = el.getBoundingClientRect();
      var x = rect.left - baseX;
      var y = rect.top - baseY;
      var w = rect.width;
      var h = rect.height;

      var tl = parseFloat(style.borderTopLeftRadius) || 0;
      var tr = parseFloat(style.borderTopRightRadius) || 0;
      var br = parseFloat(style.borderBottomRightRadius) || 0;
      var bl = parseFloat(style.borderBottomLeftRadius) || 0;

      // 绘制元素背景
      var bg = style.backgroundColor;
      if (bg && bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent' && w > 0 && h > 0) {
        ctx.save();
        ctx.fillStyle = bg;
        if (tl || tr || br || bl) {
          roundRectPathCorners(ctx, x, y, w, h, tl, tr, br, bl);
          ctx.fill();
        } else {
          ctx.fillRect(x, y, w, h);
        }
        ctx.restore();
      }

      // 绘制边框 (简化)
      var btW = parseFloat(style.borderTopWidth) || 0;
      if (btW > 0 && style.borderTopColor !== 'rgba(0, 0, 0, 0)') {
        ctx.save();
        ctx.strokeStyle = style.borderTopColor;
        ctx.lineWidth = btW;
        if (tl || tr || br || bl) roundRectPathCorners(ctx, x + btW/2, y + btW/2, w - btW, h - btW, tl, tr, br, bl);
        else { ctx.beginPath(); ctx.rect(x + btW/2, y + btW/2, w - btW, h - btW); }
        ctx.stroke();
        ctx.restore();
      }

      if (tag === 'IMG') {
        drawImageEl(ctx, el, baseX, baseY, imgMap);
        return;
      }
      if (el instanceof SVGElement) {
        drawSvg(ctx, el, baseX, baseY);
        return;
      }

      // 处理 overflow: hidden + border-radius 的裁切
      var isOverflowHidden = style.overflow === 'hidden' || style.overflowX === 'hidden' || style.overflowY === 'hidden';
      var hasRadius = tl || tr || br || bl;

      if (isOverflowHidden && hasRadius && w > 0 && h > 0) {
        ctx.save();
        roundRectPathCorners(ctx, x, y, w, h, tl, tr, br, bl);
        ctx.clip();
      }

      // 按 z-index 排序，保证标签浮在图片上方
      var children = Array.from(el.childNodes).sort(function (a, b) {
        if (a.nodeType === 1 && b.nodeType === 1) {
          var sA = getComputedStyle(a);
          var sB = getComputedStyle(b);
          var za = (sA.position !== 'static' ? parseInt(sA.zIndex) : 0) || 0;
          var zb = (sB.position !== 'static' ? parseInt(sB.zIndex) : 0) || 0;
          return za - zb;
        }
        return 0;
      });

      for (var i = 0; i < children.length; i++) {
        await drawNode(children[i], ctx, baseX, baseY, imgMap);
      }

      if (isOverflowHidden && hasRadius && w > 0 && h > 0) {
        ctx.restore();
      }
    }

    async function drawCardToCanvas(card) {
      // 暂停视频并移除播放状态
      var videos = card.querySelectorAll('video');
      for (var i = 0; i < videos.length; i++) { try { videos[i].pause(); } catch (e) {} }
      var playing = card.querySelectorAll('.live-photo.is-playing');
      for (var j = 0; j < playing.length; j++) playing[j].classList.remove('is-playing');

      var imgMap = await preloadImages(card);

      var cardRect = card.getBoundingClientRect();
      var W = Math.round(cardRect.width);
      var H = Math.round(cardRect.height);

      var canvasW = W + PAD * 2;
      var canvasH = H + PAD * 2 + WATERMARK_H;

      var canvas = document.createElement('canvas');
      canvas.width = canvasW * SCALE;
      canvas.height = canvasH * SCALE;
      var ctx = canvas.getContext('2d');
      
      ctx.scale(SCALE, SCALE);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';

      // 1. 绘制外围页面背景色
      ctx.fillStyle = isDark() ? '#121212' : '#f2f3f5';
      ctx.fillRect(0, 0, canvasW, canvasH);

      // 2. 平移上下文，使 (0,0) 对准卡片
      ctx.save();
      ctx.translate(PAD, PAD);

      var cardStyle = getComputedStyle(card);
      var radius = parseFloat(cardStyle.borderTopLeftRadius) || 16;
      var bg = cardStyle.backgroundColor || '#ffffff';

      // 3. 绘制卡片背景和阴影
      ctx.save();
      ctx.shadowColor = isDark() ? 'rgba(0, 0, 0, 0.3)' : 'rgba(0, 0, 0, 0.05)';
      ctx.shadowBlur = 10;
      ctx.shadowOffsetY = 2;
      roundRectPath(ctx, 0, 0, W, H, radius);
      ctx.fillStyle = bg;
      ctx.fill();
      ctx.restore();

      // 4. 裁剪卡片边界，开始绘制内部内容
      ctx.save();
      roundRectPath(ctx, 0, 0, W, H, radius);
      ctx.clip();

      var baseX = cardRect.left;
      var baseY = cardRect.top;
      var children = card.childNodes;
      for (var k = 0; k < children.length; k++) {
        await drawNode(children[k], ctx, baseX, baseY, imgMap);
      }
      ctx.restore(); // 结束卡片内容裁剪

      // 5. 绘制右下角水印 (SVG雪花图标 + 文字)
      var textY = H + 29; 
      var iconSize = 14;  
      ctx.font = 'bold 13px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      
      var textStr = ' Snowi.'; 
      var textW = ctx.measureText(textStr).width;
      var totalW = iconSize + textW;
      var startX = W - 15 - totalW; 


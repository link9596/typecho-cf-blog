---
interface Props {
  target?: string;
  renderSelector?: string | false;
  logo?: string;
  width?: string;
  cdnBase?: string;
  packages?: Record<string, any>;
  items?: {
    tieba?: string[];
    alus?: string[];
    nuko?: string[];
    big?: string[];
  };
  api?: Record<string, any>;
}

const {
  target = '#textarea',
  renderSelector = '.comment-text',
  logo = 'OωO',
  width = '360px',
  cdnBase = 'https://emoji.lkin.cn/emojis/',
  packages = null,
  items = null,
  api = null,
} = Astro.props;

/* 每个组件实例唯一标识 */
const uid = 'owo-' + Math.random().toString(36).slice(2, 8);

/* ---------- 包配置 ---------- */
const defaultPackages = {
  tieba: { dir: 'tieba', prefix: 'tieba_', ext: 'png', marker: '@' },
  alus:  { dir: 'alus',  prefix: 'alus_',  ext: 'png', marker: '#' },
  nuko:  { dir: 'nuko',  prefix: 'nuko_',  ext: 'gif', marker: '$' },
  big:   { dir: 'others', prefix: '', ext: 'gif', marker: '&' },
};

const finalPackages = packages
  ? Object.fromEntries(
      Object.entries(defaultPackages).map(([k, v]) => [
        k, { ...v, ...(packages[k] || {}) },
      ]).concat(
        Object.keys(packages)
          .filter((k) => !defaultPackages[k])
          .map((k) => [k, packages[k]])
      )
    )
  : defaultPackages;

/* ---------- 默认表情列表 ---------- */
const defaultItems = {
  tieba: ['laugh','joy','antic','vomit_water','sob','wink','cry','dizzy_face','heart_eyes','huge_sweat','rage','satisfied','sleep','smirk','sunglasses','sweat','vomit','lovely','angry','annoyed','awkward','cute','pick_nose','shy','yum','grievance','chuckle','crazy','hurt','look_down','rolling_eyes','agree','sorry','surprised','wow','doubt','thumbsup','v','metal','ok','heart','red_scarf','sofa','moon','pill','rainbow','rose','shit','banana','toilet_paper','cake','gift','candle','coffee'],
  alus:  ['happy','satisfied','unhappy','rage','shy','blush','kiss','clap','embarrassed','expect','die','helpless','wise','observe','ponder','silent','stare','surrender','sweat','think','vomit','wait','shit','smoke','grass','rich','dark','bystand','expressionless','grin','hide','persevere','unamused','slap','gunshot','wound','injured','knockdown','candle','flower','cucumber','high_five','huge_sweat','observe_dark','small_eye','smirk','astonished','sunglasses','sweat_smile','sob','fu','thumbsup','yum','hocho','greddy','pick_nose','awkward','vomit_blood','vomit_water','whatever'],
  nuko:  ['dang','aaaa','bird','chonglang','circle','confused','555','diss','eee','fire','glass','hat','humb','kitty','love','melt','punch','snowball','sweet','yeah'],
  big:   ['lufat','bluepot','luluhat','dagoujiao','dahaibao','hungry','55555','naiwashake','nwgun','nwsky','pingulick','qqbroken','qqcry','qqheart','sleepppp','sleepyyy','what','wocaole','xiaohaibao','xixi','0123ass','0123naotou','brain','graduate','loopyup','loopyxixi','catkfc','lurabbit','naidolphin','naiwabath','plz','shuang','shy'],
};

const finalItems = {
  tieba: items?.tieba || defaultItems.tieba,
  alus:  items?.alus  || defaultItems.alus,
  nuko:  items?.nuko  || defaultItems.nuko,
  big:   items?.big   || defaultItems.big,
};

/* ---------- 传给客户端脚本的配置 ---------- */
const config = {
  uid,
  target,
  renderSelector,
  logo,
  width,
  emojiOption: {
    baseUrl: cdnBase,
    packages: finalPackages,
    bigPrefix: 'big_',
    fallbackPackage: 'alus',
  },
  defaultItems: finalItems,
  customApi: api,
};
---

<!-- 加 data-astro-rerun：切页后重新执行，确保 window.OwO 一定就绪 -->
<script is:inline src="/js/owo.js" data-astro-rerun></script>

<div class="OwO" data-owo-uid={uid}></div>

<!-- 加 data-astro-rerun：切页后重新执行，重建面板 -->
<script is:inline define:vars={{ config }} data-astro-rerun>
  (function () {
    'use strict';

    function buildDefaultApi() {
      var gen = function (pkgName, list, prefix) {
        prefix = prefix || '';
        return list.map(function (name) {
          return {
            icon: '<img src="' + window.OwOEmotion.buildUrl(pkgName, name, config.emojiOption) + '">',
            text: prefix ? prefix + name : name,
            title: name,
          };
        });
      };

      return {
        'Emoji': {
          type: 'emoji',
          icon: "<span style='font-size:16px;'>😀</span>",
          container: [
            /* 表情 */
            { icon: '😂', text: '😂', title: '笑哭' },
            { icon: '😄', text: '😄', title: '开心' },
            { icon: '🤤', text: '🤤', title: '流口水' },
            { icon: '😉', text: '😉', title: '眨眼' },
            { icon: '😊', text: '😊', title: '害羞笑' },
            { icon: '☺️', text: '☺️', title: '微笑' },
            { icon: '😌', text: '😌', title: '舒心' },
            { icon: '😍', text: '😍', title: '花痴' },
            { icon: '😘', text: '😘', title: '飞吻' },
            { icon: '😚', text: '😚', title: '亲亲' },
            { icon: '😜', text: '😜', title: '眨眼吐舌' },
            { icon: '😝', text: '😝', title: '眯眼吐舌' },
            { icon: '😠', text: '😠', title: '生气' },
            { icon: '😡', text: '😡', title: '愤怒' },
            { icon: '😢', text: '😢', title: '哭' },
            { icon: '😨', text: '😨', title: '害怕' },
            { icon: '😪', text: '😪', title: '困' },
            { icon: '😭', text: '😭', title: '大哭' },
            { icon: '😋', text: '😋', title: '好吃' },
            { icon: '🤓', text: '🤓', title: '书呆' },
            { icon: '😎', text: '😎', title: '墨镜' },
            { icon: '🤗', text: '🤗', title: '抱抱' },
            { icon: '😙', text: '😙', title: '亲亲笑' },
            { icon: '😅', text: '😅', title: '苦笑' },
            { icon: '🥺', text: '🥺', title: '委屈' },
            { icon: '🤣', text: '🤣', title: '笑到打滚' },
            { icon: '🥰', text: '🥰', title: '恋爱' },
            { icon: '🤬', text: '🤬', title: '爆粗' },
            { icon: '🥳', text: '🥳', title: '派对' },
            { icon: '🤡', text: '🤡', title: '小丑' },
            { icon: '🥵', text: '🥵', title: '热' },
            { icon: '☠️', text: '☠️', title: '骷髅' },
            /* 手势 */
            { icon: '👍', text: '👍', title: '赞' },
            { icon: '💅', text: '💅', title: '美甲' },
            { icon: '🙏', text: '🙏', title: '拜托' },
            { icon: '👎', text: '👎', title: '踩' },
            { icon: '👊', text: '👊', title: '拳头' },
            { icon: '🖕', text: '🖕', title: '中指' },
            { icon: '👈', text: '👈', title: '左指' },
            { icon: '👉', text: '👉', title: '右指' },
            { icon: '👐', text: '👐', title: '张开手' },
            /* 天气 / 食物 */
            { icon: '❄️', text: '❄️', title: '雪花' },
            { icon: '🌙', text: '🌙', title: '月亮' },
            { icon: '☀️', text: '☀️', title: '太阳' },
            { icon: '☁️', text: '☁️', title: '云' },
            { icon: '🌤️', text: '🌤️', title: '晴间多云' },
            { icon: '🌦️', text: '🌦️', title: '阵雨' },
            { icon: '🌧️', text: '🌧️', title: '下雨' },
            { icon: '🌨️', text: '🌨️', title: '下雪' },
            { icon: '🍉', text: '🍉', title: '西瓜' },
            { icon: '🍊', text: '🍊', title: '橘子' },
            { icon: '🍣', text: '🍣', title: '寿司' },
            { icon: '🍧', text: '🍧', title: '刨冰' },
            { icon: '🍰', text: '🍰', title: '蛋糕' },
            { icon: '🍺', text: '🍺', title: '啤酒' },
            { icon: '🍋', text: '🍋', title: '柠檬' },
          ],
        },
        '贴吧': {
          type: 'image',
          marker: config.emojiOption.packages.tieba.marker,
          container: gen('tieba', config.defaultItems.tieba),
        },
        '阿鲁': {
          type: 'image',
          marker: config.emojiOption.packages.alus.marker,
          container: gen('alus', config.defaultItems.alus),
        },
        'nuko': {
          type: 'image',
          marker: config.emojiOption.packages.nuko.marker,
          container: gen('nuko', config.defaultItems.nuko),
        },
        '其他表情': {
          type: 'image',
          marker: config.emojiOption.packages.big.marker,
          className: 'other',
          container: gen('big', config.defaultItems.big, 'big_'),
        },
      };
    }

    function boot() {
      var mount = document.querySelector('.OwO[data-owo-uid="' + config.uid + '"]');
      if (!mount) return;                    // 本页没有该组件
      if (mount.dataset.owoReady === '1') return; // 同一 DOM 不重复初始化

      // 库还没就绪时轮询
      if (!window.OwO || !window.OwOEmotion) {
        return setTimeout(boot, 30);
      }

      var area = document.querySelector(config.target);
      if (!area) return;                     // textarea 还没插进来

      // 先打标记，避免并发 boot 重复执行
      mount.dataset.owoReady = '1';

      mount.innerHTML = '';
      new window.OwO({
        logo: config.logo,
        container: mount,
        target: area,
        position: 'up',
        width: config.width,
        api: config.customApi || buildDefaultApi(),
      });

      // 渲染器（全局单例，跨实例复用）
      if (config.renderSelector) {
        if (!window.__owoRenderer__) {
          window.__owoRenderer__ = new window.OwOEmotion(
            Object.assign({}, config.emojiOption, { autoInit: false })
          );
        }
        document.querySelectorAll(config.renderSelector).forEach(function (el) {
          window.__owoRenderer__.parse(el);
        });
      }
    }

    /* 首次 / 切页后立即执行（data-astro-rerun 已保证 DOM 就绪） */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    /* 每次切页都覆盖为最新 config，保证 reparse 用的是当前页配置 */
    window.SnowiOwO = {
      reparse: function () {
        if (window.__owoRenderer__ && config.renderSelector) {
          document.querySelectorAll(config.renderSelector).forEach(function (el) {
            window.__owoRenderer__.parse(el);
          });
        }
      },
      renderer: function () {
        return window.__owoRenderer__;
      },
    };
  })();
</script>
{
  "name": "typecho-plugin-imgcompress",
  "version": "1.0.0",
  "description": "后台附件图片上传自动压缩",
  "keywords": ["typecho", "plugin"],
  "type": "module",
  "main": "index.ts",
  "typecho": {
    "plugin": {
      "id": "typecho-plugin-imgcompress",
      "name": "图片上传压缩",
      "description": "后台附件图片压缩后上传",
      "author": "Link",
      "version": "1.0.0",
      "config": {
        "quality": {
          "type": "text",
          "label": "压缩质量 (0-1)",
          "default": "0.8",
          "description": "JPEG/WebP 质量，默认 0.8"
        },
        "maxDimension": {
          "type": "text",
          "label": "最大边长(px)",
          "default": "1920",
          "description": "超过此尺寸自动等比缩放，留空不限"
        },
        "outputFormat": {
          "type": "select",
          "label": "输出格式",
          "default": "webp",
          "options": {
            "original": "保持原格式",
            "webp": "转 WebP",
            "jpeg": "转 JPEG",
            "avif": "转 AVIF（体积最小但编码器较大）"
          }
        }
      }
    }
  }
}
